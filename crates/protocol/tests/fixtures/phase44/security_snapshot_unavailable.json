{
  "schema_version": 1,
  "version": 1,
  "source": "composer_selection",
  "permission_profile": {
    "mode": "supervised",
    "source": "composer",
    "effective_policy": {
      "default_behavior": "ask",
      "file_read": "ask",
      "file_write": "ask",
      "shell_command": "ask",
      "network": "ask",
      "mcp_read": "ask",
      "mcp_write_or_unknown": "ask",
      "dynamic_skill_tool": "ask",
      "computer_use": "ask",
      "task_subagent": "ask"
    }
  },
  "sandbox": {
    "mode": "read_only",
    "cwd": "/workspace/project",
    "filesystem": {
      "kind": "restricted",
      "entries": [
        {
          "path": {
            "kind": "workspace_root"
          },
          "access": "read",
          "provenance": "workspace",
          "resolved_path": "/workspace/project"
        }
      ]
    },
    "tmp": {
      "mode": "isolated"
    },
    "network": {
      "mode": "disabled",
      "allow_localhost": false,
      "allow_unix_sockets": false
    },
    "backend_requirement": "required"
  },
  "process": {
    "shell": {
      "enabled": true,
      "allow_stdin": true,
      "allow_session_inheritance": true
    },
    "environment": {
      "inherit": true,
      "denied_patterns": [
        ".*TOKEN.*",
        ".*SECRET.*",
        ".*PASSWORD.*"
      ]
    },
    "timeout": {
      "max_duration_ms": 1800000
    },
    "command_risk": {}
  },
  "network": {
    "mode": "disabled",
    "allow_localhost": false,
    "allow_unix_sockets": false
  },
  "approval": {
    "allow_once": true,
    "allow_for_turn": true,
    "allow_for_session": false,
    "allow_always": false,
    "request_permissions": true
  },
  "backend": {
    "execution_backend": "claude_cli",
    "capabilities": {
      "can_enforce_filesystem": false,
      "can_enforce_network": false,
      "can_enforce_process": false,
      "supports_turn_scope_approval": true,
      "supports_session_scope_approval": false,
      "supports_request_permissions": true
    }
  },
  "enforcement": {
    "status": "unavailable",
    "reason": "required security capabilities unavailable: filesystem, network, process"
  },
  "created_at_unix_ms": 1700000003000
}
