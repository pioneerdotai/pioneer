{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarkdownDocument",
  "type": "object",
  "properties": {
    "blocks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/MarkdownBlock"
      }
    }
  },
  "$defs": {
    "MarkdownBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            }
          },
          "$ref": "#/$defs/MarkdownInline",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/MarkdownInline"
            },
            "level": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "heading"
            }
          },
          "required": [
            "type",
            "level",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            }
          },
          "$ref": "#/$defs/MarkdownList",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarkdownBlock"
              }
            },
            "type": {
              "type": "string",
              "const": "quote"
            }
          },
          "required": [
            "type",
            "blocks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rule"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "MarkdownInline": {
      "type": "object",
      "properties": {
        "marks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownMark"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "MarkdownList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownListItem"
          }
        },
        "ordered": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "ordered",
        "start"
      ]
    },
    "MarkdownListItem": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownBlock"
          }
        },
        "checked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "MarkdownMark": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/MarkdownMarkKind"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ]
    },
    "MarkdownMarkKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bold"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "italic"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strike"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    }
  }
}