{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadTimelineBlocksChangedNotification",
  "type": "object",
  "properties": {
    "afterCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "beforeCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "changedBlockIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "$ref": "#/$defs/TimelineChangeReason"
    },
    "removedBlockIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "threadId": {
      "type": "string"
    },
    "turnWorkTombstones": {
      "description": "Revisioned removals prevent delayed pages or state notifications from\nresurrecting a work row after its authoritative projection disappeared.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnWorkTombstone"
      }
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "workspaceId",
    "threadId",
    "reason"
  ],
  "$defs": {
    "TimelineChangeReason": {
      "type": "string",
      "enum": [
        "backfill",
        "live_event",
        "state_changed",
        "page_invalidated"
      ]
    },
    "TimelineCursor": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "TurnWorkTombstone": {
      "type": "object",
      "properties": {
        "blockId": {
          "type": "string"
        },
        "projectionUpdatedAtUnixMicros": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "sourceHighWatermark": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "turnId",
        "blockId"
      ]
    }
  }
}