{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadFolderCreateResponse",
  "type": "object",
  "properties": {
    "folder": {
      "$ref": "#/$defs/ThreadFolder"
    }
  },
  "required": [
    "folder"
  ],
  "$defs": {
    "ThreadFolder": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent_folder_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "integer",
          "format": "int64"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "name",
        "created_at",
        "updated_at"
      ]
    }
  }
}