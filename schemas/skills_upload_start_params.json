{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsUploadStartParams",
  "type": "object",
  "properties": {
    "archive_format": {
      "$ref": "#/$defs/SkillArchiveFormat"
    },
    "compressed_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "file_name": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "uncompressed_size_hint_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "file_name",
    "archive_format",
    "compressed_size_bytes",
    "sha256"
  ],
  "$defs": {
    "SkillArchiveFormat": {
      "type": "string",
      "enum": [
        "tar_gz"
      ]
    }
  }
}