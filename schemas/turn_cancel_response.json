{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnCancelResponse",
  "type": "object",
  "required": [
    "thread_id",
    "turn",
    "workspace_id"
  ],
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "turn": {
      "$ref": "#/definitions/Turn"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "PromptManifest": {
      "type": "object",
      "required": [
        "compiler_version",
        "fingerprint_dynamic",
        "fingerprint_full",
        "fingerprint_stable",
        "profile"
      ],
      "properties": {
        "compiler_version": {
          "type": "string"
        },
        "diagnostics": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/PromptManifestDiagnostic"
          }
        },
        "fingerprint_dynamic": {
          "type": "string"
        },
        "fingerprint_full": {
          "type": "string"
        },
        "fingerprint_stable": {
          "type": "string"
        },
        "hook_sources": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/PromptManifestHookSourceEntry"
          }
        },
        "profile": {
          "$ref": "#/definitions/PromptManifestProfile"
        },
        "section_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PromptManifestDiagnostic": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/PromptManifestDiagnosticCode"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_source": {
          "anyOf": [
            {
              "$ref": "#/definitions/PromptManifestHookSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PromptManifestDiagnosticCode": {
      "type": "string",
      "enum": [
        "missing_file",
        "file_read_error",
        "file_truncated",
        "total_budget_truncated",
        "file_filtered_by_profile",
        "dynamic_section_truncated",
        "dynamic_section_omitted",
        "hook_diagnostic",
        "hook_best_effort_failed"
      ]
    },
    "PromptManifestHookContributionKind": {
      "type": "string",
      "enum": [
        "prompt_section",
        "prompt_manifest_diagnostic",
        "runtime_failure"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_compile"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "required": [
        "hook_id",
        "phase",
        "subscription_id"
      ],
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      }
    },
    "PromptManifestHookSourceEntry": {
      "type": "object",
      "required": [
        "contribution_kind",
        "source",
        "truncation"
      ],
      "properties": {
        "contribution_kind": {
          "$ref": "#/definitions/PromptManifestHookContributionKind"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/PromptManifestHookSource"
        },
        "truncation": {
          "$ref": "#/definitions/PromptManifestHookTruncation"
        }
      }
    },
    "PromptManifestHookTruncation": {
      "type": "string",
      "enum": [
        "none",
        "hook",
        "prompt",
        "hook_and_prompt",
        "unknown"
      ]
    },
    "PromptManifestProfile": {
      "type": "string",
      "enum": [
        "assistant_full",
        "assistant_minimal",
        "assistant_none"
      ]
    },
    "Turn": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "prompt_manifest": {
          "anyOf": [
            {
              "$ref": "#/definitions/PromptManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/TurnStatus"
        }
      }
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "InProgress",
        "Completed",
        "Failed",
        "Interrupted"
      ]
    }
  }
}