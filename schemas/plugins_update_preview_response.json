{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginsUpdatePreviewResponse",
  "type": "object",
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginComponentKey"
      }
    },
    "authorization_changes": {
      "description": "Conservative disclosure of changed MCP configurations that may need sign-in.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginComponentKey"
      }
    },
    "identity_resets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginComponentKey"
      }
    },
    "package": {
      "$ref": "#/$defs/PluginsPreviewResponse"
    },
    "removed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginComponentKey"
      }
    },
    "updated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginComponentKey"
      }
    }
  },
  "required": [
    "package",
    "added",
    "updated",
    "identity_resets",
    "removed",
    "authorization_changes"
  ],
  "$defs": {
    "PluginComponentItem": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "mcp_installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_key": {
          "type": "string"
        },
        "runtime_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "member_key",
        "status"
      ]
    },
    "PluginComponentKey": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "member_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "member_key"
      ]
    },
    "PluginDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "PluginsPreviewResponse": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentItem"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginDiagnostic"
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "fingerprint",
        "components",
        "diagnostics"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}