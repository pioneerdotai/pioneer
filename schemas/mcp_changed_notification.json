{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpChangedNotification",
  "type": "object",
  "properties": {
    "changed": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/McpChangedItem"
      }
    },
    "snapshot_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "snapshot_version"
  ],
  "$defs": {
    "McpChangedAction": {
      "type": "string",
      "enum": [
        "install",
        "policy",
        "update",
        "uninstall"
      ]
    },
    "McpChangedItem": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/McpChangedAction"
        },
        "name": {
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/McpSourceKind"
        }
      },
      "required": [
        "name",
        "source_kind",
        "action"
      ]
    },
    "McpSourceKind": {
      "type": "string",
      "enum": [
        "config"
      ]
    }
  }
}