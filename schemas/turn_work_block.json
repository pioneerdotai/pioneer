{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnWorkBlock",
  "type": "object",
  "properties": {
    "afterCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "beforeCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "elapsedMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "firstWorkItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hasMoreAfter": {
      "type": "boolean"
    },
    "hasMoreBefore": {
      "type": "boolean"
    },
    "hiddenWorkCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "lastWorkItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "presentation": {
      "$ref": "#/$defs/TurnWorkPresentation"
    },
    "startedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "state": {
      "$ref": "#/$defs/TurnWorkState"
    },
    "turnId": {
      "type": "string"
    },
    "visibleWorkCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "turnId",
    "presentation",
    "state",
    "workCount",
    "visibleWorkCount",
    "hiddenWorkCount",
    "hasMoreBefore",
    "hasMoreAfter"
  ],
  "$defs": {
    "TimelineCursor": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "TurnWorkPresentation": {
      "type": "string",
      "enum": [
        "expanded_live",
        "collapsed_after_final",
        "expanded_terminal_no_final"
      ]
    },
    "TurnWorkState": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting_for_approval",
        "stalled",
        "completed",
        "blocked",
        "failed",
        "interrupted"
      ]
    }
  }
}