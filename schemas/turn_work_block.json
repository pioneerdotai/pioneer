{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnWorkBlock",
  "type": "object",
  "properties": {
    "afterCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "agentWorkGraph": {
      "description": "Server-owned aggregate state for the root Agent work graph bound to\nthis Turn. Descendant Turns do not repeat the graph projection.",
      "anyOf": [
        {
          "$ref": "#/$defs/AgentWorkGraphProjection"
        },
        {
          "type": "null"
        }
      ]
    },
    "beforeCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "elapsedMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "firstWorkItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hasMoreAfter": {
      "type": "boolean"
    },
    "hasMoreBefore": {
      "type": "boolean"
    },
    "hiddenWorkCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "lastWorkItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "presentation": {
      "$ref": "#/$defs/TurnWorkPresentation"
    },
    "startedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "state": {
      "$ref": "#/$defs/TurnWorkState"
    },
    "turnId": {
      "type": "string"
    },
    "visibleWorkCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "turnId",
    "presentation",
    "state",
    "workCount",
    "visibleWorkCount",
    "hiddenWorkCount",
    "hasMoreBefore",
    "hasMoreAfter"
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentWorkGraphProjection": {
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Stable, bounded nodes in the exact root graph. No prompt, provider,\nmodel, thread title, runtime path, or other private payload is exposed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentWorkNodeProjection"
          }
        },
        "queuedCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rootExecutionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "runningCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "saturated": {
          "description": "True while one or more authorized nodes are durably queued for\nserver-owned capacity. This is resource state, not an authorization\nfailure and never implies that the whole graph is blocked.",
          "type": "boolean"
        },
        "terminalCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAtUnixMicros": {
          "description": "Monotonic persisted resource-state timestamp used only to reject stale\ngraph projections racing with live queue/promotion/finalization events.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "rootExecutionId",
        "updatedAtUnixMicros",
        "queuedCount",
        "runningCount",
        "terminalCount",
        "saturated",
        "nodes"
      ]
    },
    "AgentWorkNodeProjection": {
      "type": "object",
      "properties": {
        "executionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "progressLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/AgentWorkNodeState"
        }
      },
      "additionalProperties": false,
      "required": [
        "executionId",
        "state",
        "progressRevision"
      ]
    },
    "AgentWorkNodeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "TimelineCursor": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "TurnWorkPresentation": {
      "type": "string",
      "enum": [
        "expanded_live",
        "collapsed_after_final",
        "expanded_terminal_no_final"
      ]
    },
    "TurnWorkState": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting_for_approval",
        "stalled",
        "completed",
        "blocked",
        "failed",
        "interrupted"
      ]
    }
  }
}