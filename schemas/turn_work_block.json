{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnWorkBlock",
  "type": "object",
  "properties": {
    "afterCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "agentWorkGraph": {
      "description": "Server-owned aggregate state for the root Agent work graph bound to\nthis Turn. Descendant Turns do not repeat the graph projection.",
      "anyOf": [
        {
          "$ref": "#/$defs/AgentWorkGraphProjection"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "description": "Exact execution whose work this row presents. This is separate from\nthe Turn input author and is required for stable Agent attribution.",
      "anyOf": [
        {
          "$ref": "#/$defs/TurnAuthorSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "beforeCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "elapsedMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "firstWorkItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hasMoreAfter": {
      "type": "boolean"
    },
    "hasMoreBefore": {
      "type": "boolean"
    },
    "hiddenWorkCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "htmlPublications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HtmlPublication"
      }
    },
    "lastWorkItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "presentation": {
      "$ref": "#/$defs/TurnWorkPresentation"
    },
    "startedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "state": {
      "$ref": "#/$defs/TurnWorkState"
    },
    "turnId": {
      "type": "string"
    },
    "visibleWorkCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "turnId",
    "presentation",
    "state",
    "workCount",
    "visibleWorkCount",
    "hiddenWorkCount",
    "hasMoreBefore",
    "hasMoreAfter"
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "AgentPresentationSnapshot": {
      "type": "object",
      "properties": {
        "agent_execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "agent_identity_id": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "identity_source_kind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "identity_source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nickname": {
          "type": "string"
        },
        "role_label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent_identity_id",
        "agent_execution_id",
        "identity_source_kind",
        "identity_source_revision",
        "display_name",
        "nickname"
      ]
    },
    "AgentWorkGraphProjection": {
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Stable, bounded nodes in the exact root graph. No prompt, provider,\nmodel, thread title, runtime path, or other private payload is exposed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentWorkNodeProjection"
          }
        },
        "queuedCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rootExecutionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "runningCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "saturated": {
          "description": "True while one or more authorized nodes are durably queued for\nserver-owned capacity. This is resource state, not an authorization\nfailure and never implies that the whole graph is blocked.",
          "type": "boolean"
        },
        "terminalCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAtUnixMicros": {
          "description": "Monotonic persisted resource-state timestamp used only to reject stale\ngraph projections racing with live queue/promotion/finalization events.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "rootExecutionId",
        "updatedAtUnixMicros",
        "queuedCount",
        "runningCount",
        "terminalCount",
        "saturated",
        "nodes"
      ]
    },
    "AgentWorkNodeProjection": {
      "type": "object",
      "properties": {
        "executionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "progressLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/AgentWorkNodeState"
        }
      },
      "additionalProperties": false,
      "required": [
        "executionId",
        "state",
        "progressRevision"
      ]
    },
    "AgentWorkNodeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "opencode"
      ]
    },
    "HtmlPublication": {
      "description": "An exact Gateway-created HTML publication. Generic HTML attachments never\nacquire this descriptor based on MIME alone.",
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "callId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "threadId",
        "turnId",
        "callId",
        "title",
        "artifact"
      ]
    },
    "PersistedActorRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentExecutionId"
            },
            "kind": {
              "type": "string",
              "const": "agent_execution"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TimelineCursor": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "TurnAuthorSnapshot": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/PersistedActorRef"
        },
        "agent": {
          "description": "Full immutable identity presentation for an agent-authored Turn.  This\nis carried with the Turn instead of being reconstructed from mutable\nidentity/runtime state. Non-agent actors leave it absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentPresentationSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli_runtime_kind": {
          "description": "CLI provider identity projected from persisted execution bindings, independent of artwork.",
          "anyOf": [
            {
              "$ref": "#/$defs/CLIAgentRuntimeKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        }
      },
      "required": [
        "actor",
        "display_name",
        "nickname"
      ]
    },
    "TurnWorkPresentation": {
      "type": "string",
      "enum": [
        "expanded_live",
        "collapsed_after_final",
        "expanded_terminal_no_final"
      ]
    },
    "TurnWorkState": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting_for_approval",
        "stalled",
        "completed",
        "blocked",
        "failed",
        "interrupted"
      ]
    }
  }
}