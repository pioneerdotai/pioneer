{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentIdentityProjection",
  "type": "object",
  "properties": {
    "avatar_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/AgentIdentityId"
    },
    "nickname": {
      "type": "string"
    },
    "role_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_fingerprint": {
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/AgentIdentitySourceKind"
    },
    "source_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "source_kind",
    "display_name",
    "nickname",
    "source_revision",
    "source_fingerprint"
  ],
  "$defs": {
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    }
  }
}