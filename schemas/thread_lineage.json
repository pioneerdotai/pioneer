{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThreadLineage",
  "type": "object",
  "required": [
    "childThreadId",
    "childTurnId",
    "createdAt",
    "depth",
    "parentThreadId",
    "rootThreadId",
    "taskId",
    "taskRunId"
  ],
  "properties": {
    "childThreadId": {
      "type": "string"
    },
    "childTurnId": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "depth": {
      "type": "integer",
      "format": "int64"
    },
    "parentThreadId": {
      "type": "string"
    },
    "parentTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootThreadId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "taskRunId": {
      "type": "string"
    }
  }
}