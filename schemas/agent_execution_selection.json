{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentExecutionSelection",
  "type": "object",
  "properties": {
    "mcpServerIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissionProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionProfileSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "$ref": "#/$defs/AgentExecutionProfileSelection"
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnReasoningSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedCapabilities": {
      "description": "Exact normalized capabilities for a durable Task launch. Legacy launches\nuse skill_ids and mcp_server_ids when this field is empty.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnCapability"
      }
    },
    "skillIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillId"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "profile"
  ],
  "$defs": {
    "AgentExecutionProfileId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileSelection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "inherit_parent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exact": {
              "type": "object",
              "properties": {
                "profile_id": {
                  "$ref": "#/$defs/AgentExecutionProfileId"
                }
              },
              "additionalProperties": false,
              "required": [
                "profile_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "exact"
          ]
        }
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TurnCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TurnCapabilityKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "TurnCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "packId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillPackId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "skillId": {
              "$ref": "#/$defs/SkillId"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "skillId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "packId": {
              "$ref": "#/$defs/SkillPackId"
            },
            "type": {
              "type": "string",
              "const": "skillPack"
            }
          },
          "required": [
            "type",
            "packId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "scopeKind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "type": {
              "type": "string",
              "const": "mcpServer"
            }
          },
          "required": [
            "type",
            "name",
            "scopeKind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rawToolName": {
              "type": "string"
            },
            "scopeKind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "serverName": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mcpTool"
            }
          },
          "required": [
            "type",
            "serverName",
            "rawToolName",
            "scopeKind"
          ]
        }
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSelection": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TurnReasoningSelection": {
      "type": "object",
      "properties": {
        "effort": {
          "description": "String-valued because CLI runtimes may advertise efforts newer than\nPioneer API-provider adapters understand.",
          "type": "string"
        }
      },
      "required": [
        "effort"
      ]
    }
  }
}