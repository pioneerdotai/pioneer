{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLIRuntimeRequestRespondParams",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "resolution": {
      "$ref": "#/$defs/CLIRuntimeRequestResolution"
    },
    "runtime_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "runtime_id",
    "request_id",
    "resolution"
  ],
  "$defs": {
    "CLIRuntimeRequestResolution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "approved"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "const": "denied"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "response": true,
            "status": {
              "type": "string",
              "const": "answered"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      ]
    }
  }
}