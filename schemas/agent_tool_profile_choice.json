{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentToolProfileChoice",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "inherit_parent"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/AgentExecutionProfileId"
        },
        "kind": {
          "type": "string",
          "const": "exact"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    {
      "description": "Direct, catalog-validated selection. Omitting providerId inherits the\ncurrent executor when compatible; otherwise selection must be unique.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "model"
        },
        "modelId": {
          "type": "string"
        },
        "providerId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "modelId"
      ]
    }
  ],
  "$defs": {
    "AgentExecutionProfileId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}