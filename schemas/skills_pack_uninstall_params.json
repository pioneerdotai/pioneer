{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsPackUninstallParams",
  "type": "object",
  "properties": {
    "pack_id": {
      "$ref": "#/$defs/SkillPackId"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "pack_id"
  ],
  "$defs": {
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}