{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolRecoveryPolicySnapshot",
  "type": "object",
  "required": [
    "baseBackoffSecs",
    "canResume",
    "idempotencyMode",
    "maxAttempts",
    "maxWallClockSecs",
    "noProgressLimit",
    "resolvedAction",
    "retryClass"
  ],
  "properties": {
    "baseBackoffSecs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "canResume": {
      "type": "boolean"
    },
    "idempotencyMode": {
      "$ref": "#/definitions/ToolRecoveryIdempotencyMode"
    },
    "maxAttempts": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "maxWallClockSecs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "noProgressLimit": {
      "type": "integer",
      "format": "int64"
    },
    "resolvedAction": {
      "$ref": "#/definitions/RecoveryAction"
    },
    "retryClass": {
      "$ref": "#/definitions/ToolRecoveryRetryClass"
    }
  },
  "definitions": {
    "RecoveryAction": {
      "type": "string",
      "enum": [
        "retry_attempt",
        "retry_with_backoff",
        "restart_turn",
        "fallback",
        "mark_failed"
      ]
    },
    "ToolRecoveryIdempotencyMode": {
      "type": "string",
      "enum": [
        "none",
        "safe",
        "requires_key",
        "session_bound"
      ]
    },
    "ToolRecoveryRetryClass": {
      "type": "string",
      "enum": [
        "never",
        "transient",
        "arguments",
        "session",
        "network"
      ]
    }
  }
}