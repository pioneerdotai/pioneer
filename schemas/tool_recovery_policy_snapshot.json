{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolRecoveryPolicySnapshot",
  "type": "object",
  "properties": {
    "baseBackoffSecs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "canResume": {
      "type": "boolean"
    },
    "idempotencyMode": {
      "$ref": "#/$defs/ToolRecoveryIdempotencyMode"
    },
    "maxAttempts": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "maxWallClockSecs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "noProgressLimit": {
      "type": "integer",
      "format": "int64"
    },
    "resolvedAction": {
      "$ref": "#/$defs/RecoveryAction"
    },
    "retryClass": {
      "$ref": "#/$defs/ToolRecoveryRetryClass"
    }
  },
  "required": [
    "retryClass",
    "idempotencyMode",
    "maxAttempts",
    "canResume",
    "resolvedAction",
    "baseBackoffSecs",
    "maxWallClockSecs",
    "noProgressLimit"
  ],
  "$defs": {
    "RecoveryAction": {
      "type": "string",
      "enum": [
        "retry_attempt",
        "retry_with_backoff",
        "restart_turn",
        "replay_durable_event",
        "rehydrate_turn_state",
        "open_next_execution_window",
        "adapt_provider_request",
        "refresh_provider_auth",
        "compact_history",
        "disable_streaming",
        "disable_unsupported_capability",
        "repair_artifact_finalization",
        "requeue_task_dispatch",
        "block_resumable",
        "fallback",
        "mark_failed"
      ]
    },
    "ToolRecoveryIdempotencyMode": {
      "type": "string",
      "enum": [
        "none",
        "safe",
        "requires_key",
        "session_bound"
      ]
    },
    "ToolRecoveryRetryClass": {
      "type": "string",
      "enum": [
        "never",
        "transient",
        "arguments",
        "session",
        "network"
      ]
    }
  }
}