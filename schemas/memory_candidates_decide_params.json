{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryCandidatesDecideParams",
  "type": "object",
  "required": [
    "candidate_id",
    "decision"
  ],
  "properties": {
    "actor": {
      "anyOf": [
        {
          "$ref": "#/definitions/MemoryActor"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_id": {
      "type": "string"
    },
    "decision": {
      "$ref": "#/definitions/MemoryCandidateDecision"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "MemoryActor": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/MemoryActorKind"
        }
      }
    },
    "MemoryActorKind": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "extractor",
        "system",
        "tool"
      ]
    },
    "MemoryCandidateDecision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "expire"
      ]
    }
  }
}