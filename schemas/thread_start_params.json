{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadStartParams",
  "type": "object",
  "properties": {
    "agent_nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadOriginKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/SandboxMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "sidebar_visibility": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadSidebarVisibility"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "workspace_id"
  ],
  "$defs": {
    "SandboxMode": {
      "type": "string",
      "enum": [
        "FullAccess"
      ]
    },
    "ThreadMode": {
      "type": "string",
      "enum": [
        "Chat",
        "Agent"
      ]
    },
    "ThreadOriginKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "task_run",
            "system"
          ]
        },
        {
          "description": "A user-visible collaborative thread whose Composer submissions execute\nasynchronously in detached task children.",
          "type": "string",
          "const": "collaborative"
        },
        {
          "description": "A one-to-one conversation whose Composer submissions execute\nsynchronously in the thread itself.",
          "type": "string",
          "const": "direct_message"
        },
        {
          "description": "Compatibility value for threads created before execution semantics were\nmade explicit. It retains foreground Composer behavior.",
          "type": "string",
          "const": "user"
        }
      ]
    },
    "ThreadSidebarVisibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ]
    }
  }
}