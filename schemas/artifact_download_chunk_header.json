{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactDownloadChunkHeader",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "chunk_sha256": {
      "type": "string"
    },
    "download_id": {
      "type": "string"
    },
    "final_chunk": {
      "type": "boolean"
    },
    "len": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "version_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "download_id",
    "artifact_id",
    "version_id",
    "offset",
    "len",
    "total_size_bytes",
    "chunk_sha256",
    "final_chunk"
  ]
}