{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnCapabilityKind",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "packId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillPackId"
            },
            {
              "type": "null"
            }
          ]
        },
        "skillId": {
          "$ref": "#/$defs/SkillId"
        },
        "type": {
          "type": "string",
          "const": "skill"
        }
      },
      "required": [
        "type",
        "skillId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "packId": {
          "$ref": "#/$defs/SkillPackId"
        },
        "type": {
          "type": "string",
          "const": "skillPack"
        }
      },
      "required": [
        "type",
        "packId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scopeKind": {
          "$ref": "#/$defs/McpScopeKind"
        },
        "type": {
          "type": "string",
          "const": "mcpServer"
        }
      },
      "required": [
        "type",
        "name",
        "scopeKind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "rawToolName": {
          "type": "string"
        },
        "scopeKind": {
          "$ref": "#/$defs/McpScopeKind"
        },
        "serverName": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcpTool"
        }
      },
      "required": [
        "type",
        "serverName",
        "rawToolName",
        "scopeKind"
      ]
    }
  ],
  "$defs": {
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}