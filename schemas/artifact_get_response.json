{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactGetResponse",
  "type": "object",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactSummary"
    }
  },
  "required": [
    "artifact"
  ],
  "$defs": {
    "ArtifactBindingDirection": {
      "type": "string",
      "enum": [
        "input",
        "output",
        "context",
        "derived"
      ]
    },
    "ArtifactBindingKind": {
      "type": "string",
      "enum": [
        "user_input",
        "agent_output",
        "tool_output",
        "task_result",
        "context_attachment",
        "derived_from",
        "preview",
        "manual_attach",
        "draft_upload"
      ]
    },
    "ArtifactBindingSummary": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "binding_kind": {
          "$ref": "#/$defs/ArtifactBindingKind"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "direction": {
          "$ref": "#/$defs/ArtifactBindingDirection"
        },
        "item_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "workspace_id",
        "binding_kind",
        "direction",
        "created_at"
      ]
    },
    "ArtifactCreatedByKind": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "tool",
        "task",
        "system",
        "import",
        "external_agent"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system",
        "task"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ArtifactSummary": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactBindingSummary"
          }
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "created_by_actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_by_kind": {
          "$ref": "#/$defs/ArtifactCreatedByKind"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "primary_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "integer",
          "format": "int64"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "workspace_id",
        "created_by_kind",
        "created_at",
        "updated_at"
      ]
    }
  }
}