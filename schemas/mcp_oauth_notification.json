{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpOAuthNotification",
  "type": "object",
  "properties": {
    "authorization_url": {
      "description": "Authorization URLs contain ephemeral state. Debug must redact them.",
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostic": {
      "type": [
        "string",
        "null"
      ]
    },
    "flow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "scope_kind": {
      "$ref": "#/$defs/McpScopeKind"
    },
    "server_id": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/McpOAuthState"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "server_id",
    "name",
    "scope_kind",
    "state"
  ],
  "$defs": {
    "McpOAuthState": {
      "type": "string",
      "enum": [
        "idle",
        "preparing",
        "awaiting_callback",
        "exchanging",
        "resolving",
        "retired",
        "cleanup_required",
        "authorized",
        "auth_required",
        "insufficient_scope",
        "denied",
        "cancelled",
        "timed_out",
        "failed"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    }
  }
}