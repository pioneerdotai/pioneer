{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrincipalAuthorSnapshot",
  "type": "object",
  "properties": {
    "avatarRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "principalId": {
      "$ref": "#/$defs/PrincipalId"
    }
  },
  "additionalProperties": false,
  "required": [
    "principalId",
    "displayName",
    "nickname"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}