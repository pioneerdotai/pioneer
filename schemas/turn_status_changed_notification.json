{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStatusChangedNotification",
  "type": "object",
  "properties": {
    "status": {
      "$ref": "#/$defs/TurnStatus"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "turn_id",
    "status"
  ],
  "$defs": {
    "TurnStatus": {
      "type": "string",
      "enum": [
        "InProgress",
        "Completed",
        "Failed",
        "Interrupted",
        "Blocked"
      ]
    }
  }
}