{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressCoalescingKey",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string"
    },
    "stream": {
      "$ref": "#/$defs/ItemDeltaStream"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "stream"
  ],
  "$defs": {
    "ItemDeltaStream": {
      "type": "string",
      "enum": [
        "agent_message",
        "stdout",
        "stderr",
        "tool_progress",
        "file_change",
        "generic"
      ]
    }
  }
}