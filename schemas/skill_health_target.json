{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillHealthTarget",
  "type": "object",
  "properties": {
    "skill_id": {
      "$ref": "#/$defs/SkillId"
    }
  },
  "required": [
    "skill_id"
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}