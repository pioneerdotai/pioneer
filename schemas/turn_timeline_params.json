{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnTimelineParams",
  "type": "object",
  "properties": {
    "composeTasks": {
      "type": "boolean",
      "default": true
    },
    "includeCollapsedTaskEvents": {
      "type": "boolean",
      "default": false
    },
    "maxChildItemsPerTask": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "turnId"
  ]
}