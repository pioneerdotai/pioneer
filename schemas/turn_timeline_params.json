{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnTimelineParams",
  "type": "object",
  "required": [
    "threadId",
    "turnId"
  ],
  "properties": {
    "composeTasks": {
      "default": true,
      "type": "boolean"
    },
    "includeCollapsedTaskEvents": {
      "default": false,
      "type": "boolean"
    },
    "maxChildItemsPerTask": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  }
}