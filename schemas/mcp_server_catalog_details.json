{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServerCatalogDetails",
  "type": "object",
  "properties": {
    "catalog_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "prompts": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/McpPromptCatalogItem"
      }
    },
    "resource_templates": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/McpResourceTemplateCatalogItem"
      }
    },
    "resources": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/McpResourceCatalogItem"
      }
    },
    "server_info": {
      "default": null
    },
    "server_instructions_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/McpToolCatalogItem"
      }
    }
  },
  "definitions": {
    "McpPromptCatalogItem": {
      "type": "object",
      "required": [
        "arguments_count",
        "name"
      ],
      "properties": {
        "arguments_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpResourceCatalogItem": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpResourceTemplateCatalogItem": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri_template": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpToolAnnotationSummary": {
      "type": "object",
      "properties": {
        "destructive_hint": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "idempotent_hint": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "open_world_hint": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "read_only_hint": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpToolCatalogItem": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "annotations": {
          "anyOf": [
            {
              "$ref": "#/definitions/McpToolAnnotationSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_schema_summary": true,
        "name": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}