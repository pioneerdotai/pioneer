{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskDetachedNotification",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/TaskNotificationContext"
    },
    "task": {
      "$ref": "#/$defs/Task"
    }
  },
  "required": [
    "context",
    "task"
  ],
  "$defs": {
    "Task": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "concurrencyPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskConcurrencyPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "createdByThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdByTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveryPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskDeliveryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "goal": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lifecyclePolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskLifecyclePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerKind": {
          "$ref": "#/$defs/TaskOwnerKind"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer",
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRetryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "timeoutPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskTimeoutPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerKind",
        "executorKind",
        "status",
        "title",
        "goal",
        "priority",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAttachmentMode": {
      "type": "string",
      "enum": [
        "attached",
        "detached"
      ]
    },
    "TaskCompletionBehavior": {
      "type": "string",
      "enum": [
        "complete_on_terminal_run",
        "keep_active_for_recurring",
        "manual"
      ]
    },
    "TaskConcurrencyConflictPolicy": {
      "type": "string",
      "enum": [
        "queue",
        "reject",
        "cancel_existing",
        "allow"
      ]
    },
    "TaskConcurrencyPolicy": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxParallelRuns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "onConflict": {
          "$ref": "#/$defs/TaskConcurrencyConflictPolicy"
        }
      },
      "required": [
        "maxParallelRuns",
        "onConflict"
      ]
    },
    "TaskDeliveryFormat": {
      "type": "string",
      "enum": [
        "summary",
        "full_result"
      ]
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "owner_thread",
        "thread",
        "user_notification",
        "webhook"
      ]
    },
    "TaskDeliveryPolicy": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TaskDeliveryFormat"
        },
        "includeResult": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/TaskDeliveryMode"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "webhookUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "includeResult",
        "format"
      ]
    },
    "TaskError": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "class"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskLifecyclePolicy": {
      "type": "object",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/TaskAttachmentMode"
        },
        "completion": {
          "$ref": "#/$defs/TaskCompletionBehavior"
        },
        "onParentCancel": {
          "$ref": "#/$defs/TaskParentTerminalAction"
        },
        "onParentFailure": {
          "$ref": "#/$defs/TaskParentTerminalAction"
        }
      },
      "required": [
        "attachment",
        "onParentCancel",
        "onParentFailure",
        "completion"
      ]
    },
    "TaskMetadata": {
      "type": "object",
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TaskNotificationContext": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "int64"
        },
        "taskId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "taskId",
        "eventId",
        "sequence"
      ]
    },
    "TaskOwnerKind": {
      "type": "string",
      "enum": [
        "user",
        "thread",
        "workspace",
        "system"
      ]
    },
    "TaskParentTerminalAction": {
      "type": "string",
      "enum": [
        "cancel",
        "detach",
        "keep_running"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskRetryBackoffKind": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "exponential"
      ]
    },
    "TaskRetryPolicy": {
      "type": "object",
      "properties": {
        "backoff": {
          "$ref": "#/$defs/TaskRetryBackoffKind"
        },
        "initialDelaySeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "maxAttempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxDelaySeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "retryOn": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskErrorClass"
          }
        }
      },
      "required": [
        "maxAttempts",
        "backoff"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "waiting_review",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "TaskTimeoutPolicy": {
      "type": "object",
      "properties": {
        "heartbeatTimeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "queueTimeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "runTimeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      }
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}