{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAgentSpec",
  "type": "object",
  "properties": {
    "agentNickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentRole": {
      "type": [
        "string",
        "null"
      ]
    },
    "contextPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentContextPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "depth": {
      "type": "integer",
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "maxDepth": {
      "type": "integer",
      "format": "int64"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelProvider": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "$ref": "#/$defs/TaskAgentPrompt"
    },
    "resultContract": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentResultContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentReviewPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "taskId": {
      "type": "string"
    },
    "toolPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentToolPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "id",
    "taskId",
    "prompt",
    "depth",
    "maxDepth",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "TaskAgentContext": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputAttachment"
          }
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputReference"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputVariable"
          }
        }
      }
    },
    "TaskAgentContextMode": {
      "type": "string",
      "enum": [
        "inherit_parent",
        "last_n_turns",
        "summary_only",
        "empty",
        "custom"
      ]
    },
    "TaskAgentContextPolicy": {
      "type": "object",
      "properties": {
        "customContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAgentContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeArtifacts": {
          "type": "boolean"
        },
        "includeParentSummary": {
          "type": "boolean"
        },
        "maxTurns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskAgentContextMode"
        }
      },
      "required": [
        "mode",
        "includeParentSummary",
        "includeArtifacts"
      ]
    },
    "TaskAgentInput": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputAttachment"
          }
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputReference"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputVariable"
          }
        }
      }
    },
    "TaskAgentInputAttachment": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/TaskAgentInputAttachmentKind"
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "TaskAgentInputAttachmentKind": {
      "type": "string",
      "enum": [
        "file",
        "artifact",
        "url"
      ]
    },
    "TaskAgentInputReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TaskAgentInputReferenceKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "TaskAgentInputReferenceKind": {
      "type": "string",
      "enum": [
        "thread",
        "turn",
        "task",
        "task_run",
        "artifact"
      ]
    },
    "TaskAgentInputVariable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/TaskValue"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "TaskAgentPrompt": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAgentInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "outputInstructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "goal"
      ]
    },
    "TaskAgentResultContract": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TaskAgentResultFormat"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "required"
      ]
    },
    "TaskAgentResultFormat": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "json",
        "artifact"
      ]
    },
    "TaskAgentReviewMode": {
      "type": "string",
      "enum": [
        "none",
        "parent_agent",
        "parent_agent_with_reviewers",
        "user_approval"
      ]
    },
    "TaskAgentReviewPolicy": {
      "type": "object",
      "properties": {
        "maxRevisionRounds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskAgentReviewMode"
        },
        "requireExplicitAcceptance": {
          "type": "boolean"
        },
        "resolutionStrategy": {
          "$ref": "#/$defs/TaskResultReviewResolutionStrategy"
        },
        "reviewers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskResultReviewerSpec"
          }
        }
      },
      "required": [
        "mode",
        "maxRevisionRounds",
        "requireExplicitAcceptance",
        "resolutionStrategy"
      ]
    },
    "TaskAgentToolPolicy": {
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "allowedTools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "deniedTools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "networkAccess": {
          "type": "boolean"
        },
        "writeMode": {
          "$ref": "#/$defs/TaskAgentWriteMode"
        }
      },
      "required": [
        "writeMode",
        "networkAccess"
      ]
    },
    "TaskAgentWriteMode": {
      "type": "string",
      "enum": [
        "read_only",
        "workspace_write",
        "scoped_write",
        "full_access"
      ]
    },
    "TaskResultReviewResolutionStrategy": {
      "type": "string",
      "enum": [
        "parent_final",
        "user_final",
        "require_all_required_reviewers_then_parent",
        "quorum_then_parent",
        "any_required_reviewer_can_request_changes"
      ]
    },
    "TaskResultReviewerKind": {
      "type": "string",
      "enum": [
        "runtime_auto",
        "parent_agent",
        "review_agent",
        "user",
        "system"
      ]
    },
    "TaskResultReviewerSpec": {
      "type": "object",
      "properties": {
        "agentNickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "reviewerKind": {
          "$ref": "#/$defs/TaskResultReviewerKind"
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "reviewerKind",
        "required"
      ]
    },
    "TaskSchema": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "$ref": "#/$defs/TaskValue"
        }
      },
      "required": [
        "schema"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}