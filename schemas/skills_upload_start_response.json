    "max_compressed_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "max_uncompressed_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "recommended_chunk_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "upload_id": {
