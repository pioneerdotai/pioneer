{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayCliRuntimeSettings",
  "type": "object",
  "properties": {
    "instances": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/GatewayCliRuntimeInstanceSettings"
      }
    }
  },
  "$defs": {
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "GatewayCliRuntimeInstanceSettings": {
      "type": "object",
      "properties": {
        "binary_path": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "home_path": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CLIAgentRuntimeKind"
        },
        "nickname": {
          "description": "Stable workspace nickname used by the direct AgentIdentity projection.\nThe default keeps old settings files readable; gateway validation owns\nuniqueness and rejects an empty/duplicate value before activation.",
          "type": "string",
          "default": ""
        },
        "shadow_home_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "display_name",
        "enabled",
        "binary_path",
        "home_path"
      ]
    }
  }
}