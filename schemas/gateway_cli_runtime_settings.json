{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayCliRuntimeSettings",
  "type": "object",
  "properties": {
    "instances": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/GatewayCliRuntimeInstanceSettings"
      }
    }
  },
  "$defs": {
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "GatewayCliRuntimeInstanceSettings": {
      "type": "object",
      "properties": {
        "binary_path": {
          "type": "string"
        },
        "compaction_model": {
          "description": "Workspace override. Omission in updates preserves the stored value;\nan explicit Inherit removes it without affecting other workspaces.",
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayModelSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "home_path": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CLIAgentRuntimeKind"
        },
        "nickname": {
          "description": "Stable workspace nickname used by the direct AgentIdentity projection.\nThe default keeps old settings files readable; gateway validation owns\nuniqueness and rejects an empty/duplicate value before activation.",
          "type": "string",
          "default": ""
        },
        "shadow_home_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "display_name",
        "enabled",
        "binary_path",
        "home_path"
      ]
    },
    "GatewayModelSelection": {
      "description": "Inherit is a real absence of an override. It never stores a resolved fallback.\nThe tagged value also distinguishes an explicit reset from an omitted update.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "instance": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "reasoning_effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "const": "explicit"
            },
            "transport": {
              "$ref": "#/$defs/ModelSelectionTransport"
            }
          },
          "additionalProperties": false,
          "required": [
            "source",
            "transport",
            "instance",
            "model"
          ]
        }
      ]
    },
    "ModelSelectionTransport": {
      "type": "string",
      "enum": [
        "api",
        "codex",
        "claude"
      ]
    }
  }
}