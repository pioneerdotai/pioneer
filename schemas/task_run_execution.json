{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskRunExecution",
  "type": "object",
  "properties": {
    "childThreadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "childTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "completedAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskError"
        },
        {
          "type": "null"
        }
      ]
    },
    "executorKind": {
      "$ref": "#/$defs/TaskExecutorKind"
    },
    "heartbeatAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "leaseUntil": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "status": {
      "$ref": "#/$defs/TaskRunExecutionStatus"
    },
    "taskId": {
      "type": "string"
    },
    "taskRunId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    },
    "workerId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "taskId",
    "taskRunId",
    "executorKind",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskError": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "class"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskRunExecutionStatus": {
      "type": "string",
      "enum": [
        "reserved",
        "starting",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}