{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsChangedNotification",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillChangedItem"
      }
    },
    "created_at": {
      "type": "integer",
      "format": "int64"
    },
    "pack_changes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillPackChangedItem"
      }
    },
    "reason": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "snapshot_version",
    "reason",
    "created_at"
  ],
  "$defs": {
    "SkillChangedItem": {
      "type": "object",
      "properties": {
        "change_type": {
          "type": "string"
        },
        "fingerprint_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_id": {
          "$ref": "#/$defs/SkillId"
        },
        "slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "slug",
        "source_kind",
        "change_type"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackChangedItem": {
      "type": "object",
      "properties": {
        "change_type": {
          "type": "string"
        },
        "name_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "pack_id": {
          "$ref": "#/$defs/SkillPackId"
        }
      },
      "required": [
        "pack_id",
        "change_type"
      ]
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}