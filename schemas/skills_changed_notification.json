{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillsChangedNotification",
  "type": "object",
  "required": [
    "created_at",
    "reason",
    "snapshot_version",
    "workspace_id"
  ],
  "properties": {
    "changes": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillChangedItem"
      }
    },
    "created_at": {
      "type": "integer",
      "format": "int64"
    },
    "reason": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "SkillChangedItem": {
      "type": "object",
      "required": [
        "change_type",
        "slug",
        "source_kind"
      ],
      "properties": {
        "change_type": {
          "type": "string"
        },
        "fingerprint_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        }
      }
    }
  }
}