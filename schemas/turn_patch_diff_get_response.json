{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnPatchDiffGetResponse",
  "type": "object",
  "properties": {
    "afterOrdinal": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "coverage": {
      "$ref": "#/$defs/PatchHistoryCoverageView"
    },
    "exactness": {
      "$ref": "#/$defs/TurnDiffExactnessView"
    },
    "filesystem": {
      "$ref": "#/$defs/TurnFilesystemCoverageView",
      "default": {
        "kind": "incomplete",
        "reason": "turn-wide filesystem coverage was not recorded",
        "sources": []
      }
    },
    "recordsRendered": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "threadId": {
      "type": "string"
    },
    "throughOrdinal": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "turnId": {
      "type": "string"
    },
    "unifiedPatch": {
      "type": "string"
    },
    "view": {
      "$ref": "#/$defs/PatchHistoryViewKind"
    }
  },
  "required": [
    "view",
    "threadId",
    "turnId",
    "exactness",
    "coverage",
    "unifiedPatch",
    "recordsRendered"
  ],
  "$defs": {
    "PatchFilesystemMutationSourceView": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "toolName": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "toolName",
        "reason"
      ]
    },
    "PatchHistoryCoverageView": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine_verified_steps"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider_reported_steps"
            },
            "protocol": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "protocol"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "aggregate_only"
            },
            "protocol": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "protocol"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "incomplete"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "untracked"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "PatchHistoryViewKind": {
      "type": "string",
      "enum": [
        "timeline",
        "turn_aggregate",
        "record_diff"
      ]
    },
    "TurnDiffExactnessView": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine_verified"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider_reported"
            },
            "protocol": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "protocol"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "incomplete"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "TurnFilesystemCoverageView": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "complete"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "incomplete"
            },
            "reason": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PatchFilesystemMutationSourceView"
              }
            }
          },
          "required": [
            "kind",
            "reason",
            "sources"
          ]
        }
      ]
    }
  }
}