{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptManifestHookSourceEntry",
  "type": "object",
  "properties": {
    "contribution_kind": {
      "$ref": "#/$defs/PromptManifestHookContributionKind"
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "section_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "$ref": "#/$defs/PromptManifestHookSource"
    },
    "source_count": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "truncation": {
      "$ref": "#/$defs/PromptManifestHookTruncation"
    }
  },
  "required": [
    "source",
    "contribution_kind",
    "truncation"
  ],
  "$defs": {
    "PromptManifestHookContributionKind": {
      "type": "string",
      "enum": [
        "prompt_context",
        "thread_context",
        "prompt_section",
        "prompt_manifest_diagnostic",
        "runtime_failure"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_context",
        "turn_post_preflight_prompt_context",
        "turn_pre_prompt_compile",
        "runtime_turn_pre_context"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "hook_id",
        "subscription_id",
        "phase"
      ]
    },
    "PromptManifestHookTruncation": {
      "type": "string",
      "enum": [
        "none",
        "hook",
        "prompt",
        "hook_and_prompt",
        "unknown"
      ]
    }
  }
}