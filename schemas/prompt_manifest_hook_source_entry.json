{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromptManifestHookSourceEntry",
  "type": "object",
  "required": [
    "contribution_kind",
    "source",
    "truncation"
  ],
  "properties": {
    "contribution_kind": {
      "$ref": "#/definitions/PromptManifestHookContributionKind"
    },
    "section_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "$ref": "#/definitions/PromptManifestHookSource"
    },
    "truncation": {
      "$ref": "#/definitions/PromptManifestHookTruncation"
    }
  },
  "definitions": {
    "PromptManifestHookContributionKind": {
      "type": "string",
      "enum": [
        "prompt_section",
        "prompt_manifest_diagnostic",
        "runtime_failure"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_compile"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "required": [
        "hook_id",
        "phase",
        "subscription_id"
      ],
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      }
    },
    "PromptManifestHookTruncation": {
      "type": "string",
      "enum": [
        "none",
        "hook",
        "prompt",
        "hook_and_prompt",
        "unknown"
      ]
    }
  }
}