{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskWaitNonWaitableItem",
  "type": "object",
  "properties": {
    "item": {
      "$ref": "#/$defs/PublicTaskWaitItem"
    },
    "nextFireAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "reason": {
      "$ref": "#/$defs/TaskWaitNonWaitableReason"
    }
  },
  "required": [
    "item",
    "reason"
  ],
  "$defs": {
    "PublicError": {
      "description": "Stable, bounded failure presentation shared by RPC, voice and task\nexecution surfaces. Raw source chains are never part of this type.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PublicErrorCode"
        },
        "correlation_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PublicErrorStage"
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "code",
        "stage",
        "message",
        "retryable",
        "correlation_id"
      ]
    },
    "PublicErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "policy_denied",
        "not_found",
        "conflict",
        "resource_exhausted",
        "unavailable",
        "timeout",
        "internal"
      ]
    },
    "PublicErrorStage": {
      "type": "string",
      "enum": [
        "discovery",
        "admission",
        "preparation",
        "execution",
        "persistence",
        "delivery",
        "observation"
      ]
    },
    "PublicTask": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "createdByThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdByTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "goal": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ownerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerKind": {
          "$ref": "#/$defs/TaskOwnerKind"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer",
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerKind",
        "executorKind",
        "status",
        "title",
        "goal",
        "priority",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "error": {
          "$ref": "#/$defs/PublicError"
        }
      },
      "required": [
        "class",
        "error"
      ]
    },
    "PublicTaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicTaskArtifact"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskRun": {
      "type": "object",
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "runNumber": {
          "type": "integer",
          "format": "int64"
        },
        "startedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskRunStatus"
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "attemptNumber",
        "runNumber",
        "status",
        "executorKind",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskWaitItem": {
      "type": "object",
      "properties": {
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "$ref": "#/$defs/PublicTask"
        }
      },
      "required": [
        "task"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskOwnerKind": {
      "type": "string",
      "enum": [
        "user",
        "thread",
        "workspace",
        "system"
      ]
    },
    "TaskRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "waiting",
        "waiting_review",
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "timed_out"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "waiting_review",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "TaskWaitNonWaitableReason": {
      "type": "string",
      "enum": [
        "future_scheduled_task_without_active_run"
      ]
    }
  }
}