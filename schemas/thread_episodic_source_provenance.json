{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadEpisodicSourceProvenance",
  "description": "Evidence pointer for a thread episodic source item.\n\nThis is not a durable-memory identity. It points to where recalled\nconversation context came from so later layers can filter, debug, rebuild,\nand cite the exact source item without reusing durable memory record ids.",
  "type": "object",
  "properties": {
    "created_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "index_item_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "source_actor_role": {
      "$ref": "#/$defs/ThreadEpisodicSourceActorRole"
    },
    "source_context": {
      "$ref": "#/$defs/ThreadEpisodicSourceContext"
    },
    "source_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "index_item_id",
    "source_actor_role",
    "source_context"
  ],
  "$defs": {
    "ThreadEpisodicSourceActorRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "task_summary",
        "generated_summary"
      ]
    },
    "ThreadEpisodicSourceContext": {
      "type": "string",
      "enum": [
        "user_visible_thread_item",
        "user_visible_task_summary",
        "thread_compaction_summary",
        "hidden_prompt",
        "reasoning_trace",
        "raw_tool_output",
        "raw_task_runtime",
        "internal_hook_runtime",
        "system_prompt",
        "developer_prompt",
        "unknown"
      ]
    }
  }
}