{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnTimelineChangedNotification",
  "type": "object",
  "properties": {
    "childThreadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "childTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "$ref": "#/$defs/TurnTimelineChangedReason"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "workspaceId",
    "threadId",
    "turnId",
    "reason"
  ],
  "$defs": {
    "TurnTimelineChangedReason": {
      "type": "string",
      "enum": [
        "parent_turn_changed",
        "task_event_changed",
        "child_turn_changed",
        "collapse_state_hint_changed"
      ]
    }
  }
}