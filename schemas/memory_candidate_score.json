{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCandidateScore",
  "type": "object",
  "properties": {
    "bucket": {
      "$ref": "#/$defs/MemoryCandidateScoreBucket"
    },
    "certainty_score": {
      "type": "number",
      "format": "float"
    },
    "durability_score": {
      "type": "number",
      "format": "float"
    },
    "evidence_score": {
      "type": "number",
      "format": "float"
    },
    "explicitness_score": {
      "type": "number",
      "format": "float"
    },
    "fact_class_score": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "lifetime_fit_score": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "ownership_fit_score": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "penalty_score": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relation_score": {
      "type": "number",
      "format": "float"
    },
    "scope_score": {
      "type": "number",
      "format": "float"
    },
    "score_version": {
      "type": "string",
      "default": "semantic_v1"
    },
    "sensitivity_score": {
      "type": "number",
      "format": "float"
    },
    "source_trust_score": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "total_score": {
      "type": "number",
      "format": "float"
    }
  },
  "required": [
    "total_score",
    "bucket",
    "explicitness_score",
    "durability_score",
    "scope_score",
    "evidence_score",
    "certainty_score",
    "sensitivity_score",
    "relation_score"
  ],
  "$defs": {
    "MemoryCandidateScoreBucket": {
      "type": "string",
      "enum": [
        "high",
        "middle",
        "extremely_low"
      ]
    }
  }
}