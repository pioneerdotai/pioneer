{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryCandidatesListParams",
  "type": "object",
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MemoryScope"
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MemoryCandidateStatus"
      }
    }
  },
  "definitions": {
    "MemoryCandidateStatus": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ]
    },
    "MemoryScope": {
      "type": "object",
      "required": [
        "key",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/MemoryScopeKind"
        }
      }
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    }
  }
}