{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarkdownInline",
  "type": "object",
  "properties": {
    "marks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/MarkdownMark"
      }
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "text"
  ],
  "$defs": {
    "MarkdownMark": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/MarkdownMarkKind"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ]
    },
    "MarkdownMarkKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bold"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "italic"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strike"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    }
  }
}