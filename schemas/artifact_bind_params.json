{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactBindParams",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "binding_kind": {
      "$ref": "#/$defs/ArtifactBindingKind"
    },
    "direction": {
      "$ref": "#/$defs/ArtifactBindingDirection"
    },
    "item_index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRole"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "artifact_id",
    "binding_kind",
    "direction"
  ],
  "$defs": {
    "ArtifactBindingDirection": {
      "type": "string",
      "enum": [
        "input",
        "output",
        "context",
        "derived"
      ]
    },
    "ArtifactBindingKind": {
      "type": "string",
      "enum": [
        "user_input",
        "agent_output",
        "tool_output",
        "task_result",
        "context_attachment",
        "derived_from",
        "preview",
        "system_capture",
        "manual_attach",
        "draft_upload"
      ]
    },
    "ArtifactRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system",
        "task"
      ]
    }
  }
}