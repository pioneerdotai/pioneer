{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserInput",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "textElements": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TextElement"
          }
        },
        "type": {
          "type": "string",
          "const": "text"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "localImage"
        }
      },
      "required": [
        "type",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "localFile"
        }
      },
      "required": [
        "type",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "audio"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "localAudio"
        }
      },
      "required": [
        "type",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "video"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "localVideo"
        }
      },
      "required": [
        "type",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "artifact"
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "artifactId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "skill"
        }
      },
      "required": [
        "type",
        "name",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mention"
        }
      },
      "required": [
        "type",
        "name",
        "path"
      ]
    }
  ],
  "$defs": {
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "TextElement": {
      "type": "object",
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_range"
      ]
    }
  }
}