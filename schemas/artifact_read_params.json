{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactReadParams",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "max_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "projection_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "artifact_id"
  ],
  "$defs": {
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    }
  }
}