{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactDownloadCapabilities",
  "type": "object",
  "properties": {
    "max_chunk_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "max_concurrent_downloads": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "recommended_chunk_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "recommended_chunk_size_bytes",
    "max_chunk_size_bytes",
    "max_concurrent_downloads"
  ]
}