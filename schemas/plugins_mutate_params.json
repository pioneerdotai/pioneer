{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginsMutateParams",
  "type": "object",
  "properties": {
    "expected_revision": {
      "type": "integer",
      "format": "int64"
    },
    "intent": {
      "$ref": "#/$defs/PluginManagementIntent"
    },
    "plugin_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "plugin_id",
    "expected_revision",
    "intent"
  ],
  "$defs": {
    "PluginComponentKey": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "member_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "member_key"
      ]
    },
    "PluginManagementIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "update"
            },
            "confirm_changes": {
              "type": "boolean"
            },
            "expected_fingerprint": {
              "type": "string"
            },
            "upload_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "upload_id",
            "expected_fingerprint",
            "confirm_changes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "retry"
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PluginComponentKey"
              }
            },
            "restore_removed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "components",
            "restore_removed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "continue"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "remove"
            },
            "purge_data": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "purge_data"
          ]
        }
      ]
    }
  }
}