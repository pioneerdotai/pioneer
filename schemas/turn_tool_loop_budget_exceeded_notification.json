{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnToolLoopBudgetExceededNotification",
  "type": "object",
  "required": [
    "action",
    "limit",
    "limit_kind",
    "observed",
    "reason",
    "thread_id",
    "turn_id",
    "workspace_id"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/ToolLoopBudgetAction"
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "limit_kind": {
      "$ref": "#/definitions/ToolLoopBudgetLimitKind"
    },
    "observed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "reason": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "ToolLoopBudgetAction": {
      "type": "string",
      "enum": [
        "request_final_no_tools_round",
        "fail_turn"
      ]
    },
    "ToolLoopBudgetLimitKind": {
      "type": "string",
      "enum": [
        "agent_rounds",
        "tool_calls",
        "provider_returned_tools_after_tools_disabled"
      ]
    }
  }
}