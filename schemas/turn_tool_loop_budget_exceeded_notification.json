{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnToolLoopBudgetExceededNotification",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/ToolLoopBudgetAction"
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "limit_kind": {
      "$ref": "#/$defs/ToolLoopBudgetLimitKind"
    },
    "observed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "limit_kind",
    "limit",
    "observed",
    "action",
    "reason"
  ],
  "$defs": {
    "ToolLoopBudgetAction": {
      "type": "string",
      "enum": [
        "continue_in_next_window",
        "request_final_no_tools_round",
        "fail_turn"
      ]
    },
    "ToolLoopBudgetLimitKind": {
      "type": "string",
      "enum": [
        "agent_rounds",
        "tool_calls",
        "provider_returned_tools_after_tools_disabled"
      ]
    }
  }
}