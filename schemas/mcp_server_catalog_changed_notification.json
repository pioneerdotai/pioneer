{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServerCatalogChangedNotification",
  "type": "object",
  "required": [
    "catalog_version",
    "name",
    "prompts_count",
    "resource_templates_count",
    "resources_count",
    "server_id",
    "snapshot_version",
    "tools_count",
    "workspace_id"
  ],
  "properties": {
    "catalog_version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "prompts_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "resource_templates_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "resources_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "server_id": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "tools_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "workspace_id": {
      "type": "string"
    }
  }
}