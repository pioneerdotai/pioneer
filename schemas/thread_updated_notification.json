{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadUpdatedNotification",
  "type": "object",
  "properties": {
    "placement": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadPlacement"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread": {
      "$ref": "#/$defs/Thread"
    }
  },
  "required": [
    "thread"
  ],
  "$defs": {
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "PersistedActorRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "PromptManifest": {
      "type": "object",
      "properties": {
        "compiler_version": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptManifestDiagnostic"
          }
        },
        "fingerprint_dynamic": {
          "type": "string"
        },
        "fingerprint_full": {
          "type": "string"
        },
        "fingerprint_stable": {
          "type": "string"
        },
        "hook_sources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptManifestHookSourceEntry"
          }
        },
        "profile": {
          "$ref": "#/$defs/PromptManifestProfile"
        },
        "section_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "compiler_version",
        "profile",
        "fingerprint_stable",
        "fingerprint_dynamic",
        "fingerprint_full"
      ]
    },
    "PromptManifestDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PromptManifestDiagnosticCode"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptManifestHookSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "PromptManifestDiagnosticCode": {
      "type": "string",
      "enum": [
        "missing_file",
        "file_read_error",
        "file_truncated",
        "total_budget_truncated",
        "file_filtered_by_profile",
        "dynamic_section_truncated",
        "dynamic_section_omitted",
        "hook_diagnostic",
        "hook_best_effort_failed",
        "capability_rejected"
      ]
    },
    "PromptManifestHookContributionKind": {
      "type": "string",
      "enum": [
        "prompt_context",
        "thread_context",
        "prompt_section",
        "prompt_manifest_diagnostic",
        "runtime_failure"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_context",
        "turn_post_preflight_prompt_context",
        "turn_pre_prompt_compile",
        "runtime_turn_pre_context"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "hook_id",
        "subscription_id",
        "phase"
      ]
    },
    "PromptManifestHookSourceEntry": {
      "type": "object",
      "properties": {
        "contribution_kind": {
          "$ref": "#/$defs/PromptManifestHookContributionKind"
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/PromptManifestHookSource"
        },
        "source_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "truncation": {
          "$ref": "#/$defs/PromptManifestHookTruncation"
        }
      },
      "required": [
        "source",
        "contribution_kind",
        "truncation"
      ]
    },
    "PromptManifestHookTruncation": {
      "type": "string",
      "enum": [
        "none",
        "hook",
        "prompt",
        "hook_and_prompt",
        "unknown"
      ]
    },
    "PromptManifestProfile": {
      "type": "string",
      "enum": [
        "assistant_full",
        "assistant_minimal",
        "assistant_none",
        "cli_runtime"
      ]
    },
    "Thread": {
      "type": "object",
      "properties": {
        "agent_nickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ThreadMode"
        },
        "model": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin_kind": {
          "$ref": "#/$defs/ThreadOriginKind",
          "default": "user"
        },
        "preview": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "sidebar_visibility": {
          "$ref": "#/$defs/ThreadSidebarVisibility",
          "default": "visible"
        },
        "status": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Turn"
          }
        },
        "updated_at": {
          "type": "integer",
          "format": "int64"
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadVisibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "id",
        "preview",
        "mode",
        "model",
        "model_provider",
        "created_at",
        "updated_at",
        "status",
        "turns"
      ]
    },
    "ThreadMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Message",
            "Agent"
          ]
        },
        {
          "description": "Compatibility default for pre-Epic-6 persisted and wire values. New\nuser-thread creation selects `Message` explicitly.",
          "type": "string",
          "const": "Chat"
        }
      ]
    },
    "ThreadOriginKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "task_run",
            "system"
          ]
        },
        {
          "description": "A user-visible collaborative thread whose Composer submissions execute\nasynchronously in detached task children.",
          "type": "string",
          "const": "collaborative"
        },
        {
          "description": "A one-to-one conversation whose Composer submissions execute\nsynchronously in the thread itself.",
          "type": "string",
          "const": "direct_message"
        },
        {
          "description": "Compatibility value for threads created before execution semantics were\nmade explicit. It retains foreground Composer behavior.",
          "type": "string",
          "const": "user"
        }
      ]
    },
    "ThreadPlacement": {
      "type": "object",
      "properties": {
        "folder_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "workspace_id"
      ]
    },
    "ThreadSidebarVisibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ]
    },
    "ThreadStatus": {
      "type": "string",
      "enum": [
        "Active",
        "Idle",
        "Closed"
      ]
    },
    "ThreadVisibility": {
      "description": "User-selectable visibility for ordinary user threads.\n\nInternal task/system threads deliberately have no public selectable value.",
      "type": "string",
      "enum": [
        "private",
        "workspace"
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "Turn": {
      "type": "object",
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnAuthorSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "mentions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnMention"
          }
        },
        "message_deleted": {
          "type": "boolean",
          "default": false
        },
        "message_revision": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/ThreadMode",
          "default": "Chat"
        },
        "origin": {
          "$ref": "#/$defs/TurnOrigin",
          "default": "user"
        },
        "permission_profile": {
          "$ref": "#/$defs/TurnPermissionProfileSnapshot"
        },
        "prompt_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply_to_turn_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "turn_kind": {
          "$ref": "#/$defs/TurnKind",
          "default": "conversation"
        }
      },
      "required": [
        "id",
        "status",
        "permission_profile"
      ]
    },
    "TurnAuthorSnapshot": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/PersistedActorRef"
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        }
      },
      "required": [
        "actor",
        "display_name",
        "nickname"
      ]
    },
    "TurnKind": {
      "type": "string",
      "enum": [
        "conversation",
        "task_run"
      ]
    },
    "TurnMention": {
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "required": [
        "principal_id",
        "nickname"
      ]
    },
    "TurnOrigin": {
      "type": "string",
      "enum": [
        "user",
        "scheduled_task",
        "detached_task",
        "attached_task",
        "task_delivery"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSnapshot": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "source": {
          "$ref": "#/$defs/TurnPermissionProfileSource"
        }
      },
      "required": [
        "mode",
        "source",
        "effective_policy"
      ]
    },
    "TurnPermissionProfileSource": {
      "type": "string",
      "enum": [
        "composer",
        "defaulted",
        "inherited_from_parent_turn",
        "task_permission_cap",
        "system"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "InProgress",
        "Completed",
        "Failed",
        "Interrupted",
        "Blocked"
      ]
    }
  }
}