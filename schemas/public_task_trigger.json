{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskTrigger",
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/TaskTriggerKind"
    },
    "lastFireAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "nextFireAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "status": {
      "$ref": "#/$defs/TaskTriggerStatus"
    },
    "taskId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "id",
    "taskId",
    "status",
    "kind",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "TaskTriggerKind": {
      "type": "string",
      "enum": [
        "immediate",
        "scheduled_at",
        "interval",
        "cron",
        "manual",
        "external",
        "dependency"
      ]
    },
    "TaskTriggerStatus": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "exhausted",
        "cancelled"
      ]
    }
  }
}