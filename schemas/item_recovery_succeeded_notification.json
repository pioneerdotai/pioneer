{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemRecoverySucceededNotification",
  "type": "object",
  "properties": {
    "attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "recovery_job_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "item_type",
    "recovery_job_id",
    "attempt_number"
  ],
  "$defs": {
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}