{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemToolRetryResolvedNotification",
  "type": "object",
  "properties": {
    "attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "budgets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolRetryBudgetUsage"
      }
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "reason": {
      "type": "string"
    },
    "resolution": {
      "$ref": "#/$defs/ToolRetryResolution"
    },
    "thread_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_retry_episode_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "item_type",
    "tool_retry_episode_id",
    "tool_name",
    "attempt_number",
    "resolution",
    "reason"
  ],
  "$defs": {
    "ToolRetryBudgetKind": {
      "type": "string",
      "enum": [
        "episode",
        "error_class",
        "tool_name",
        "failure_signature"
      ]
    },
    "ToolRetryBudgetUsage": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolRetryBudgetKind"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "used",
        "limit"
      ]
    },
    "ToolRetryResolution": {
      "type": "string",
      "enum": [
        "succeeded",
        "non_retryable"
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}