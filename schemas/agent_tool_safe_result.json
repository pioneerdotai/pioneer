{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentToolSafeResult",
  "type": "object",
  "properties": {
    "outboxId": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentPublicOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "publicMessage": {
      "type": [
        "string",
        "null"
      ]
    },
    "receiptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/AgentToolResultStatus"
    },
    "targetOptions": {
      "description": "Refreshed opaque destinations after thread creation, including replay.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentToolTargetOption"
      }
    },
    "threadResult": {
      "description": "Durable references from a committed thread action. IDs do not grant access.",
      "anyOf": [
        {
          "$ref": "#/$defs/AgentThreadActionResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "$defs": {
    "AgentThreadActionResult": {
      "description": "References fixed at the thread action commit, preserved on replay.",
      "type": "object",
      "properties": {
        "executionId": {
          "description": "Execution committed for turnId in threadId by foreground admission.",
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "description": "Task atomically created by the shared detached launch mechanism.",
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "description": "Created conversation or the target conversation of send/start.",
          "type": "string"
        },
        "turnId": {
          "description": "Saved message or admitted turn in threadId. For a detached launch this\nis the parent admission, never the executing child turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "threadId"
      ]
    },
    "AgentPublicOutcome": {
      "description": "Stable, non-disclosing public outcomes for agent domain operations.\nInternal diagnostics may be more precise, but public adapters use only\nthese bounded codes and never turn target failures into an existence oracle.",
      "type": "string",
      "enum": [
        "agent_actor_unavailable",
        "agent_identity_unavailable",
        "agent_identity_revision_stale",
        "agent_execution_stale",
        "agent_execution_profile_unavailable",
        "agent_execution_selection_not_allowed",
        "agent_nickname_unavailable",
        "agent_action_not_allowed",
        "agent_route_required",
        "agent_route_revoked",
        "agent_route_expired",
        "agent_destination_unavailable",
        "agent_context_export_denied",
        "agent_action_conflict",
        "agent_action_already_committed",
        "agent_recovery_quarantined",
        "agent_work_queued",
        "agent_work_queue_full",
        "agent_work_graph_limit_exceeded",
        "agent_action_payload_limit_exceeded",
        "agent_runtime_integrity_lost"
      ]
    },
    "AgentToolResultStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "queued",
        "completed",
        "denied",
        "failed"
      ]
    },
    "AgentToolTargetOption": {
      "description": "Opaque action target projected by the server. Returned navigation IDs do\nnot replace this option or grant authority to write or launch.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    }
  }
}
