{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServerHealthDetails",
  "type": "object",
  "required": [
    "runtime",
    "status"
  ],
  "properties": {
    "catalog_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_retry_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "retry_attempt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "runtime": {
      "$ref": "#/definitions/McpRuntimeStatus"
    },
    "status": {
      "$ref": "#/definitions/McpServerStatus"
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr_tail": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "McpRuntimeState": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    },
    "McpRuntimeStatus": {
      "type": "object",
      "required": [
        "live",
        "state"
      ],
      "properties": {
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "live": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/definitions/McpRuntimeState"
        }
      }
    },
    "McpServerStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    }
  }
}