{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskNotificationContext",
  "type": "object",
  "required": [
    "eventId",
    "sequence",
    "taskId",
    "workspaceId"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "parentTaskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootTaskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": "integer",
      "format": "int64"
    },
    "taskId": {
      "type": "string"
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaceId": {
      "type": "string"
    }
  }
}