{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewaySettingsUpdate",
  "type": "object",
  "properties": {
    "general": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayGeneralSettingsUpdate"
        },
        {
          "type": "null"
        }
      ]
    },
    "memory": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayMemorySettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_episodic": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayThreadEpisodicSettingsUpdate"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "GatewayGeneralSettingsUpdate": {
      "type": "object",
      "properties": {
        "keepawake": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "preflight_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayMemoryModelSelection"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GatewayMemoryModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/GatewayMemoryModelSelectionSource",
          "default": "thread"
        }
      }
    },
    "GatewayMemoryModelSelectionSource": {
      "type": "string",
      "enum": [
        "thread",
        "custom"
      ]
    },
    "GatewayMemorySettings": {
      "type": "object",
      "properties": {
        "active_recall_enabled": {
          "type": "boolean"
        },
        "background_extraction_enabled": {
          "type": "boolean"
        },
        "debug_trace_enabled": {
          "type": "boolean"
        },
        "deterministic_recall_enabled": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "proactive_writes_enabled": {
          "type": "boolean"
        },
        "proactive_writes_model": {
          "$ref": "#/$defs/GatewayMemoryModelSelection",
          "default": {
            "source": "thread"
          }
        },
        "strict_diagnostics_enabled": {
          "type": "boolean"
        },
        "tools_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "deterministic_recall_enabled",
        "active_recall_enabled",
        "tools_enabled",
        "proactive_writes_enabled",
        "background_extraction_enabled",
        "debug_trace_enabled",
        "strict_diagnostics_enabled"
      ]
    },
    "GatewayThreadEpisodicSettingsUpdate": {
      "type": "object",
      "properties": {
        "chunk_max_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "chunk_target_max_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "chunk_target_min_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "default_max_candidates": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "default_prompt_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "index_batch_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "indexing_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "max_candidate_work": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_chunks_per_item": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_hit_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_prompt_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_segments": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "min_relevancy": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "min_results": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "near_capacity_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "recall_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "retry_base_delay_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "retry_max_delay_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "snippet_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  }
}