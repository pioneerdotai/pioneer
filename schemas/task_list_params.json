{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskListParams",
  "type": "object",
  "required": [
    "workspaceId"
  ],
  "properties": {
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "ownerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownerKind": {
      "anyOf": [
        {
          "$ref": "#/definitions/TaskOwnerKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "parentTaskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootTaskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/TaskStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "definitions": {
    "TaskOwnerKind": {
      "type": "string",
      "enum": [
        "user",
        "thread",
        "workspace",
        "system"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "completed",
        "failed",
        "cancelled"
      ]
    }
  }
}