{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskOperatorDeliveries",
  "type": "object",
  "properties": {
    "attempts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskDeliveryAttempt"
      }
    },
    "deliveries": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskDelivery"
      }
    }
  },
  "$defs": {
    "ProviderErrorReason": {
      "description": "Allowlisted OpenRouter Chat Completions metadata.error_type values.\nDiagnostic only: these values must not drive recovery policy.",
      "type": "string",
      "enum": [
        "context_length_exceeded",
        "max_tokens_exceeded",
        "token_limit_exceeded",
        "string_too_long",
        "authentication",
        "permission_denied",
        "payment_required",
        "rate_limit_exceeded",
        "provider_overloaded",
        "provider_unavailable",
        "invalid_request",
        "invalid_prompt",
        "not_found",
        "precondition_failed",
        "payload_too_large",
        "unprocessable",
        "content_policy_violation",
        "refusal",
        "invalid_image",
        "image_too_large",
        "image_too_small",
        "unsupported_image_format",
        "image_not_found",
        "image_download_failed",
        "server",
        "timeout",
        "unmapped"
      ]
    },
    "ProviderFailureClass": {
      "type": "string",
      "enum": [
        "network_transient",
        "rate_limit",
        "provider_5xx",
        "auth_expired",
        "auth_or_permission",
        "model_not_found",
        "prompt_too_long",
        "context_too_large",
        "max_output_tokens",
        "stream_stall",
        "stream_truncated",
        "empty_response",
        "provider_rejected",
        "unsupported_parameter",
        "unsupported_capability",
        "unsupported_image_input",
        "unsupported_tool_calling",
        "unsupported_streaming",
        "malformed_provider_request",
        "invalid_request",
        "permission_denied",
        "unknown"
      ]
    },
    "ProviderFailureStage": {
      "type": "string",
      "enum": [
        "connect",
        "first_chunk",
        "mid_stream",
        "finalize"
      ]
    },
    "ProviderRequestId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(gen-|req-|cmpl-|chatcmpl-)[A-Za-z0-9_-]+$"
    },
    "ProviderTransportKind": {
      "type": "string",
      "enum": [
        "stream",
        "non_stream",
        "ws",
        "sse"
      ]
    },
    "RecoveryDiagnostic": {
      "type": "object",
      "properties": {
        "lastFailure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryProviderFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "stopReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryStopReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RecoveryProviderFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ProviderFailureClass"
        },
        "errorReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderErrorReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "requestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryAfterMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "stage": {
          "$ref": "#/$defs/ProviderFailureStage"
        },
        "transport": {
          "$ref": "#/$defs/ProviderTransportKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "stage",
        "transport"
      ]
    },
    "RecoveryStopReason": {
      "type": "string",
      "enum": [
        "attempts_exhausted",
        "wall_clock_exhausted",
        "no_progress",
        "policy_rejected",
        "terminal_failure"
      ]
    },
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskDelivery": {
      "type": "object",
      "properties": {
        "attemptCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deliveredAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "deliveredNotificationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveredTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveryKey": {
          "type": "string"
        },
        "errorSnapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxAttempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskDeliveryMode"
        },
        "nextAttemptAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "resultSnapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskDeliveryStatus"
        },
        "targetThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": "string"
        },
        "threadTarget": {
          "description": "Immutable semantic target captured when a thread delivery is created.",
          "anyOf": [
            {
              "$ref": "#/$defs/TaskDeliveryThreadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "webhookUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "webhookUrlFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "taskId",
        "runId",
        "deliveryKey",
        "mode",
        "status",
        "attemptCount",
        "maxAttempts",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskDeliveryAttempt": {
      "type": "object",
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "deliveryId": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "responseFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskDeliveryAttemptStatus"
        }
      },
      "required": [
        "id",
        "deliveryId",
        "attemptNumber",
        "status",
        "startedAt"
      ]
    },
    "TaskDeliveryAttemptStatus": {
      "type": "string",
      "enum": [
        "started",
        "delivered",
        "failed"
      ]
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "thread",
        "user_notification",
        "webhook"
      ]
    },
    "TaskDeliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "delivering",
        "delivered",
        "failed",
        "cancelled"
      ]
    },
    "TaskDeliveryThreadTarget": {
      "description": "Semantic thread target resolved and persisted by Gateway.",
      "type": "string",
      "enum": [
        "origin_thread",
        "current_thread",
        "collaboration_root",
        "exact_thread"
      ]
    },
    "TaskError": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "recoveryDiagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "class"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}