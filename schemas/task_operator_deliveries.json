{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskOperatorDeliveries",
  "type": "object",
  "properties": {
    "attempts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskDeliveryAttempt"
      }
    },
    "deliveries": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskDelivery"
      }
    }
  },
  "$defs": {
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskDelivery": {
      "type": "object",
      "properties": {
        "attemptCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deliveredAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "deliveredNotificationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveredTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveryKey": {
          "type": "string"
        },
        "errorSnapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxAttempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskDeliveryMode"
        },
        "nextAttemptAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "resultSnapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskDeliveryStatus"
        },
        "targetThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": "string"
        },
        "threadTarget": {
          "description": "Immutable semantic target captured when a thread delivery is created.",
          "anyOf": [
            {
              "$ref": "#/$defs/TaskDeliveryThreadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "webhookUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "webhookUrlFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "taskId",
        "runId",
        "deliveryKey",
        "mode",
        "status",
        "attemptCount",
        "maxAttempts",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskDeliveryAttempt": {
      "type": "object",
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "deliveryId": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "responseFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskDeliveryAttemptStatus"
        }
      },
      "required": [
        "id",
        "deliveryId",
        "attemptNumber",
        "status",
        "startedAt"
      ]
    },
    "TaskDeliveryAttemptStatus": {
      "type": "string",
      "enum": [
        "started",
        "delivered",
        "failed"
      ]
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "thread",
        "user_notification",
        "webhook"
      ]
    },
    "TaskDeliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "delivering",
        "delivered",
        "failed",
        "cancelled"
      ]
    },
    "TaskDeliveryThreadTarget": {
      "description": "Semantic thread target resolved and persisted by Gateway.",
      "type": "string",
      "enum": [
        "origin_thread",
        "current_thread",
        "collaboration_root",
        "exact_thread"
      ]
    },
    "TaskError": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "class"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}