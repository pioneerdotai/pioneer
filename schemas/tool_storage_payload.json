{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolStoragePayload",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "aggregated_output": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "kind": {
          "type": "string",
          "const": "shell"
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ]
        },
        "timed_out": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "truncated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "summary"
        }
      },
      "$ref": "#/$defs/ToolOutputSummary",
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "metadata"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ToolMetadataValue"
          }
        }
      },
      "required": [
        "kind",
        "metadata"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "none"
        }
      },
      "required": [
        "kind"
      ]
    }
  ],
  "$defs": {
    "ToolMetadataRawKind": {
      "type": "string",
      "enum": [
        "content",
        "body",
        "blob",
        "base64",
        "bytes",
        "data",
        "html",
        "image",
        "output",
        "screenshot",
        "stdout",
        "stderr",
        "text",
        "unknown"
      ]
    },
    "ToolMetadataValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "array"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolMetadataValue"
              }
            }
          },
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ToolMetadataValue"
              }
            },
            "kind": {
              "type": "string",
              "const": "object"
            }
          },
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "redacted_raw"
            },
            "raw_kind": {
              "$ref": "#/$defs/ToolMetadataRawKind"
            },
            "sha256": {
              "type": "string"
            },
            "value_kind": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "raw_kind",
            "sha256",
            "bytes",
            "value_kind"
          ]
        }
      ]
    },
    "ToolOutputSummary": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ToolMetadataValue"
          }
        },
        "title": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "metadata",
        "truncated"
      ]
    }
  }
}