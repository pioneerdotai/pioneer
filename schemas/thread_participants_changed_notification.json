{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadParticipantsChangedNotification",
  "type": "object",
  "properties": {
    "change": {
      "$ref": "#/$defs/ThreadParticipantChangeKind"
    },
    "principal_id": {
      "$ref": "#/$defs/PrincipalId"
    },
    "thread_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "change",
    "principal_id"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ThreadParticipantChangeKind": {
      "type": "string",
      "enum": [
        "added",
        "removed"
      ]
    }
  }
}