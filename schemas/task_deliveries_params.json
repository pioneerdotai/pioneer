{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskDeliveriesParams",
  "type": "object",
  "properties": {
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "statuses": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskDeliveryStatus"
      }
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "workspaceId"
  ],
  "$defs": {
    "TaskDeliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "delivering",
        "delivered",
        "failed",
        "cancelled"
      ]
    }
  }
}