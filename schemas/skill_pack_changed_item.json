{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillPackChangedItem",
  "type": "object",
  "properties": {
    "change_type": {
      "type": "string"
    },
    "name_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "name_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "pack_id": {
      "$ref": "#/$defs/SkillPackId"
    }
  },
  "required": [
    "pack_id",
    "change_type"
  ],
  "$defs": {
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}