{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemRecoveryOpenedNotification",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/RecoveryAction"
    },
    "attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "recovery_job_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/RecoveryTrigger"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "item_type",
    "recovery_job_id",
    "trigger",
    "action",
    "attempt_number"
  ],
  "$defs": {
    "RecoveryAction": {
      "type": "string",
      "enum": [
        "retry_attempt",
        "retry_with_backoff",
        "restart_turn",
        "replay_durable_event",
        "rehydrate_turn_state",
        "open_next_execution_window",
        "adapt_provider_request",
        "refresh_provider_auth",
        "compact_history",
        "disable_streaming",
        "disable_unsupported_capability",
        "repair_artifact_finalization",
        "requeue_task_dispatch",
        "block_resumable",
        "fallback",
        "mark_failed"
      ]
    },
    "RecoveryTrigger": {
      "oneOf": [
        {
          "description": "Turn-item execution exceeded timeout policy (start/idle/hard/lease).",
          "type": "string",
          "const": "timeout"
        },
        {
          "description": "Any provider/model/transport failure in LLM interaction path.",
          "type": "string",
          "const": "provider_error"
        },
        {
          "description": "Turn runtime could not be prepared after the turn was persisted.",
          "type": "string",
          "const": "turn_start"
        },
        {
          "description": "Turn could not be dispatched to the agent runtime.",
          "type": "string",
          "const": "turn_dispatch"
        },
        {
          "description": "A durable event could not be projected/materialized.",
          "type": "string",
          "const": "projection_failure"
        },
        {
          "description": "A same-turn execution window continuation could not be opened directly.",
          "type": "string",
          "const": "execution_window_continuation"
        },
        {
          "description": "Final artifact validation/registration failed after model output.",
          "type": "string",
          "const": "artifact_finalization"
        },
        {
          "description": "Child/reviewer/revision task turn dispatch failed.",
          "type": "string",
          "const": "task_dispatch"
        },
        {
          "description": "Generic runtime failure routed through the central terminal decision gate.",
          "type": "string",
          "const": "runtime_failure"
        },
        {
          "description": "Forward-compatibility fallback for unknown persisted values.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}