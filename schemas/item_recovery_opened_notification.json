{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemRecoveryOpenedNotification",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/RecoveryAction"
    },
    "attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "recovery_job_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/RecoveryTrigger"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "item_type",
    "recovery_job_id",
    "trigger",
    "action",
    "attempt_number"
  ],
  "$defs": {
    "RecoveryAction": {
      "type": "string",
      "enum": [
        "retry_attempt",
        "retry_with_backoff",
        "restart_turn",
        "fallback",
        "mark_failed"
      ]
    },
    "RecoveryTrigger": {
      "oneOf": [
        {
          "description": "Turn-item execution exceeded timeout policy (start/idle/hard/lease).",
          "type": "string",
          "const": "timeout"
        },
        {
          "description": "Any provider/model/transport failure in LLM interaction path.",
          "type": "string",
          "const": "provider_error"
        },
        {
          "description": "Forward-compatibility fallback for unknown persisted values.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}