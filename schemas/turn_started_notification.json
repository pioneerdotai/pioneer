{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStartedNotification",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "turn": {
      "$ref": "#/$defs/Turn"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn"
  ],
  "$defs": {
    "PromptManifest": {
      "type": "object",
      "properties": {
        "compiler_version": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptManifestDiagnostic"
          }
        },
        "fingerprint_dynamic": {
          "type": "string"
        },
        "fingerprint_full": {
          "type": "string"
        },
        "fingerprint_stable": {
          "type": "string"
        },
        "hook_sources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptManifestHookSourceEntry"
          }
        },
        "profile": {
          "$ref": "#/$defs/PromptManifestProfile"
        },
        "section_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "compiler_version",
        "profile",
        "fingerprint_stable",
        "fingerprint_dynamic",
        "fingerprint_full"
      ]
    },
    "PromptManifestDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PromptManifestDiagnosticCode"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptManifestHookSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "PromptManifestDiagnosticCode": {
      "type": "string",
      "enum": [
        "missing_file",
        "file_read_error",
        "file_truncated",
        "total_budget_truncated",
        "file_filtered_by_profile",
        "dynamic_section_truncated",
        "dynamic_section_omitted",
        "hook_diagnostic",
        "hook_best_effort_failed"
      ]
    },
    "PromptManifestHookContributionKind": {
      "type": "string",
      "enum": [
        "prompt_context",
        "prompt_section",
        "prompt_manifest_diagnostic",
        "runtime_failure"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_context",
        "turn_post_preflight_prompt_context",
        "turn_pre_prompt_compile"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "hook_id",
        "subscription_id",
        "phase"
      ]
    },
    "PromptManifestHookSourceEntry": {
      "type": "object",
      "properties": {
        "contribution_kind": {
          "$ref": "#/$defs/PromptManifestHookContributionKind"
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/PromptManifestHookSource"
        },
        "source_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "truncation": {
          "$ref": "#/$defs/PromptManifestHookTruncation"
        }
      },
      "required": [
        "source",
        "contribution_kind",
        "truncation"
      ]
    },
    "PromptManifestHookTruncation": {
      "type": "string",
      "enum": [
        "none",
        "hook",
        "prompt",
        "hook_and_prompt",
        "unknown"
      ]
    },
    "PromptManifestProfile": {
      "type": "string",
      "enum": [
        "assistant_full",
        "assistant_minimal",
        "assistant_none"
      ]
    },
    "Turn": {
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/TurnOrigin",
          "default": "user"
        },
        "prompt_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "turn_kind": {
          "$ref": "#/$defs/TurnKind",
          "default": "conversation"
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "TurnKind": {
      "type": "string",
      "enum": [
        "conversation",
        "task_run"
      ]
    },
    "TurnOrigin": {
      "type": "string",
      "enum": [
        "user",
        "scheduled_task",
        "detached_task",
        "attached_task"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "InProgress",
        "Completed",
        "Failed",
        "Interrupted"
      ]
    }
  }
}