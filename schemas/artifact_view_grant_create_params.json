{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactViewGrantCreateParams",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "disposition": {
      "$ref": "#/$defs/ArtifactViewGrantDisposition"
    },
    "projection_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "version_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "workspace_id",
    "artifact_id",
    "version_id",
    "disposition"
  ],
  "$defs": {
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactViewGrantDisposition": {
      "type": "string",
      "enum": [
        "inline",
        "attachment"
      ]
    }
  }
}