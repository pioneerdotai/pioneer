{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnPermissionAuditEvent",
  "type": "object",
  "properties": {
    "actionKind": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionActionKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "cached": {
      "type": "boolean"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionAuditDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventKind": {
      "$ref": "#/$defs/TurnPermissionAuditEventKind"
    },
    "itemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "profileMode": {
      "$ref": "#/$defs/TurnPermissionMode"
    },
    "profileSource": {
      "$ref": "#/$defs/TurnPermissionProfileSource"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionDecisionReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestKey": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionAuditRequestKey"
        },
        {
          "type": "null"
        }
      ]
    },
    "securityCapability": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnSecurityCapabilityKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "securityReasonCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "securitySnapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "securitySnapshotVersion": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "threadId": {
      "type": "string"
    },
    "toolCallId": {
      "type": [
        "string",
        "null"
      ]
    },
    "toolName": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "workspaceId",
    "threadId",
    "turnId",
    "eventKind",
    "profileMode",
    "profileSource"
  ],
  "$defs": {
    "TurnPermissionActionKind": {
      "type": "string",
      "enum": [
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent",
        "internal",
        "unknown"
      ]
    },
    "TurnPermissionAuditDecision": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny",
        "allow_once",
        "allow_for_turn",
        "cancelled",
        "expired"
      ]
    },
    "TurnPermissionAuditEventKind": {
      "type": "string",
      "enum": [
        "profile_selected",
        "security_snapshot_resolved",
        "security_sandbox_degraded",
        "security_sandbox_unavailable",
        "approval_requested",
        "approval_resolved",
        "decision_allowed",
        "decision_denied"
      ]
    },
    "TurnPermissionAuditRequestKey": {
      "type": "object",
      "properties": {
        "actionKind": {
          "$ref": "#/$defs/TurnPermissionActionKind"
        },
        "scopeHash": {
          "type": "string"
        }
      },
      "required": [
        "actionKind",
        "scopeHash"
      ]
    },
    "TurnPermissionDecisionReason": {
      "type": "string",
      "enum": [
        "full_access",
        "policy_allows_action",
        "policy_requires_approval",
        "policy_denies_action",
        "cached_approval",
        "user_approved",
        "user_denied",
        "cancelled",
        "expired",
        "unknown_action_default",
        "sandbox_denied"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSource": {
      "type": "string",
      "enum": [
        "composer",
        "defaulted",
        "inherited_from_parent_turn",
        "task_permission_cap",
        "system"
      ]
    },
    "TurnSecurityCapabilityKind": {
      "type": "string",
      "enum": [
        "filesystem",
        "network",
        "process",
        "approval",
        "sandbox_backend"
      ]
    }
  }
}