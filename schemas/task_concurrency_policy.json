{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskConcurrencyPolicy",
  "type": "object",
  "properties": {
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "maxParallelRuns": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "onConflict": {
      "$ref": "#/$defs/TaskConcurrencyConflictPolicy"
    }
  },
  "required": [
    "maxParallelRuns",
    "onConflict"
  ],
  "$defs": {
    "TaskConcurrencyConflictPolicy": {
      "type": "string",
      "enum": [
        "queue",
        "reject",
        "cancel_existing",
        "allow"
      ]
    }
  }
}