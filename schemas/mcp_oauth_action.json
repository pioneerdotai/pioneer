{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpOAuthAction",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "sign_in"
        },
        "redirect_uri": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "redirect_uri"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "disconnect"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "flow_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "cancel"
        }
      },
      "required": [
        "kind",
        "flow_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "flow_id": {
          "type": "string"
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "callback"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "flow_id",
        "state"
      ]
    }
  ]
}