{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayVoiceInputSettings",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayVoiceInputProvider"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime": {
      "$ref": "#/$defs/GatewayVoiceInputRuntimeSnapshot",
      "default": {
        "effective_enabled": false,
        "phase": "disabled"
      }
    }
  },
  "$defs": {
    "GatewayVoiceInputProvider": {
      "type": "string",
      "enum": [
        "local"
      ]
    },
    "GatewayVoiceInputRuntimePhase": {
      "type": "string",
      "enum": [
        "disabled",
        "model_not_selected",
        "missing",
        "downloading",
        "installing",
        "loading",
        "ready",
        "failed"
      ]
    },
    "GatewayVoiceInputRuntimeSnapshot": {
      "type": "object",
      "properties": {
        "downloaded_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "effective_enabled": {
          "type": "boolean",
          "default": false
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/GatewayVoiceInputRuntimePhase",
          "default": "disabled"
        },
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    }
  }
}