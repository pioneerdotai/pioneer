{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnExecutionWindowExhaustedNotification",
  "type": "object",
  "properties": {
    "agent_round_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "exhausted_at_unix_ms": {
      "type": "integer",
      "format": "int64"
    },
    "exhaustion_reason": {
      "$ref": "#/$defs/ExecutionWindowExhaustionReason"
    },
    "limit": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "observed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "provider_token_count": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    },
    "started_at_unix_ms": {
      "type": "integer",
      "format": "int64"
    },
    "status": {
      "$ref": "#/$defs/ExecutionWindowStatus"
    },
    "thread_id": {
      "type": "string"
    },
    "tool_call_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "turn_id": {
      "type": "string"
    },
    "window_id": {
      "type": "string"
    },
    "window_index": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "window_id",
    "window_index",
    "status",
    "exhaustion_reason",
    "limit",
    "observed",
    "agent_round_count",
    "tool_call_count",
    "started_at_unix_ms",
    "exhausted_at_unix_ms",
    "reason"
  ],
  "$defs": {
    "ExecutionWindowExhaustionReason": {
      "type": "string",
      "enum": [
        "max_agent_rounds_per_window",
        "max_tool_calls_per_window",
        "max_wall_clock_ms_per_window",
        "max_provider_tokens_per_window",
        "provider_failure_continuation",
        "runtime_shutdown_continuation"
      ]
    },
    "ExecutionWindowStatus": {
      "type": "string",
      "enum": [
        "running",
        "exhausted",
        "checkpointed",
        "continued",
        "completed",
        "interrupted",
        "blocked",
        "failed"
      ]
    }
  }
}