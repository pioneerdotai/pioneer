{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLIRuntimeAppsChangedNotification",
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuntimeAppInfo"
      }
    },
    "refreshed_at_unix_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "runtime_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "runtime_id",
    "apps"
  ],
  "$defs": {
    "RuntimeAppInfo": {
      "type": "object",
      "properties": {
        "account_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "payload": true,
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}