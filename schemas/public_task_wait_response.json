{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskWaitResponse",
  "type": "object",
  "properties": {
    "blocked": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitItem"
      }
    },
    "blockedCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "cancelled": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitItem"
      }
    },
    "completed": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitItem"
      }
    },
    "failed": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitItem"
      }
    },
    "mode": {
      "$ref": "#/$defs/TaskWaitMode"
    },
    "nonWaitable": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitNonWaitableItem"
      }
    },
    "nonWaitableCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "pending": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitItem"
      }
    },
    "pendingCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "reviewRequired": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTaskWaitReviewItem"
      }
    },
    "reviewRequiredCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "terminalCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "timedOut": {
      "type": "boolean"
    },
    "totalCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "timedOut",
    "totalCount",
    "terminalCount",
    "pendingCount",
    "reviewRequiredCount",
    "blockedCount",
    "nonWaitableCount",
    "mode"
  ],
  "$defs": {
    "PublicError": {
      "description": "Stable, bounded failure presentation shared by RPC, voice and task\nexecution surfaces. Raw source chains are never part of this type.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PublicErrorCode"
        },
        "correlation_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PublicErrorStage"
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "code",
        "stage",
        "message",
        "retryable",
        "correlation_id"
      ]
    },
    "PublicErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "policy_denied",
        "not_found",
        "conflict",
        "resource_exhausted",
        "unavailable",
        "timeout",
        "internal"
      ]
    },
    "PublicErrorStage": {
      "type": "string",
      "enum": [
        "discovery",
        "admission",
        "preparation",
        "execution",
        "persistence",
        "delivery",
        "observation"
      ]
    },
    "PublicTask": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "createdByThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdByTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "goal": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ownerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerKind": {
          "$ref": "#/$defs/TaskOwnerKind"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer",
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerKind",
        "executorKind",
        "status",
        "title",
        "goal",
        "priority",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "error": {
          "$ref": "#/$defs/PublicError"
        }
      },
      "required": [
        "class",
        "error"
      ]
    },
    "PublicTaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicTaskArtifact"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskResultCandidate": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "round": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskResultCandidateStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "runId",
        "round",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskRun": {
      "type": "object",
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "runNumber": {
          "type": "integer",
          "format": "int64"
        },
        "startedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskRunStatus"
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "attemptNumber",
        "runNumber",
        "status",
        "executorKind",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskWaitItem": {
      "type": "object",
      "properties": {
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "$ref": "#/$defs/PublicTask"
        }
      },
      "required": [
        "task"
      ]
    },
    "PublicTaskWaitNonWaitableItem": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/PublicTaskWaitItem"
        },
        "nextFireAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "reason": {
          "$ref": "#/$defs/TaskWaitNonWaitableReason"
        }
      },
      "required": [
        "item",
        "reason"
      ]
    },
    "PublicTaskWaitReviewItem": {
      "type": "object",
      "properties": {
        "allowedActions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskWaitReviewAction"
          }
        },
        "candidate": {
          "$ref": "#/$defs/PublicTaskResultCandidate"
        },
        "item": {
          "$ref": "#/$defs/PublicTaskWaitItem"
        },
        "remainingRevisionRounds": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "revisionBlockedReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskWaitRevisionBlockedReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item",
        "candidate"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskOwnerKind": {
      "type": "string",
      "enum": [
        "user",
        "thread",
        "workspace",
        "system"
      ]
    },
    "TaskResultCandidateStatus": {
      "type": "string",
      "enum": [
        "pending_review",
        "accepted",
        "rejected",
        "superseded",
        "extraction_failed",
        "cancelled"
      ]
    },
    "TaskRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "waiting",
        "waiting_review",
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "timed_out"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "waiting_review",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "TaskWaitMode": {
      "type": "string",
      "enum": [
        "all_terminal",
        "any_terminal",
        "all_terminal_or_review_required",
        "any_terminal_or_review_required"
      ]
    },
    "TaskWaitNonWaitableReason": {
      "type": "string",
      "enum": [
        "future_scheduled_task_without_active_run"
      ]
    },
    "TaskWaitReviewAction": {
      "type": "string",
      "enum": [
        "task_accept",
        "task_revise",
        "task_cancel"
      ]
    },
    "TaskWaitRevisionBlockedReason": {
      "type": "string",
      "enum": [
        "max_revision_rounds_reached",
        "candidate_not_revisable"
      ]
    }
  }
}