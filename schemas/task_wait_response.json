        },
        "item": {
          "$ref": "#/$defs/TaskWaitItem"
        },
        "maxRevisionRounds": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "remainingRevisionRounds": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "reviewPolicy": {
