    "TaskWaitNonWaitableReason": {
      "type": "string",
      "enum": [
        "future_scheduled_task_without_active_run"
      ]
    },
    "TaskWaitReviewAction": {
      "type": "string",
      "enum": [
        "task_accept",
        "task_revise",
        "task_cancel"
      ]
    },
    "TaskWaitReviewItem": {
      "type": "object",
      "properties": {
        "allowedActions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskWaitReviewAction"
          }
        },
        "candidate": {
