{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsHealthParams",
  "type": "object",
  "properties": {
    "audit_limit": {
      "type": "integer",
      "format": "uint64",
      "default": 16,
      "minimum": 0
    },
    "skills": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillHealthTarget"
      }
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id"
  ],
  "$defs": {
    "SkillHealthTarget": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "source_kind"
      ]
    }
  }
}