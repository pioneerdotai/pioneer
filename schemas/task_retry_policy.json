{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskRetryPolicy",
  "type": "object",
  "properties": {
    "backoff": {
      "$ref": "#/$defs/TaskRetryBackoffKind"
    },
    "initialDelaySeconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "maxAttempts": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "maxDelaySeconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "retryOn": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskErrorClass"
      }
    }
  },
  "required": [
    "maxAttempts",
    "backoff"
  ],
  "$defs": {
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskRetryBackoffKind": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "exponential"
      ]
    }
  }
}