{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderListResponse",
  "type": "object",
  "properties": {
    "definitions": {
      "description": "Gateway-owned endpoint definitions, including providers without credentials.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderDefinition"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderSummary"
      }
    }
  },
  "required": [
    "providers"
  ],
  "$defs": {
    "ProviderDefinition": {
      "type": "object",
      "properties": {
        "default_base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "supports_base_url_override": {
          "type": "boolean",
          "default": false
        },
        "retirement_reason": {
          "description": "Terminal product lifecycle diagnostic; old clients can ignore it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "api_key_configured": {
          "type": "boolean"
        },
        "available": {
          "description": "The gateway can construct this provider in the selected workspace.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderSummaryCapabilities",
          "default": {
            "embeddings": false,
            "self_improvement": false,
            "transcription": false
          }
        },
        "name": {
          "type": "string"
        },
        "proxy_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderSummaryCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": "boolean",
          "default": false
        },
        "self_improvement": {
          "description": "Gateway-authoritative eligibility for the API-only self-improvement\nmodel selectors.",
          "type": "boolean",
          "default": false
        },
        "transcription": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}