{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderListResponse",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderSummary"
      }
    }
  },
  "required": [
    "providers"
  ],
  "$defs": {
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "api_key_configured": {
          "type": "boolean"
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderSummaryCapabilities",
          "default": {
            "embeddings": false,
            "self_improvement": false,
            "transcription": false
          }
        },
        "name": {
          "type": "string"
        },
        "proxy_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderSummaryCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": "boolean",
          "default": false
        },
        "self_improvement": {
          "description": "Gateway-authoritative eligibility for the API-only self-improvement\nmodel selectors.",
          "type": "boolean",
          "default": false
        },
        "transcription": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}