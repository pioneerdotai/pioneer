{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayGeneralSettings",
  "type": "object",
  "properties": {
    "compaction_model": {
      "$ref": "#/$defs/GatewayModelSelection",
      "default": {
        "source": "inherit"
      }
    },
    "keepawake": {
      "type": "boolean",
      "default": false
    },
    "model_catalog": {
      "$ref": "#/$defs/GatewayModelCatalogSettings",
      "default": {
        "catalog_available": false,
        "proxy_configured": false
      }
    },
    "preflight_model": {
      "$ref": "#/$defs/GatewayMemoryModelSelection",
      "default": {
        "source": "thread"
      }
    },
    "telemetry_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "GatewayMemoryModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/GatewayMemoryModelSelectionSource",
          "default": "thread"
        }
      }
    },
    "GatewayMemoryModelSelectionSource": {
      "type": "string",
      "enum": [
        "thread",
        "custom"
      ]
    },
    "GatewayModelCatalogSettings": {
      "type": "object",
      "properties": {
        "catalog_available": {
          "type": "boolean",
          "default": false
        },
        "proxy_configured": {
          "type": "boolean",
          "default": false
        },
        "proxy_url": {
          "description": "Credential-free display URL. Userinfo, query, and fragment are removed.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GatewayModelSelection": {
      "description": "Inherit is a real absence of an override. It never stores a resolved fallback.\nThe tagged value also distinguishes an explicit reset from an omitted update.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "instance": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "reasoning_effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "const": "explicit"
            },
            "transport": {
              "$ref": "#/$defs/ModelSelectionTransport"
            }
          },
          "additionalProperties": false,
          "required": [
            "source",
            "transport",
            "instance",
            "model"
          ]
        }
      ]
    },
    "ModelSelectionTransport": {
      "type": "string",
      "enum": [
        "api",
        "codex",
        "claude"
      ]
    }
  }
}