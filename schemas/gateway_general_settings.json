{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayGeneralSettings",
  "type": "object",
  "properties": {
    "keepawake": {
      "type": "boolean",
      "default": false
    },
    "preflight_model": {
      "$ref": "#/$defs/GatewayMemoryModelSelection",
      "default": {
        "source": "thread"
      }
    },
    "telemetry_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "GatewayMemoryModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/GatewayMemoryModelSelectionSource",
          "default": "thread"
        }
      }
    },
    "GatewayMemoryModelSelectionSource": {
      "type": "string",
      "enum": [
        "thread",
        "custom"
      ]
    }
  }
}