{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpListItem",
  "type": "object",
  "properties": {
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/McpPolicyState"
    },
    "prompts_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "required": {
      "type": "boolean"
    },
    "resource_templates_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "resources_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "runtime": {
      "$ref": "#/$defs/McpRuntimeStatus"
    },
    "scope": {
      "$ref": "#/$defs/McpScopeKind"
    },
    "status": {
      "$ref": "#/$defs/McpServerStatus"
    },
    "tools_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "name",
    "scope",
    "policy",
    "required",
    "runtime",
    "tools_count",
    "resources_count",
    "resource_templates_count",
    "prompts_count",
    "status"
  ],
  "$defs": {
    "McpPolicyState": {
      "type": "object",
      "properties": {
        "allow_implicit_invocation": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "allow_implicit_invocation"
      ]
    },
    "McpRuntimeState": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    },
    "McpRuntimeStatus": {
      "type": "object",
      "properties": {
        "last_seen_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "live": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/McpRuntimeState"
        }
      },
      "required": [
        "state",
        "live"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "McpServerStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    }
  }
}