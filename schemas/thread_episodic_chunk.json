{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadEpisodicChunk",
  "type": "object",
  "properties": {
    "byte_end": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "byte_start": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "char_start": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "provenance": {
      "$ref": "#/$defs/ThreadEpisodicSourceProvenance"
    },
    "source_text_hash": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ThreadEpisodicChunkStatus"
    },
    "text_hash": {
      "type": "string"
    },
    "token_estimate": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "visibility": {
      "$ref": "#/$defs/ThreadEpisodicVisibility"
    }
  },
  "required": [
    "provenance",
    "status",
    "visibility",
    "text_hash",
    "source_text_hash",
    "char_start",
    "char_end",
    "byte_start",
    "byte_end",
    "token_estimate"
  ],
  "$defs": {
    "ThreadEpisodicChunkStatus": {
      "type": "string",
      "enum": [
        "pending_index",
        "indexed",
        "active",
        "index_failed",
        "deleted",
        "excluded",
        "unknown"
      ]
    },
    "ThreadEpisodicSourceActorRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool_summary",
        "task_summary",
        "generated_summary"
      ]
    },
    "ThreadEpisodicSourceContext": {
      "type": "string",
      "enum": [
        "user_visible_thread_item",
        "user_visible_tool_summary",
        "user_visible_task_summary",
        "thread_compaction_summary",
        "hidden_prompt",
        "reasoning_trace",
        "raw_tool_output",
        "raw_task_runtime",
        "internal_hook_runtime",
        "system_prompt",
        "developer_prompt",
        "unknown"
      ]
    },
    "ThreadEpisodicSourceProvenance": {
      "description": "Evidence pointer for a thread episodic chunk.\n\nThis is not a durable-memory identity. It points to where recalled\nconversation context came from so later layers can filter, debug, rebuild,\nand cite the exact source chunk without reusing durable memory record ids.",
      "type": "object",
      "properties": {
        "chunk_id": {
          "type": "string"
        },
        "chunk_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "created_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "item_id": {
          "type": "string"
        },
        "source_actor_role": {
          "$ref": "#/$defs/ThreadEpisodicSourceActorRole"
        },
        "source_context": {
          "$ref": "#/$defs/ThreadEpisodicSourceContext"
        },
        "source_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "workspace_id",
        "thread_id",
        "turn_id",
        "item_id",
        "chunk_id",
        "chunk_index",
        "source_actor_role",
        "source_context"
      ]
    },
    "ThreadEpisodicVisibility": {
      "type": "string",
      "enum": [
        "user_visible",
        "hidden",
        "internal",
        "unknown"
      ]
    }
  }
}