        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
