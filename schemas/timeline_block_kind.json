{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineBlockKind",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserMessageAttachment"
          }
        },
        "inputs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/UserInput"
          }
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "user_message"
        },
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "turn_work"
        },
        "work": {
          "$ref": "#/$defs/TurnWorkBlock"
        }
      },
      "required": [
        "kind",
        "work"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "detached_task_run"
        },
        "task": {
          "$ref": "#/$defs/TaskTurnItem"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "assistant_message"
        },
        "markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkdownDocument"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TurnWorkItemStatus",
          "default": "completed"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "itemId",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "turn_state"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/TurnWorkState"
        }
      },
      "required": [
        "kind",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "pending_request"
        },
        "request": {
          "$ref": "#/$defs/CLIRuntimePendingRequest"
        },
        "requestId": {
          "type": "string"
        },
        "runtimeId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CLIRuntimePendingRequestStatus"
        }
      },
      "required": [
        "kind",
        "runtimeId",
        "requestId",
        "status",
        "request"
      ]
    }
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
