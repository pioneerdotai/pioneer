{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryListParams",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryCategory"
      }
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryScope"
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryStatus"
      }
    }
  },
  "$defs": {
    "MemoryCategory": {
      "type": "string",
      "enum": [
        "identity",
        "preference",
        "biography",
        "relationship",
        "recurring_instruction",
        "project_policy",
        "project_fact",
        "project_decision",
        "procedure",
        "todo",
        "constraint",
        "communication_style",
        "custom"
      ]
    },
    "MemoryScope": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryScopeKind"
        }
      },
      "required": [
        "kind",
        "key"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    },
    "MemoryStatus": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "deleted",
        "expired"
      ]
    }
  }
}