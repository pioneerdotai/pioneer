{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPauseResponse",
  "type": "object",
  "properties": {
    "task": {
      "$ref": "#/$defs/Task"
    },
    "triggers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskTrigger"
      }
    }
  },
  "required": [
    "task"
  ],
  "$defs": {
    "AgentExecutionBackend": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "apiProvider"
            }
          },
          "required": [
            "type",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "runtime_kind": {
              "$ref": "#/$defs/CLIAgentRuntimeKind"
            },
            "type": {
              "type": "string",
              "const": "cliAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id",
            "runtime_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "acpAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id"
          ]
        }
      ]
    },
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SandboxMode": {
      "type": "string",
      "enum": [
        "FullAccess"
      ]
    },
    "SandboxPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/SandboxMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "Task": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "concurrencyPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskConcurrencyPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "createdByThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdByTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveryPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskDeliveryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "goal": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lifecyclePolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskLifecyclePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerKind": {
          "$ref": "#/$defs/TaskOwnerKind"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer",
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRetryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "timeoutPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskTimeoutPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerKind",
        "executorKind",
        "status",
        "title",
        "goal",
        "priority",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAttachmentMode": {
      "type": "string",
      "enum": [
        "attached",
        "detached"
      ]
    },
    "TaskCompletionBehavior": {
      "type": "string",
      "enum": [
        "complete_on_terminal_run",
        "keep_active_for_recurring",
        "manual"
      ]
    },
    "TaskComposerWork": {
      "type": "object",
      "properties": {
        "launch": {
          "$ref": "#/$defs/TurnStartParams"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "launch"
      ]
    },
    "TaskConcurrencyConflictPolicy": {
      "type": "string",
      "enum": [
        "queue",
        "reject",
        "cancel_existing",
        "allow"
      ]
    },
    "TaskConcurrencyPolicy": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxParallelRuns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "onConflict": {
          "$ref": "#/$defs/TaskConcurrencyConflictPolicy"
        }
      },
      "required": [
        "maxParallelRuns",
        "onConflict"
      ]
    },
    "TaskDeliveryFormat": {
      "type": "string",
      "enum": [
        "summary",
        "full_result"
      ]
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "thread",
        "user_notification",
        "webhook"
      ]
    },
    "TaskDeliveryPolicy": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TaskDeliveryFormat"
        },
        "includeResult": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/TaskDeliveryMode"
        },
        "threadId": {
          "description": "Canonical target persisted by Gateway. Callers provide this only for\n`ExactThread`; for semantic targets it is server-owned output.",
          "type": [
            "string",
            "null"
          ]
        },
        "threadTarget": {
          "description": "Required for `Thread` delivery. Gateway resolves semantic targets to a\ncanonical `thread_id` before persisting the Task.",
          "anyOf": [
            {
              "$ref": "#/$defs/TaskDeliveryThreadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "webhookUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "includeResult",
        "format"
      ]
    },
    "TaskDeliveryThreadTarget": {
      "description": "Semantic thread target resolved and persisted by Gateway.",
      "type": "string",
      "enum": [
        "origin_thread",
        "current_thread",
        "collaboration_root",
        "exact_thread"
      ]
    },
    "TaskDependencyTriggerMode": {
      "type": "string",
      "enum": [
        "all_succeeded",
        "any_succeeded",
        "all_terminal"
      ]
    },
    "TaskDependencyTriggerPolicy": {
      "type": "object",
      "properties": {
        "dependsOnTaskIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/TaskDependencyTriggerMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TaskError": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "class"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskExternalTriggerFilter": {
      "type": "object",
      "properties": {
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TaskValue"
          },
          "default": {}
        }
      }
    },
    "TaskLifecyclePolicy": {
      "type": "object",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/TaskAttachmentMode"
        },
        "completion": {
          "$ref": "#/$defs/TaskCompletionBehavior"
        },
        "onParentCancel": {
          "$ref": "#/$defs/TaskParentTerminalAction"
        },
        "onParentFailure": {
          "$ref": "#/$defs/TaskParentTerminalAction"
        }
      },
      "required": [
        "attachment",
        "onParentCancel",
        "onParentFailure",
        "completion"
      ]
    },
    "TaskManualActor": {
      "type": "string",
      "enum": [
        "owner",
        "workspace_member",
        "system",
        "any"
      ]
    },
    "TaskMetadata": {
      "type": "object",
      "properties": {
        "composerWork": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskComposerWork"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TaskOwnerKind": {
      "type": "string",
      "enum": [
        "user",
        "thread",
        "workspace",
        "system"
      ]
    },
    "TaskParentTerminalAction": {
      "type": "string",
      "enum": [
        "cancel",
        "detach",
        "keep_running"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskRetryBackoffKind": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "exponential"
      ]
    },
    "TaskRetryPolicy": {
      "type": "object",
      "properties": {
        "backoff": {
          "$ref": "#/$defs/TaskRetryBackoffKind"
        },
        "initialDelaySeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "maxAttempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxDelaySeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "retryOn": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskErrorClass"
          }
        }
      },
      "required": [
        "maxAttempts",
        "backoff"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "waiting_review",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "TaskTimeoutPolicy": {
      "type": "object",
      "properties": {
        "heartbeatTimeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "queueTimeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "runTimeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      }
    },
    "TaskTrigger": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "lastFireAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "nextFireAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "spec": {
          "$ref": "#/$defs/TaskTriggerSpec"
        },
        "status": {
          "$ref": "#/$defs/TaskTriggerStatus"
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "status",
        "spec",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskTriggerCatchUpMode": {
      "type": "string",
      "enum": [
        "run_once_for_latest_missed",
        "skip_missed",
        "run_all_missed"
      ]
    },
    "TaskTriggerCatchUpPolicy": {
      "type": "object",
      "properties": {
        "maxCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskTriggerCatchUpMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TaskTriggerSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "immediate"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catch_up_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskTriggerCatchUpPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "scheduled_at"
            },
            "scheduled_at": {
              "type": "integer",
              "format": "int64"
            },
            "timezone": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "scheduled_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catch_up_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskTriggerCatchUpPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "interval_anchor_at": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "interval_seconds": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "interval"
            }
          },
          "required": [
            "kind",
            "interval_seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catch_up_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskTriggerCatchUpPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cron_expr": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "cron"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cron_expr",
            "timezone"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allowed_actor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskManualActor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "filter": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskExternalTriggerFilter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "external"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dependency"
            },
            "policy": {
              "$ref": "#/$defs/TaskDependencyTriggerPolicy"
            }
          },
          "required": [
            "kind",
            "policy"
          ]
        }
      ]
    },
    "TaskTriggerStatus": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "exhausted",
        "cancelled"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "TextElement": {
      "type": "object",
