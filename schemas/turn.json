{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turn",
  "type": "object",
  "properties": {
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/TurnOrigin",
      "default": "user"
    },
    "permission_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionProfileSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptManifest"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/TurnStatus"
    },
    "turn_kind": {
      "$ref": "#/$defs/TurnKind",
      "default": "conversation"
    }
  },
  "required": [
    "id",
    "status"
  ],
  "$defs": {
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "PromptManifest": {
      "type": "object",
      "properties": {
        "compiler_version": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptManifestDiagnostic"
          }
        },
        "fingerprint_dynamic": {
          "type": "string"
        },
        "fingerprint_full": {
          "type": "string"
        },
        "fingerprint_stable": {
          "type": "string"
        },
        "hook_sources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptManifestHookSourceEntry"
          }
        },
        "profile": {
          "$ref": "#/$defs/PromptManifestProfile"
        },
        "section_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "compiler_version",
        "profile",
        "fingerprint_stable",
        "fingerprint_dynamic",
        "fingerprint_full"
      ]
    },
    "PromptManifestDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PromptManifestDiagnosticCode"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptManifestHookSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "PromptManifestDiagnosticCode": {
      "type": "string",
      "enum": [
        "missing_file",
        "file_read_error",
        "file_truncated",
        "total_budget_truncated",
        "file_filtered_by_profile",
        "dynamic_section_truncated",
        "dynamic_section_omitted",
        "hook_diagnostic",
        "hook_best_effort_failed",
        "capability_rejected"
      ]
    },
    "PromptManifestHookContributionKind": {
      "type": "string",
      "enum": [
        "prompt_context",
        "thread_context",
        "prompt_section",
        "prompt_manifest_diagnostic",
        "runtime_failure"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_context",
        "turn_post_preflight_prompt_context",
        "turn_pre_prompt_compile",
        "runtime_turn_pre_context"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "hook_id",
        "subscription_id",
        "phase"
      ]
    },
    "PromptManifestHookSourceEntry": {
      "type": "object",
      "properties": {
        "contribution_kind": {
          "$ref": "#/$defs/PromptManifestHookContributionKind"
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/PromptManifestHookSource"
        },
        "source_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "truncation": {
          "$ref": "#/$defs/PromptManifestHookTruncation"
        }
      },
      "required": [
        "source",
        "contribution_kind",
        "truncation"
      ]
    },
    "PromptManifestHookTruncation": {
      "type": "string",
      "enum": [
        "none",
        "hook",
        "prompt",
        "hook_and_prompt",
        "unknown"
      ]
    },
    "PromptManifestProfile": {
      "type": "string",
      "enum": [
        "assistant_full",
        "assistant_minimal",
        "assistant_none",
        "cli_runtime"
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnKind": {
      "type": "string",
      "enum": [
        "conversation",
        "task_run"
      ]
    },
    "TurnOrigin": {
      "type": "string",
      "enum": [
        "user",
        "scheduled_task",
        "detached_task",
        "attached_task"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSnapshot": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "source": {
          "$ref": "#/$defs/TurnPermissionProfileSource"
        }
      },
      "required": [
        "mode",
        "source",
        "effective_policy"
      ]
    },
    "TurnPermissionProfileSource": {
      "type": "string",
      "enum": [
        "composer",
        "defaulted",
        "inherited_from_parent_turn",
        "task_permission_cap",
        "system"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "InProgress",
        "Completed",
        "Failed",
        "Interrupted",
        "Blocked"
      ]
    }
  }
}