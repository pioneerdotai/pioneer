{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskRecoveredNotification",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/TaskNotificationContext"
    },
    "recoveredAt": {
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "context",
    "recoveredAt"
  ],
  "$defs": {
    "TaskNotificationContext": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "int64"
        },
        "taskId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "taskId",
        "eventId",
        "sequence"
      ]
    }
  }
}