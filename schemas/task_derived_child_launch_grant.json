{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskDerivedChildLaunchGrant",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "agent_authorization_fingerprint": {
          "type": "string"
        },
        "agent_policy_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "child_launch_grant": {
          "$ref": "#/$defs/ChildAgentLaunchGrantSet"
        },
        "identity": {
          "$ref": "#/$defs/AgentIdentityProjection"
        },
        "kind": {
          "type": "string",
          "const": "resolved_task_launch"
        },
        "native_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeContextBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeSummaryContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/AgentExecutionProfileProjection"
        },
        "role_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "profile",
        "role_key",
        "agent_policy_generation",
        "allowed_actions",
        "agent_authorization_fingerprint",
        "child_launch_grant"
      ]
    }
  ],
  "$defs": {
    "AgentExecutionProfileBackend": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "api_provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cli_runtime": {
              "type": "object",
              "properties": {
                "runtime_instance_id": {
                  "type": "string"
                }
              },
              "required": [
                "runtime_instance_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "cli_runtime"
          ]
        },
        {
          "type": "object",
          "properties": {
            "acp_agent_runtime": {
              "type": "object",
              "properties": {
                "runtime_id": {
                  "type": "string"
                }
              },
              "required": [
                "runtime_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "acp_agent_runtime"
          ]
        }
      ]
    },
    "AgentExecutionProfileId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileProjection": {
      "type": "object",
      "properties": {
        "allowedPermissionProfiles": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnPermissionMode"
          }
        },
        "allowedReasoning": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnReasoningSelection"
          }
        },
        "backend": {
          "$ref": "#/$defs/AgentExecutionProfileBackend"
        },
        "catalogGeneration": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "compatibleAgentIdentityIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentIdentityId"
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentExecutionProfileId"
        },
        "modelDisplayName": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "policyGeneration": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "providerDisplayName": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "compatibleAgentIdentityIds",
        "backend",
        "providerId",
        "modelId",
        "providerDisplayName",
        "modelDisplayName",
        "catalogGeneration",
        "policyGeneration",
        "fingerprint"
      ]
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityProjection": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "nickname": {
          "type": "string"
        },
        "role_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_fingerprint": {
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "source_kind",
        "display_name",
        "nickname",
        "source_revision",
        "source_fingerprint"
      ]
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "ChildAgentLaunchGrantSet": {
      "description": "Immutable delegation boundary for identities and capabilities. Model catalogs\nare current metadata, not durable authority; each launch stores its exact\nexecution profile separately.",
      "type": "object",
      "properties": {
        "allowInheritParentIdentity": {
          "type": "boolean"
        },
        "allowInheritParentProfile": {
          "type": "boolean"
        },
        "allowServerDerivedEphemeral": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentIdentityProjection"
          }
        },
        "maxPermissionProfile": {
          "$ref": "#/$defs/TurnPermissionProfileCap"
        },
        "mcpServerIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "skillIds": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillId"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "identities",
        "allowInheritParentIdentity",
        "allowServerDerivedEphemeral",
        "allowInheritParentProfile",
        "maxPermissionProfile",
        "fingerprint"
      ]
    },
    "NativeContextBudget": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string"
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "manual_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "context_window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_input": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_output": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "service_mode": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "parameters": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "neutral",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "open_ai_standard",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "anthropic_standard",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "bedrock_standard",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "open_ai_pro",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "bedrock_nested_ultrafast",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "open_ai_tier",
                          "type": "string"
                        },
                        "tier": {
                          "enum": [
                            "priority",
                            "flex",
                            "ultrafast"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "tier"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "anthropic_fast",
                          "type": "string"
                        },
                        "beta": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "parameters"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instance",
        "model",
        "context_window"
      ]
    },
    "NativeSummaryContext": {
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "#/$defs/NativeContextBudget"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "inherits_working": {
          "type": "boolean"
        }
      },
      "required": [
        "budget",
        "inherits_working"
      ]
    },
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "agent_action": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_paths_restricted": {
          "description": "See `allowed_tools_restricted`.  A restricted empty path set is a\ndurable deny-all result, while an unrestricted empty set is the legacy\nwildcard.",
          "type": "boolean"
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools_restricted": {
          "description": "`allowed_tools = []` historically means \"no allow-list\".  This bit\npreserves the distinct result of intersecting two disjoint allow-lists:\na restricted empty set must deny every tool rather than reopen all of\nthem.",
          "type": "boolean"
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "memory_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent",
        "memory_write",
        "agent_action"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileCap": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode",
        "effective_policy"
      ]
    },
    "TurnReasoningSelection": {
      "type": "object",
      "properties": {
        "effort": {
          "description": "String-valued because CLI runtimes may advertise efforts newer than\nPioneer API-provider adapters understand.",
          "type": "string"
        }
      },
      "required": [
        "effort"
      ]
    }
  }
}