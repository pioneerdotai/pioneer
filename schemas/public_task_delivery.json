{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskDelivery",
  "type": "object",
  "properties": {
    "attemptCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "deliveredAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicTaskFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "maxAttempts": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/$defs/TaskDeliveryMode"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicTaskResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskDeliveryStatus"
    },
    "taskId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "id",
    "taskId",
    "runId",
    "mode",
    "status",
    "attemptCount",
    "maxAttempts",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "PublicError": {
      "description": "Stable, bounded failure presentation shared by RPC, voice and task\nexecution surfaces. Raw source chains are never part of this type.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PublicErrorCode"
        },
        "correlation_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PublicErrorStage"
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "code",
        "stage",
        "message",
        "retryable",
        "correlation_id"
      ]
    },
    "PublicErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "policy_denied",
        "not_found",
        "conflict",
        "resource_exhausted",
        "unavailable",
        "timeout",
        "internal"
      ]
    },
    "PublicErrorStage": {
      "type": "string",
      "enum": [
        "discovery",
        "admission",
        "preparation",
        "execution",
        "persistence",
        "delivery",
        "observation"
      ]
    },
    "PublicTaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "error": {
          "$ref": "#/$defs/PublicError"
        }
      },
      "required": [
        "class",
        "error"
      ]
    },
    "PublicTaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicTaskArtifact"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "thread",
        "user_notification",
        "webhook"
      ]
    },
    "TaskDeliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "delivering",
        "delivered",
        "failed",
        "cancelled"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    }
  }
}