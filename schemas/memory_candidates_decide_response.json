{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCandidatesDecideResponse",
  "type": "object",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/MemoryCandidate"
    },
    "record": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryRecord"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "candidate"
  ],
  "$defs": {
    "MemoryActor": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MemoryActorKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "MemoryActorKind": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "extractor",
        "system",
        "tool"
      ]
    },
    "MemoryCandidate": {
      "type": "object",
      "properties": {
        "candidate_text": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/MemoryCategory"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "decided_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "decision_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "provenance": {
          "$ref": "#/$defs/MemoryProvenance"
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "source_context_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemorySourceContextKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/MemoryCandidateStatus"
        }
      },
      "required": [
        "id",
        "scope",
        "category",
        "candidate_text",
        "confidence",
        "reason",
        "provenance",
        "status",
        "created_at"
      ]
    },
    "MemoryCandidateStatus": {
      "type": "string",
      "enum": [
        "pending",
        "pending_silent",
        "ask_on_use",
        "needs_review",
        "approved",
        "rejected",
        "auto_rejected",
        "review_disabled_rejected",
        "superseded",
        "merged_duplicate",
        "expired"
      ]
    },
    "MemoryCategory": {
      "type": "string",
      "enum": [
        "identity",
        "preference",
        "biography",
        "relationship",
        "recurring_instruction",
        "project_policy",
        "project_fact",
        "project_decision",
        "procedure",
        "todo",
        "constraint",
        "communication_style",
        "custom"
      ]
    },
    "MemoryProvenance": {
      "type": "object",
      "properties": {
        "created_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryActor"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MemoryRecord": {
      "type": "object",
      "properties": {
        "access_count": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "category": {
          "$ref": "#/$defs/MemoryCategory"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "delete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "expires_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "importance": {
          "type": "number",
          "format": "float"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_accessed_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/MemoryProvenance"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "sensitivity": {
          "$ref": "#/$defs/MemorySensitivity"
        },
        "source_context_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemorySourceContextKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/MemoryStatus"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "scope",
        "category",
        "content",
        "status",
        "confidence",
        "importance",
        "sensitivity",
        "provenance",
        "created_at",
        "updated_at"
      ]
    },
    "MemoryScope": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryScopeKind"
        }
      },
      "required": [
        "kind",
        "key"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    },
    "MemorySensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "personal",
        "secret_like",
        "regulated"
      ]
    },
    "MemorySourceContextKind": {
      "type": "string",
      "enum": [
        "direct_user_conversation",
        "assistant_response",
        "tool_result",
        "task_runtime",
        "system_runtime",
        "developer_instruction",
        "connector_content",
        "imported_document",
        "generated_summary",
        "unknown"
      ]
    },
    "MemoryStatus": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "deleted",
        "expired"
      ]
    }
  }
}