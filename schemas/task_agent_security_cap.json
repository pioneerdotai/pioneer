{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAgentSecurityCap",
  "type": "object",
  "properties": {
    "maxFilesystemEntries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnFilesystemSandboxEntry"
      }
    },
    "maxFilesystemKind": {
      "description": "Distinguishes a restricted cap with zero roots from an unrestricted\ncap, whose bounded-root list is also empty. Legacy records omit this\nfield and are interpreted conservatively by the Gateway.",
      "anyOf": [
        {
          "$ref": "#/$defs/TurnFilesystemSandboxKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "maxNetworkPolicy": {
      "$ref": "#/$defs/TurnNetworkPolicySnapshot"
    },
    "maxPermissionProfile": {
      "$ref": "#/$defs/TurnPermissionProfileCap"
    },
    "maxProcessPolicy": {
      "$ref": "#/$defs/TurnProcessPolicySnapshot"
    },
    "maxSandboxMode": {
      "$ref": "#/$defs/TurnSandboxMode"
    }
  },
  "required": [
    "maxPermissionProfile",
    "maxNetworkPolicy",
    "maxSandboxMode",
    "maxProcessPolicy"
  ],
  "$defs": {
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "agent_action": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_paths_restricted": {
          "description": "See `allowed_tools_restricted`.  A restricted empty path set is a\ndurable deny-all result, while an unrestricted empty set is the legacy\nwildcard.",
          "type": "boolean"
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools_restricted": {
          "description": "`allowed_tools = []` historically means \"no allow-list\".  This bit\npreserves the distinct result of intersecting two disjoint allow-lists:\na restricted empty set must deny every tool rather than reopen all of\nthem.",
          "type": "boolean"
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "memory_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent",
        "memory_write",
        "agent_action"
      ]
    },
    "TurnCommandRiskPolicy": {
      "type": "object",
      "properties": {
        "allowed_command_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TurnEnvironmentPolicy": {
      "type": "object",
      "properties": {
        "allowed_vars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inherit": {
          "type": "boolean"
        }
      },
      "required": [
        "inherit"
      ]
    },
    "TurnFilesystemAccess": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write"
      ]
    },
    "TurnFilesystemSandboxEntry": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/TurnFilesystemAccess"
        },
        "path": {
          "$ref": "#/$defs/TurnFilesystemSandboxPath"
        },
        "provenance": {
          "$ref": "#/$defs/TurnSecurityRuleProvenance"
        },
        "resolved_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "access",
        "provenance"
      ]
    },
    "TurnFilesystemSandboxKind": {
      "type": "string",
      "enum": [
        "restricted",
        "unrestricted"
      ]
    },
    "TurnFilesystemSandboxPath": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "current_working_directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "project_root"
            },
            "subpath": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "slash_tmp"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tmpdir"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "runtime_home"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit_path"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    },
    "TurnNetworkPolicySnapshot": {
      "type": "object",
      "properties": {
        "allow_localhost": {
          "type": "boolean"
        },
        "allow_unix_sockets": {
          "type": "boolean"
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/TurnNetworkMode"
        }
      },
      "required": [
        "mode",
        "allow_localhost",
        "allow_unix_sockets"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileCap": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode",
        "effective_policy"
      ]
    },
    "TurnProcessPolicySnapshot": {
      "type": "object",
      "properties": {
        "command_risk": {
          "$ref": "#/$defs/TurnCommandRiskPolicy"
        },
        "environment": {
          "$ref": "#/$defs/TurnEnvironmentPolicy"
        },
        "shell": {
          "$ref": "#/$defs/TurnShellPolicy"
        },
        "timeout": {
          "$ref": "#/$defs/TurnProcessTimeoutPolicy"
        }
      },
      "required": [
        "shell",
        "environment",
        "timeout",
        "command_risk"
      ]
    },
    "TurnProcessTimeoutPolicy": {
      "type": "object",
      "properties": {
        "max_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "max_duration_ms"
      ]
    },
    "TurnSandboxMode": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "TurnSecurityRuleProvenance": {
      "type": "string",
      "enum": [
        "composer_selection",
        "workspace",
        "project",
        "runtime",
        "task_cap",
        "system"
      ]
    },
    "TurnShellPolicy": {
      "type": "object",
      "properties": {
        "allow_session_inheritance": {
          "type": "boolean"
        },
        "allow_stdin": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "allow_stdin",
        "allow_session_inheritance"
      ]
    }
  }
}