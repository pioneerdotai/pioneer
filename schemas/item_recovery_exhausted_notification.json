{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemRecoveryExhaustedNotification",
  "type": "object",
  "properties": {
    "attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error_message": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "recovery_job_id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RecoveryJobStatus"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "item_type",
    "recovery_job_id",
    "attempt_number",
    "status",
    "error_message"
  ],
  "$defs": {
    "RecoveryJobStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "succeeded",
        "failed",
        "exhausted",
        "cancelled"
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}