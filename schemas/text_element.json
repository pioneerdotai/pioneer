{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextElement",
  "type": "object",
  "properties": {
    "byte_range": {
      "$ref": "#/$defs/ByteRange"
    },
    "placeholder": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "byte_range"
  ],
  "$defs": {
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    }
  }
}