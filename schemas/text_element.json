{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TextElement",
  "type": "object",
  "required": [
    "byte_range"
  ],
  "properties": {
    "byte_range": {
      "$ref": "#/definitions/ByteRange"
    },
    "placeholder": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
