{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskRunFailedNotification",
  "type": "object",
  "required": [
    "context",
    "run"
  ],
  "properties": {
    "context": {
      "$ref": "#/definitions/TaskNotificationContext"
    },
    "run": {
      "$ref": "#/definitions/TaskRun"
    }
  },
  "definitions": {
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskError": {
      "type": "object",
      "required": [
        "class",
        "code",
        "message"
      ],
      "properties": {
        "class": {
          "$ref": "#/definitions/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskNotificationContext": {
      "type": "object",
      "required": [
        "eventId",
        "sequence",
        "taskId",
        "workspaceId"
      ],
      "properties": {
        "eventId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "int64"
        },
        "taskId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      }
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskRun": {
      "type": "object",
      "required": [
        "attemptNumber",
        "createdAt",
        "executorKind",
        "id",
        "runGroupId",
        "runNumber",
        "status",
        "taskId",
        "updatedAt"
      ],
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/definitions/TaskExecutorKind"
        },
        "heartbeatAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "lockExpiresAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "lockedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "readyAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryOfRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runGroupId": {
          "type": "string"
        },
        "runNumber": {
          "type": "integer",
          "format": "int64"
        },
        "startedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/definitions/TaskRunStatus"
        },
        "taskId": {
          "type": "string"
        },
        "triggerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "TaskRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "integer"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "string"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TaskValue"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/TaskValue"
              }
            }
          }
        }
      ]
    }
  }
}