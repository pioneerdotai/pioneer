{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsPolicySetParams",
  "type": "object",
  "properties": {
    "allow_implicit_invocation": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "skill_id": {
      "$ref": "#/$defs/SkillId"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "skill_id"
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}