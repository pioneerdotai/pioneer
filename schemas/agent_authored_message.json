{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentAuthoredMessage",
  "type": "object",
  "properties": {
    "author": {
      "$ref": "#/$defs/ClientAgentPresentationSnapshot"
    },
    "messageId": {
      "type": "string"
    },
    "route": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafeRouteProvenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/AgentAuthoredMessageState"
    },
    "turnId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "messageId",
    "turnId",
    "author",
    "state"
  ],
  "$defs": {
    "AgentAuthoredMessageState": {
      "type": "string",
      "enum": [
        "streaming",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "AgentIdentityStatus": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    },
    "AgentResultReturnPolicy": {
      "type": "string",
      "enum": [
        "none",
        "summary_only",
        "full_result"
      ]
    },
    "AgentRouteAction": {
      "type": "string",
      "enum": [
        "send_message",
        "start_agent",
        "create_task",
        "schedule_task",
        "review_task_result",
        "deliver_result"
      ]
    },
    "AgentRouteDisclosurePolicy": {
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Exact, already-authorized artifact handles. Raw files and paths are\nnever represented by this flag.",
          "type": "boolean",
          "default": false
        },
        "context": {
          "description": "Bounded conversation excerpts or summaries selected by server policy.",
          "type": "boolean",
          "default": false
        },
        "resultReturn": {
          "description": "Result return is a separate disclosure class: allowing ordinary text\nmust never imply that a full Task result can cross a capsule boundary.",
          "$ref": "#/$defs/AgentResultReturnPolicy",
          "default": "none"
        },
        "text": {
          "description": "Explicit text authored for the routed operation.",
          "type": "boolean",
          "default": false
        },
        "userInput": {
          "description": "Explicit user-provided Task inputs. This is deliberately independent\nfrom Agent-authored text and inherited conversation context.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ClientAgentPresentationSnapshot": {
      "type": "object",
      "properties": {
        "agentExecutionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "agentIdentityId": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "avatarRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "roleLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceKind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "sourceRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/AgentIdentityStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "agentIdentityId",
        "agentExecutionId",
        "sourceKind",
        "sourceRevision",
        "displayName",
        "nickname",
        "status"
      ]
    },
    "CrossThreadSourceVisibility": {
      "type": "string",
      "enum": [
        "accessible",
        "inaccessible"
      ]
    },
    "SafeRouteProvenance": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AgentRouteAction"
        },
        "disclosure": {
          "$ref": "#/$defs/AgentRouteDisclosurePolicy"
        },
        "sourceThreadLabel": {
          "description": "Present only when the viewer has source read authority.  Source title,\nparticipants, prompts, and raw identifiers are never sent otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/CrossThreadSourceVisibility"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "visibility",
        "disclosure"
      ]
    }
  }
}