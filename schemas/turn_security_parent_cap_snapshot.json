{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnSecurityParentCapSnapshot",
  "type": "object",
  "properties": {
    "max_filesystem_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnFilesystemSandboxEntry"
      }
    },
    "max_network_policy": {
      "$ref": "#/$defs/TurnNetworkPolicySnapshot"
    },
    "max_permission_profile": {
      "$ref": "#/$defs/TurnPermissionProfileCap"
    },
    "max_sandbox_mode": {
      "$ref": "#/$defs/TurnSandboxMode"
    },
    "parent_turn_id": {
      "type": "string"
    }
  },
  "required": [
    "parent_turn_id",
    "max_permission_profile",
    "max_network_policy",
    "max_sandbox_mode"
  ],
  "$defs": {
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnFilesystemAccess": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write"
      ]
    },
    "TurnFilesystemSandboxEntry": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/TurnFilesystemAccess"
        },
        "path": {
          "$ref": "#/$defs/TurnFilesystemSandboxPath"
        },
        "provenance": {
          "$ref": "#/$defs/TurnSecurityRuleProvenance"
        },
        "resolved_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "access",
        "provenance"
      ]
    },
    "TurnFilesystemSandboxPath": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "current_working_directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "project_root"
            },
            "subpath": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "slash_tmp"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tmpdir"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "runtime_home"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit_path"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    },
    "TurnNetworkPolicySnapshot": {
      "type": "object",
      "properties": {
        "allow_localhost": {
          "type": "boolean"
        },
        "allow_unix_sockets": {
          "type": "boolean"
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/TurnNetworkMode"
        }
      },
      "required": [
        "mode",
        "allow_localhost",
        "allow_unix_sockets"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileCap": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode",
        "effective_policy"
      ]
    },
    "TurnSandboxMode": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "TurnSecurityRuleProvenance": {
      "type": "string",
      "enum": [
        "composer_selection",
        "workspace",
        "project",
        "runtime",
        "task_cap",
        "system"
      ]
    }
  }
}