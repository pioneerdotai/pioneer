{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentActionIntent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/AgentAuthoredInput"
        },
        "kind": {
          "type": "string",
          "const": "sendMessage"
        },
        "target": {
          "$ref": "#/$defs/AgentStartTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "target",
        "input",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "createThread"
        },
        "option": {
          "$ref": "#/$defs/AgentThreadCreationOption"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "option",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "startAgent"
        },
        "start": {
          "$ref": "#/$defs/StartAgentIntent"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "start",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "createTask"
        },
        "selection": {
          "$ref": "#/$defs/AgentTaskActionSelection"
        },
        "target": {
          "$ref": "#/$defs/AgentStartTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "target",
        "selection",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "scheduleTask"
        },
        "schedule_option_id": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/AgentTaskActionSelection"
        },
        "target": {
          "$ref": "#/$defs/AgentStartTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "target",
        "selection",
        "schedule_option_id",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "decision": {
          "$ref": "#/$defs/AgentReviewDecision"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "reviewTaskResult"
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "task_id",
        "decision",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "control": {
          "$ref": "#/$defs/AgentTaskControl"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "controlTask"
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "task_id",
        "control",
        "idempotency_key"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/AgentActionId"
        },
        "execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "deliverResult"
        },
        "result_reference": {
          "type": "string"
        },
        "route_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentDelegationRouteId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/AgentStartTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id",
        "execution_id",
        "target",
        "result_reference",
        "idempotency_key"
      ]
    }
  ],
  "$defs": {
    "AgentActionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentAuthoredInput": {
      "description": "Input authored by an agent for the child turn. Configuration and actor\nidentity are deliberately not part of this value.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UserInput"
      }
    },
    "AgentDelegationRouteId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileSelection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "inherit_parent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exact": {
              "type": "object",
              "properties": {
                "profile_id": {
                  "$ref": "#/$defs/AgentExecutionProfileId"
                }
              },
              "additionalProperties": false,
              "required": [
                "profile_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "exact"
          ]
        }
      ]
    },
    "AgentExecutionSelection": {
      "type": "object",
      "properties": {
        "mcpServerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissionProfile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnPermissionProfileSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/AgentExecutionProfileSelection"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnReasoningSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "skillIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile"
      ]
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySelection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "inherit_parent",
            "default_pioneer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exact": {
              "type": "object",
              "properties": {
                "agent_identity_id": {
                  "$ref": "#/$defs/AgentIdentityId"
                }
              },
              "additionalProperties": false,
              "required": [
                "agent_identity_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "exact"
          ]
        },
        {
          "type": "object",
          "properties": {
            "server_derived_ephemeral": {
              "type": "object",
              "properties": {
                "display_name_hint": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role_label": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "server_derived_ephemeral"
          ]
        }
      ]
    },
    "AgentLaunchSelection": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentIdentitySelection"
        },
        "execution": {
          "$ref": "#/$defs/AgentExecutionSelection"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent",
        "execution"
      ]
    },
    "AgentReviewDecision": {
      "type": "string",
      "enum": [
        "accept",
        "reject",
        "request_changes",
        "abstain"
      ]
    },
    "AgentStartTarget": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "current_thread"
          ]
        },
        {
          "type": "object",
          "properties": {
            "same_capsule_thread": {
              "type": "object",
              "properties": {
                "thread_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "thread_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "same_capsule_thread"
          ]
        },
        {
          "type": "object",
          "properties": {
            "routed_thread": {
              "type": "object",
              "properties": {
                "route_id": {
                  "$ref": "#/$defs/AgentDelegationRouteId"
                },
                "thread_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "route_id",
                "thread_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "routed_thread"
          ]
        }
      ]
    },
    "AgentTaskActionSelection": {
      "type": "object",
      "properties": {
        "launch": {
          "$ref": "#/$defs/AgentLaunchSelection"
        },
        "taskTemplateId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "taskTemplateId",
        "launch"
      ]
    },
    "AgentTaskControl": {
      "type": "string",
      "enum": [
        "cancel",
        "resume",
        "detach"
      ]
    },
    "AgentThreadAudienceTemplate": {
      "type": "string",
      "enum": [
        "home_capsule",
        "root_delegation"
      ]
    },
    "AgentThreadCreationOption": {
      "type": "object",
      "properties": {
        "audience": {
          "$ref": "#/$defs/AgentThreadAudienceTemplate"
        },
        "optionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "optionId",
        "audience"
      ]
    },
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "StartAgentIntent": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/AgentAuthoredInput"
        },
        "launch": {
          "$ref": "#/$defs/AgentLaunchSelection"
        },
        "target": {
          "$ref": "#/$defs/AgentStartTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "input",
        "launch"
      ]
    },
    "TextElement": {
      "type": "object",
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_range"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSelection": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TurnReasoningSelection": {
      "type": "object",
      "properties": {
        "effort": {
          "description": "String-valued because CLI runtimes may advertise efforts newer than\nPioneer API-provider adapters understand.",
          "type": "string"
        }
      },
      "required": [
        "effort"
      ]
    },
    "UserInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "textElements": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TextElement"
              }
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localImage"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localFile"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "audio"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localAudio"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "video"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localVideo"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "versionId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "artifactId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        }
      ]
    }
  }
}