{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnSandboxSnapshot",
  "type": "object",
  "properties": {
    "backend_preference": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SandboxBackendKind"
      }
    },
    "backend_requirement": {
      "$ref": "#/$defs/SandboxBackendRequirement"
    },
    "cwd": {
      "type": "string"
    },
    "filesystem": {
      "$ref": "#/$defs/TurnFilesystemSandboxPolicy"
    },
    "mode": {
      "$ref": "#/$defs/TurnSandboxMode"
    },
    "network": {
      "$ref": "#/$defs/TurnNetworkPolicySnapshot"
    },
    "tmp": {
      "$ref": "#/$defs/TurnTmpPolicy"
    }
  },
  "required": [
    "mode",
    "cwd",
    "filesystem",
    "tmp",
    "network",
    "backend_requirement"
  ],
  "$defs": {
    "SandboxBackendKind": {
      "type": "string",
      "enum": [
        "nono",
        "windows_restricted_token",
        "provider_native"
      ]
    },
    "SandboxBackendRequirement": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ]
    },
    "TurnFilesystemAccess": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write"
      ]
    },
    "TurnFilesystemSandboxEntry": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/TurnFilesystemAccess"
        },
        "path": {
          "$ref": "#/$defs/TurnFilesystemSandboxPath"
        },
        "provenance": {
          "$ref": "#/$defs/TurnSecurityRuleProvenance"
        },
        "resolved_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "access",
        "provenance"
      ]
    },
    "TurnFilesystemSandboxKind": {
      "type": "string",
      "enum": [
        "restricted",
        "unrestricted"
      ]
    },
    "TurnFilesystemSandboxPath": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "current_working_directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "project_root"
            },
            "subpath": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "slash_tmp"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tmpdir"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "runtime_home"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit_path"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "TurnFilesystemSandboxPolicy": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnFilesystemSandboxEntry"
          }
        },
        "kind": {
          "$ref": "#/$defs/TurnFilesystemSandboxKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    },
    "TurnNetworkPolicySnapshot": {
      "type": "object",
      "properties": {
        "allow_localhost": {
          "type": "boolean"
        },
        "allow_unix_sockets": {
          "type": "boolean"
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/TurnNetworkMode"
        }
      },
      "required": [
        "mode",
        "allow_localhost",
        "allow_unix_sockets"
      ]
    },
    "TurnSandboxMode": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "TurnSecurityRuleProvenance": {
      "type": "string",
      "enum": [
        "composer_selection",
        "workspace",
        "project",
        "runtime",
        "task_cap",
        "system"
      ]
    },
    "TurnTmpMode": {
      "type": "string",
      "enum": [
        "host",
        "isolated"
      ]
    },
    "TurnTmpPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/TurnTmpMode"
        },
        "writable_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode"
      ]
    }
  }
}