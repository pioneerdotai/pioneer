{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRegisterParams",
  "type": "object",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "anyOf": [
