          "$ref": "#/$defs/ArtifactPrepareKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "mimeType": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string"
    },
    "preparedOutputPath": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "path"
  ],
  "$defs": {
    "ArtifactPrepareKind": {
      "type": "string",
      "enum": [
        "image",
        "document",
        "data",
        "archive",
        "code",
        "log",
        "other"
      ]
    }
  }
