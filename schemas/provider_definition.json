{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderDefinition",
  "type": "object",
  "properties": {
    "default_base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "supports_base_url_override": {
      "type": "boolean",
      "default": false
    },
    "retirement_reason": {
      "description": "Terminal product lifecycle diagnostic; old clients can ignore it.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ]
}