{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskDependencyTriggerPolicy",
  "type": "object",
  "properties": {
    "dependsOnTaskIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "$ref": "#/$defs/TaskDependencyTriggerMode"
    }
  },
  "required": [
    "mode"
  ],
  "$defs": {
    "TaskDependencyTriggerMode": {
      "type": "string",
      "enum": [
        "all_succeeded",
        "any_succeeded",
        "all_terminal"
      ]
    }
  }
}