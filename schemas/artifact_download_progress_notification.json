{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactDownloadProgressNotification",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "download_id": {
      "type": "string"
    },
    "received_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "download_id",
    "artifact_id",
    "received_bytes",
    "total_size_bytes"
  ]
}