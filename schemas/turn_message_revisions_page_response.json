{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnMessageRevisionsPageResponse",
  "type": "object",
  "properties": {
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "revisions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TurnMessageRevision"
      }
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id"
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "PersistedActorRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentExecutionId"
            },
            "kind": {
              "type": "string",
              "const": "agent_execution"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TextElement": {
      "type": "object",
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_range"
      ]
    },
    "TurnMention": {
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "required": [
        "principal_id",
        "nickname"
      ]
    },
    "TurnMessageRevision": {
      "type": "object",
      "properties": {
        "change_kind": {
          "$ref": "#/$defs/TurnMessageRevisionChangeKind"
        },
        "changed_by": {
          "$ref": "#/$defs/PersistedActorRef"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "input": {
          "description": "`None` is the intentional content-redacted representation.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/UserInput"
          }
        },
        "mentions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnMention"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "revision",
        "change_kind",
        "changed_by",
        "created_at"
      ]
    },
    "TurnMessageRevisionChangeKind": {
      "type": "string",
      "enum": [
        "edit",
        "delete"
      ]
    },
    "UserInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "textElements": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TextElement"
              }
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localImage"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localFile"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "audio"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localAudio"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "video"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localVideo"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "versionId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "artifactId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        }
      ]
    }
  }
}