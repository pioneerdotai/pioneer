{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevAppOperation",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "add"
        },
        "params": {
          "$ref": "#/$defs/AppsDevAddParams"
        }
      },
      "required": [
        "action",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "list"
        },
        "params": {
          "$ref": "#/$defs/AppsListParams"
        }
      },
      "required": [
        "action",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "remove"
        },
        "params": {
          "$ref": "#/$defs/AppsDetailsParams"
        }
      },
      "required": [
        "action",
        "params"
      ]
    }
  ],
  "$defs": {
    "AppsDevAddParams": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "project",
        "url"
      ],
      "description": "Local authoring connection. The Gateway reads project files on its host."
    },
    "AppsListParams": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id"
      ]
    },
    "AppsDetailsParams": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "app_id"
      ]
    }
  }
}
