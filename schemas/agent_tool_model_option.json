{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentToolModelOption",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "reasoning": {
      "description": "None means unknown. An empty effort list does not prove lack of support.",
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderModelReasoningCapabilities"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "displayName"
  ],
  "$defs": {
    "ProviderModelReasoningCapabilities": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningCapabilitySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_token_budget": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "config_override",
        "unknown"
      ]
    }
  }
}