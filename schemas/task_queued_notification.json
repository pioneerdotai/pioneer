{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskQueuedNotification",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/TaskNotificationContext"
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskRun"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "context"
  ],
  "$defs": {
    "ProviderFailureClass": {
      "type": "string",
      "enum": [
        "network_transient",
        "rate_limit",
        "provider_5xx",
        "auth_expired",
        "auth_or_permission",
        "model_not_found",
        "prompt_too_long",
        "context_too_large",
        "max_output_tokens",
        "stream_stall",
        "stream_truncated",
        "empty_response",
        "provider_rejected",
        "unsupported_parameter",
        "unsupported_capability",
        "unsupported_image_input",
        "unsupported_tool_calling",
        "unsupported_streaming",
        "malformed_provider_request",
        "invalid_request",
        "permission_denied",
        "unknown"
      ]
    },
    "ProviderFailureStage": {
      "type": "string",
      "enum": [
        "connect",
        "first_chunk",
        "mid_stream",
        "finalize"
      ]
    },
    "ProviderTransportKind": {
      "type": "string",
      "enum": [
        "stream",
        "non_stream",
        "ws",
        "sse"
      ]
    },
    "RecoveryDiagnostic": {
      "type": "object",
      "properties": {
        "lastFailure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryProviderFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "stopReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryStopReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RecoveryProviderFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ProviderFailureClass"
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "retryAfterMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "stage": {
          "$ref": "#/$defs/ProviderFailureStage"
        },
        "transport": {
          "$ref": "#/$defs/ProviderTransportKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "stage",
        "transport"
      ]
    },
    "RecoveryStopReason": {
      "type": "string",
      "enum": [
        "attempts_exhausted",
        "wall_clock_exhausted",
        "no_progress",
        "policy_rejected",
        "terminal_failure"
      ]
    },
    "TaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskError": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "recoveryDiagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "class"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskNotificationContext": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "int64"
        },
        "taskId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "taskId",
        "eventId",
        "sequence"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskArtifact"
          }
        },
        "completedByRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskRun": {
      "type": "object",
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskError"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "heartbeatAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "lockExpiresAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "lockedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "readyAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryOfRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runGroupId": {
          "type": "string"
        },
        "runNumber": {
          "type": "integer",
          "format": "int64"
        },
        "startedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskRunStatus"
        },
        "taskId": {
          "type": "string"
        },
        "triggerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "runGroupId",
        "attemptNumber",
        "runNumber",
        "status",
        "executorKind",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "waiting",
        "waiting_review",
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "timed_out"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}