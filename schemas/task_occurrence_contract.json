{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskOccurrenceContract",
  "type": "object",
  "properties": {
    "actionIdempotencyKey": {
      "type": "string"
    },
    "agentExecutionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "deliveryPlan": {
      "description": "Absent only on occurrences created before routing version 1 existed.\nNew occurrences always persist this snapshot before dispatch.",
      "anyOf": [
        {
          "$ref": "#/$defs/TaskOccurrenceDeliveryPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionGeneration": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "occurrenceId": {
      "type": "string"
    },
    "occurrenceKey": {
      "type": "string"
    },
    "queuePosition": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "resultReturnRouteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "retryAttempt": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "rootResourceScopeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "routeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskOccurrenceStatus"
    },
    "taskId": {
      "type": "string"
    },
    "terminalReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "triggerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workGraphRootExecutionId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "occurrenceId",
    "taskId",
    "runId",
    "occurrenceKey",
    "executionGeneration",
    "status",
    "retryAttempt",
    "actionIdempotencyKey"
  ],
  "$defs": {
    "TaskDeliveryFormat": {
      "type": "string",
      "enum": [
        "summary",
        "full_result"
      ]
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "thread",
        "user_notification",
        "webhook"
      ]
    },
    "TaskDeliveryPolicy": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TaskDeliveryFormat"
        },
        "includeResult": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/TaskDeliveryMode"
        },
        "threadId": {
          "description": "Canonical target persisted by Gateway. Callers provide this only for\n`ExactThread`; for semantic targets it is server-owned output.",
          "type": [
            "string",
            "null"
          ]
        },
        "threadTarget": {
          "description": "Required for `Thread` delivery. Gateway resolves semantic targets to a\ncanonical `thread_id` before persisting the Task.",
          "anyOf": [
            {
              "$ref": "#/$defs/TaskDeliveryThreadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "webhookUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "includeResult",
        "format"
      ]
    },
    "TaskDeliveryThreadTarget": {
      "description": "Semantic thread target resolved and persisted by Gateway.",
      "type": "string",
      "enum": [
        "origin_thread",
        "current_thread",
        "collaboration_root",
        "exact_thread"
      ]
    },
    "TaskOccurrenceDeliveryPlan": {
      "description": "Immutable delivery and presentation decision for one logical occurrence.\n\nThe Task policy may be edited while a run is in flight. Keeping the\nnormalized policy beside the occurrence guarantees that retries, result\ndelivery and the visible lifecycle card continue to use the same target.",
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/$defs/TaskDeliveryPolicy"
        },
        "presentationThreadId": {
          "description": "Thread that owns the TaskRun lifecycle card. Thread delivery uses the\nexact normalized delivery target; non-thread delivery has no target and\ntherefore leaves this absent for the executor to use its local fallback.",
          "type": [
            "string",
            "null"
          ]
        },
        "routingVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "routingVersion",
        "policy"
      ]
    },
    "TaskOccurrenceStatus": {
      "type": "string",
      "enum": [
        "dormant",
        "queued",
        "recovering",
        "running",
        "waiting_review",
        "delivered",
        "failed",
        "cancelled"
      ]
    }
  }
}