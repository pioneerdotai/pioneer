{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppViewBootstrap",
  "type": "object",
  "properties": {
    "dev_url": {
      "description": "Verified local authoring URL. The relative URL remains a native-only lease handle for dev views and must never be loaded into their browser.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "development": {
      "default": false,
      "type": "boolean"
    },
    "execution_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "package_revision": {
      "type": "integer",
      "format": "int64"
    },
    "relative_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "package_revision",
    "relative_url",
    "expires_at",
    "execution_id",
    "title"
  ]
}
