{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCanonicalKey",
  "type": "object",
  "properties": {
    "cardinality": {
      "$ref": "#/$defs/MemoryAttributeCardinality"
    },
    "category": {
      "$ref": "#/$defs/MemoryCategory"
    },
    "key": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/MemoryScope"
    }
  },
  "required": [
    "key",
    "scope",
    "namespace",
    "category",
    "cardinality"
  ],
  "$defs": {
    "MemoryAttributeCardinality": {
      "type": "string",
      "enum": [
        "single_value",
        "multi_value",
        "set_membership"
      ]
    },
    "MemoryCategory": {
      "type": "string",
      "enum": [
        "identity",
        "preference",
        "biography",
        "relationship",
        "recurring_instruction",
        "project_policy",
        "project_fact",
        "project_decision",
        "procedure",
        "todo",
        "constraint",
        "communication_style",
        "custom"
      ]
    },
    "MemoryScope": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryScopeKind"
        }
      },
      "required": [
        "kind",
        "key"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    }
  }
}