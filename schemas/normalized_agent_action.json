{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedAgentAction",
  "type": "object",
  "properties": {
    "actionId": {
      "$ref": "#/$defs/AgentActionId"
    },
    "executionId": {
      "$ref": "#/$defs/AgentExecutionId"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AgentActionKind"
    },
    "launch": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentLaunchSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "opaqueOptionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "opaqueResourceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payloadFingerprint": {
      "description": "Digest of the complete typed intent. The normalized projection omits\nvisible content and detailed control payloads, so this fence is what\nmakes same-key/different-payload retries conflict instead of silently\nreplaying the first write.",
      "type": "string"
    },
    "routeId": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentDelegationRouteId"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentStartTarget"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "actionId",
    "executionId",
    "kind",
    "idempotencyKey",
    "payloadFingerprint"
  ],
  "$defs": {
    "AgentActionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentActionKind": {
      "type": "string",
      "enum": [
        "send_message",
        "create_thread",
        "start_agent",
        "create_task",
        "schedule_task",
        "review_task_result",
        "control_task",
        "deliver_result"
      ]
    },
    "AgentDelegationRouteId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileSelection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "inherit_parent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exact": {
              "type": "object",
              "properties": {
                "profile_id": {
                  "$ref": "#/$defs/AgentExecutionProfileId"
                }
              },
              "additionalProperties": false,
              "required": [
                "profile_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "exact"
          ]
        }
      ]
    },
    "AgentExecutionSelection": {
      "type": "object",
      "properties": {
        "mcpServerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissionProfile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnPermissionProfileSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/AgentExecutionProfileSelection"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnReasoningSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "skillIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile"
      ]
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySelection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "inherit_parent",
            "default_pioneer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exact": {
              "type": "object",
              "properties": {
                "agent_identity_id": {
                  "$ref": "#/$defs/AgentIdentityId"
                }
              },
              "additionalProperties": false,
              "required": [
                "agent_identity_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "exact"
          ]
        },
        {
          "type": "object",
          "properties": {
            "server_derived_ephemeral": {
              "type": "object",
              "properties": {
                "display_name_hint": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role_label": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "server_derived_ephemeral"
          ]
        }
      ]
    },
    "AgentLaunchSelection": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentIdentitySelection"
        },
        "execution": {
          "$ref": "#/$defs/AgentExecutionSelection"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent",
        "execution"
      ]
    },
    "AgentStartTarget": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "current_thread"
          ]
        },
        {
          "type": "object",
          "properties": {
            "same_capsule_thread": {
              "type": "object",
              "properties": {
                "thread_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "thread_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "same_capsule_thread"
          ]
        },
        {
          "type": "object",
          "properties": {
            "routed_thread": {
              "type": "object",
              "properties": {
                "route_id": {
                  "$ref": "#/$defs/AgentDelegationRouteId"
                },
                "thread_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "route_id",
                "thread_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "routed_thread"
          ]
        }
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSelection": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TurnReasoningSelection": {
      "type": "object",
      "properties": {
        "effort": {
          "description": "String-valued because CLI runtimes may advertise efforts newer than\nPioneer API-provider adapters understand.",
          "type": "string"
        }
      },
      "required": [
        "effort"
      ]
    }
  }
}