{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayModelSelection",
  "description": "Inherit is a real absence of an override. It never stores a resolved fallback.\nThe tagged value also distinguishes an explicit reset from an omitted update.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "inherit"
        }
      },
      "additionalProperties": false,
      "required": [
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "context_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "instance": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeServiceModeSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "const": "explicit"
        },
        "transport": {
          "$ref": "#/$defs/ModelSelectionTransport"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "transport",
        "instance",
        "model"
      ]
    }
  ],
  "$defs": {
    "ModelSelectionTransport": {
      "type": "string",
      "enum": [
        "api",
        "codex",
        "claude",
        "opencode"
      ]
    },
    "NativeServiceModeSelection": {
      "description": "Explicit choice uses the existing endpoint/credential/model authority proof.\nAbsence means Standard; Inherit belongs to the enclosing model selection.",
      "type": "object",
      "properties": {
        "authority": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "authority"
      ]
    }
  }
}