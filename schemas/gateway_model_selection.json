{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayModelSelection",
  "description": "Inherit is a real absence of an override. It never stores a resolved fallback.\nThe tagged value also distinguishes an explicit reset from an omitted update.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "inherit"
        }
      },
      "additionalProperties": false,
      "required": [
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "context_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "instance": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "const": "explicit"
        },
        "transport": {
          "$ref": "#/$defs/ModelSelectionTransport"
        },
        "service_mode": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "authority": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "authority"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "transport",
        "instance",
        "model"
      ]
    }
  ],
  "$defs": {
    "ModelSelectionTransport": {
      "type": "string",
      "enum": [
        "api",
        "codex",
        "claude",
        "opencode"
      ]
    }
  }
}