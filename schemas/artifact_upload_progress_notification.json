{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactUploadProgressNotification",
  "type": "object",
  "properties": {
    "next_offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "received_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "upload_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "upload_id",
    "received_bytes",
    "total_size_bytes",
    "next_offset"
  ]
}