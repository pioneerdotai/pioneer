{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskCancelParams",
  "type": "object",
  "required": [
    "taskId"
  ],
  "properties": {
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "default": "attached_subtree",
      "allOf": [
        {
          "$ref": "#/definitions/TaskCancelScope"
        }
      ]
    },
    "taskId": {
      "type": "string"
    }
  },
  "definitions": {
    "TaskCancelScope": {
      "type": "string",
      "enum": [
        "task_only",
        "attached_subtree",
        "full_subtree"
      ]
    }
  }
}