{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskCancelParams",
  "type": "object",
  "properties": {
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "$ref": "#/$defs/TaskCancelScope",
      "default": "attached_subtree"
    },
    "taskId": {
      "type": "string"
    }
  },
  "required": [
    "taskId"
  ],
  "$defs": {
    "TaskCancelScope": {
      "type": "string",
      "enum": [
        "task_only",
        "attached_subtree",
        "full_subtree"
      ]
    }
  }
}