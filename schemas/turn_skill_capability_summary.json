{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnSkillCapabilitySummary",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "pack": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnSkillPackPresentationSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "skillId": {
      "$ref": "#/$defs/SkillId"
    },
    "slug": {
      "type": "string"
    },
    "sourceKind": {
      "type": "string"
    }
  },
  "required": [
    "skillId",
    "label",
    "slug",
    "sourceKind"
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TurnSkillPackPresentationSummary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "packId": {
          "$ref": "#/$defs/SkillPackId"
        }
      },
      "required": [
        "packId",
        "label"
      ]
    }
  }
}