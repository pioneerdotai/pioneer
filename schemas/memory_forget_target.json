{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryForgetTarget",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "id"
        },
        "memory_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "memory_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "scoped_key"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        }
      },
      "required": [
        "kind",
        "scope",
        "key"
      ]
    }
  ],
  "$defs": {
    "MemoryScope": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryScopeKind"
        }
      },
      "required": [
        "kind",
        "key"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    }
  }
}