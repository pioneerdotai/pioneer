{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayThreadEpisodicSettings",
  "type": "object",
  "properties": {
    "default_max_candidates": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "default_prompt_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "index_batch_limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "indexing_enabled": {
      "type": "boolean"
    },
    "max_attempts": {
      "type": "integer",
      "format": "int64"
    },
    "max_candidate_work": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_hit_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_prompt_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_segments": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "min_relevancy": {
      "type": "number",
      "format": "float"
    },
    "min_results": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "near_capacity_percent": {
      "type": "number",
      "format": "double"
    },
    "recall_enabled": {
      "type": "boolean"
    },
    "retry_base_delay_secs": {
      "type": "integer",
      "format": "int64"
    },
    "retry_max_delay_secs": {
      "type": "integer",
      "format": "int64"
    },
    "snippet_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "enabled",
    "indexing_enabled",
    "recall_enabled",
    "default_prompt_chars",
    "max_prompt_chars",
    "max_hit_chars",
    "default_max_candidates",
    "max_candidate_work",
    "max_segments",
    "min_relevancy",
    "min_results",
    "snippet_chars",
    "index_batch_limit",
    "retry_base_delay_secs",
    "retry_max_delay_secs",
    "max_attempts",
    "near_capacity_percent"
  ]
}