{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayThreadEpisodicSettings",
  "type": "object",
  "properties": {
    "default_max_candidates": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "default_prompt_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "index_batch_limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "indexing_enabled": {
      "type": "boolean"
    },
    "max_attempts": {
      "type": "integer",
      "format": "int64"
    },
    "max_candidate_work": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_hit_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_prompt_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_segments": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "min_relevancy": {
      "type": "number",
      "format": "float"
    },
    "min_results": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "near_capacity_percent": {
      "type": "number",
      "format": "double"
    },
    "recall_enabled": {
      "type": "boolean"
    },
    "retry_base_delay_secs": {
      "type": "integer",
      "format": "int64"
    },
    "retry_max_delay_secs": {
      "type": "integer",
      "format": "int64"
    },
    "snippet_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "vector_search": {
      "$ref": "#/$defs/GatewayThreadEpisodicVectorSearchSettings",
      "default": {
        "embedding_normalized": true,
        "enabled": false,
        "local_model_status": "not_selected",
        "provider_key": {
          "present": false,
          "required": false
        },
        "refill_status": "disabled"
      }
    }
  },
  "required": [
    "enabled",
    "indexing_enabled",
    "recall_enabled",
    "default_prompt_chars",
    "max_prompt_chars",
    "max_hit_chars",
    "default_max_candidates",
    "max_candidate_work",
    "max_segments",
    "min_relevancy",
    "min_results",
    "snippet_chars",
    "index_batch_limit",
    "retry_base_delay_secs",
    "retry_max_delay_secs",
    "max_attempts",
    "near_capacity_percent"
  ],
  "$defs": {
    "GatewayThreadEpisodicVectorLocalModelStatus": {
      "type": "string",
      "enum": [
        "not_selected",
        "unknown",
        "missing",
        "downloading",
        "installed",
        "failed"
      ]
    },
    "GatewayThreadEpisodicVectorProvider": {
      "type": "string",
      "enum": [
        "openai",
        "openrouter",
        "local"
      ]
    },
    "GatewayThreadEpisodicVectorProviderKeyStatus": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean",
          "default": false
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "GatewayThreadEpisodicVectorRefillStatus": {
      "type": "string",
      "enum": [
        "disabled",
        "unknown",
        "required",
        "running",
        "complete",
        "failed"
      ]
    },
    "GatewayThreadEpisodicVectorSearchSettings": {
      "type": "object",
      "properties": {
        "embedding_dimension": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "embedding_normalized": {
          "type": "boolean",
          "default": true
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "local_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_model_status": {
          "$ref": "#/$defs/GatewayThreadEpisodicVectorLocalModelStatus",
          "default": "not_selected"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayThreadEpisodicVectorProvider"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_key": {
          "$ref": "#/$defs/GatewayThreadEpisodicVectorProviderKeyStatus",
          "default": {
            "present": false,
            "required": false
          }
        },
        "refill_status": {
          "$ref": "#/$defs/GatewayThreadEpisodicVectorRefillStatus",
          "default": "disabled"
        },
        "use_search_instructions": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
