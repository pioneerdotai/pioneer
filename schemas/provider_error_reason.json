{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderErrorReason",
  "description": "Allowlisted provider error reasons, never raw provider messages or values.\nDiagnostic only: these values must not drive recovery policy.",
  "type": "string",
  "enum": [
    "context_length_exceeded",
    "max_tokens_exceeded",
    "token_limit_exceeded",
    "string_too_long",
    "missing_required_parameter",
    "unsupported_parameter",
    "invalid_parameter_value",
    "invalid_parameter_type",
    "responses_missing_required_item",
    "responses_unpaired_tool_call",
    "authentication",
    "permission_denied",
    "payment_required",
    "rate_limit_exceeded",
    "provider_overloaded",
    "provider_unavailable",
    "invalid_request",
    "invalid_prompt",
    "not_found",
    "precondition_failed",
    "payload_too_large",
    "unprocessable",
    "content_policy_violation",
    "refusal",
    "invalid_image",
    "image_too_large",
    "image_too_small",
    "unsupported_image_format",
    "image_not_found",
    "image_download_failed",
    "server",
    "timeout",
    "unmapped"
  ]
}