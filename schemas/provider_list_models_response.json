{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderListModelsResponse",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderModelInfo"
      }
    },
    "provider": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "models"
  ],
  "$defs": {
    "ProviderContextTiers": {
      "description": "Authority-scoped, normalized context choices. Absence on a discovery DTO means unavailable metadata, distinct from a confirmed model without tiers.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "no_tiers"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "excluded"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "invalid"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "tiered"
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            },
            "price_order_confirmed": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "windows",
            "price_order_confirmed"
          ]
        }
      ]
    },
    "ProviderModelCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fine_tuning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "json_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelReasoningCapabilities"
            },
            {
              "type": "null"
            }
          ]
        },
        "streaming": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transcription": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderModelInfo": {
      "type": "object",
      "properties": {
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderModelCapabilities"
        },
        "context_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_tiers": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderContextTiers"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lifecycle_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "$ref": "#/$defs/ProviderModelLimits"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "owned_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelPricing"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "transcription": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderTranscriptionModelMetadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "limits",
        "capabilities"
      ]
    },
    "ProviderModelLimits": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "ProviderModelPricing": {
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "request": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "ProviderModelReasoningCapabilities": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningCapabilitySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_token_budget": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderTranscriptionModelMetadata": {
      "type": "object",
      "properties": {
        "accuracy_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "download_size_mb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "engine": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        },
        "speed_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "supported_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_language_selection": {
          "type": "boolean"
        },
        "supports_translation": {
          "type": "boolean"
        }
      },
      "required": [
        "engine",
        "download_size_mb",
        "accuracy_score",
        "speed_score",
        "supports_translation",
        "supported_languages",
        "supports_language_selection",
        "recommended"
      ]
    },
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "config_override",
        "unknown"
      ]
    }
  }
}
