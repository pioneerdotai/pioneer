{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderListModelsResponse",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderModelInfo"
      }
    },
    "provider": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "models"
  ],
  "$defs": {
    "OpenAiTier": {
      "type": "string",
      "enum": [
        "priority",
        "flex",
        "ultrafast"
      ]
    },
    "ProviderContextTiers": {
      "description": "Authority-scoped, normalized context choices. Absence on a discovery DTO\nmeans unavailable metadata, distinct from a confirmed model without tiers.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "no_tiers"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "excluded"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "invalid"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "price_order_confirmed": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "const": "tiered"
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          },
          "required": [
            "status",
            "windows",
            "price_order_confirmed"
          ]
        }
      ]
    },
    "ProviderModelCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fine_tuning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "json_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelReasoningCapabilities"
            },
            {
              "type": "null"
            }
          ]
        },
        "streaming": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transcription": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderModelInfo": {
      "type": "object",
      "properties": {
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderModelCapabilities"
        },
        "context_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_tiers": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderContextTiers"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lifecycle_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "$ref": "#/$defs/ProviderModelLimits"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "owned_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelPricing"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "service_modes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceServiceModes"
            },
            {
              "type": "null"
            }
          ]
        },
        "transcription": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderTranscriptionModelMetadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "limits",
        "capabilities"
      ]
    },
    "ProviderModelLimits": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "ProviderModelPricing": {
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "request": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "ProviderModelReasoningCapabilities": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningCapabilitySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_token_budget": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderTranscriptionModelMetadata": {
      "type": "object",
      "properties": {
        "accuracy_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "download_size_mb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "engine": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        },
        "speed_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "supported_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_language_selection": {
          "type": "boolean"
        },
        "supports_translation": {
          "type": "boolean"
        }
      },
      "required": [
        "engine",
        "download_size_mb",
        "accuracy_score",
        "speed_score",
        "supports_translation",
        "supported_languages",
        "supports_language_selection",
        "recommended"
      ]
    },
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "config_override",
        "unknown"
      ]
    },
    "ServiceModeDescriptor": {
      "description": "Retains conditional/partial source prices without flattening context bands\nor treating absent prices as Standard. Pricing must prove applicability\nbefore passing these rates to the existing estimator.",
      "type": "object",
      "properties": {
        "cost": true,
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ServiceModeParameters"
        },
        "source_api": {
          "type": "string"
        },
        "source_model": {
          "type": "string"
        },
        "source_provider": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "parameters",
        "source_provider",
        "source_model",
        "source_api"
      ]
    },
    "ServiceModeParameters": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "neutral"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_ai_standard"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "anthropic_standard"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bedrock_standard"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_ai_tier"
            },
            "tier": {
              "$ref": "#/$defs/OpenAiTier"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "tier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_ai_pro"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "beta": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "anthropic_fast"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bedrock_nested_ultrafast"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SourceServiceMode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "descriptor": {
              "$ref": "#/$defs/ServiceModeDescriptor"
            },
            "status": {
              "type": "string",
              "const": "parsed"
            }
          },
          "required": [
            "status",
            "descriptor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "malformed"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "Preserve the source ID so a saved choice cannot silently become Standard.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unmapped"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "SourceServiceModes": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "malformed"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "An explicitly empty map is distinct from unknown metadata.",
          "type": "object",
          "properties": {
            "modes": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/SourceServiceMode"
              }
            },
            "status": {
              "type": "string",
              "const": "known"
            }
          },
          "required": [
            "status",
            "modes"
          ]
        }
      ]
    }
  }
}