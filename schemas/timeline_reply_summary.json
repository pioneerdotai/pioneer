{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineReplySummary",
  "type": "object",
  "properties": {
    "author": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnAuthorSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "deleted": {
      "type": "boolean",
      "default": false
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "turnId"
  ],
  "$defs": {
    "PersistedActorRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TurnAuthorSnapshot": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/PersistedActorRef"
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        }
      },
      "required": [
        "actor",
        "display_name",
        "nickname"
      ]
    }
  }
}