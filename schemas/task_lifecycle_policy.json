{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskLifecyclePolicy",
  "type": "object",
  "properties": {
    "attachment": {
      "$ref": "#/$defs/TaskAttachmentMode"
    },
    "completion": {
      "$ref": "#/$defs/TaskCompletionBehavior"
    },
    "onParentCancel": {
      "$ref": "#/$defs/TaskParentTerminalAction"
    },
    "onParentFailure": {
      "$ref": "#/$defs/TaskParentTerminalAction"
    }
  },
  "required": [
    "attachment",
    "onParentCancel",
    "onParentFailure",
    "completion"
  ],
  "$defs": {
    "TaskAttachmentMode": {
      "type": "string",
      "enum": [
        "attached",
        "detached"
      ]
    },
    "TaskCompletionBehavior": {
      "type": "string",
      "enum": [
        "complete_on_terminal_run",
        "keep_active_for_recurring",
        "manual"
      ]
    },
    "TaskParentTerminalAction": {
      "type": "string",
      "enum": [
        "cancel",
        "detach",
        "keep_running"
      ]
    }
  }
}