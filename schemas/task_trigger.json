{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskTrigger",
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "lastFireAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "nextFireAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "spec": {
      "$ref": "#/$defs/TaskTriggerSpec"
    },
    "status": {
      "$ref": "#/$defs/TaskTriggerStatus"
    },
    "taskId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "id",
    "taskId",
    "status",
    "spec",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "TaskDependencyTriggerMode": {
      "type": "string",
      "enum": [
        "all_succeeded",
        "any_succeeded",
        "all_terminal"
      ]
    },
    "TaskDependencyTriggerPolicy": {
      "type": "object",
      "properties": {
        "dependsOnTaskIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/TaskDependencyTriggerMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TaskExternalTriggerFilter": {
      "type": "object",
      "properties": {
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TaskValue"
          },
          "default": {}
        }
      }
    },
    "TaskManualActor": {
      "type": "string",
      "enum": [
        "owner",
        "workspace_member",
        "system",
        "any"
      ]
    },
    "TaskTriggerCatchUpMode": {
      "type": "string",
      "enum": [
        "run_once_for_latest_missed",
        "skip_missed",
        "run_all_missed"
      ]
    },
    "TaskTriggerCatchUpPolicy": {
      "type": "object",
      "properties": {
        "maxCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskTriggerCatchUpMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TaskTriggerSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "immediate"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catch_up_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskTriggerCatchUpPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "scheduled_at"
            },
            "scheduled_at": {
              "type": "integer",
              "format": "int64"
            },
            "timezone": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "scheduled_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catch_up_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskTriggerCatchUpPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "interval_anchor_at": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "interval_seconds": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "interval"
            }
          },
          "required": [
            "kind",
            "interval_seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catch_up_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskTriggerCatchUpPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cron_expr": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "cron"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cron_expr",
            "timezone"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allowed_actor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskManualActor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "filter": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskExternalTriggerFilter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "external"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dependency"
            },
            "policy": {
              "$ref": "#/$defs/TaskDependencyTriggerPolicy"
            }
          },
          "required": [
            "kind",
            "policy"
          ]
        }
      ]
    },
    "TaskTriggerStatus": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "exhausted",
        "cancelled"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}