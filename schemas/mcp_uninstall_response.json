{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpUninstallResponse",
  "type": "object",
  "properties": {
    "audit": {
      "$ref": "#/$defs/McpLifecycleAuditSummary"
    },
    "name": {
      "type": "string"
    },
    "removed": {
      "type": "boolean"
    },
    "scope_kind": {
      "$ref": "#/$defs/McpScopeKind"
    },
    "server_id": {
      "type": "string"
    }
  },
  "required": [
    "removed",
    "server_id",
    "name",
    "scope_kind",
    "audit"
  ],
  "$defs": {
    "McpLifecycleAuditSummary": {
      "type": "object",
      "properties": {
        "events_written": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "events_written"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    }
  }
}