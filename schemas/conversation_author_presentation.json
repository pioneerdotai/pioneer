{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationAuthorPresentation",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "principal"
        },
        "value": {
          "$ref": "#/$defs/PrincipalAuthorSnapshot"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "value": {
          "$ref": "#/$defs/ClientAgentPresentationSnapshot"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "system"
        },
        "value": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            }
          },
          "required": [
            "label"
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ]
    }
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "AgentIdentityStatus": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    },
    "ClientAgentPresentationSnapshot": {
      "type": "object",
      "properties": {
        "agentExecutionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "agentIdentityId": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "avatarRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "roleLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceKind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "sourceRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/AgentIdentityStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "agentIdentityId",
        "agentExecutionId",
        "sourceKind",
        "sourceRevision",
        "displayName",
        "nickname",
        "status"
      ]
    },
    "PrincipalAuthorSnapshot": {
      "type": "object",
      "properties": {
        "avatarRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "principalId": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "additionalProperties": false,
      "required": [
        "principalId",
        "displayName",
        "nickname"
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}