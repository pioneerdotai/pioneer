{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStartParams",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnCapability"
      }
    },
    "input": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/UserInput"
      }
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "sandbox_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/SandboxPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "turn_id"
  ],
  "$defs": {
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SandboxMode": {
      "type": "string",
      "enum": [
        "FullAccess"
      ]
    },
    "SandboxPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/SandboxMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TextElement": {
      "type": "object",
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_range"
      ]
    },
    "ThreadMode": {
      "type": "string",
      "enum": [
        "Chat",
        "Agent"
      ]
    },
    "TurnCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TurnCapabilityKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "TurnCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "sourceKind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "slug",
            "sourceKind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "scopeKind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "type": {
              "type": "string",
              "const": "mcpServer"
            }
          },
          "required": [
            "type",
            "name",
            "scopeKind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rawToolName": {
              "type": "string"
            },
            "scopeKind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "serverName": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mcpTool"
            }
          },
          "required": [
            "type",
            "serverName",
            "rawToolName",
            "scopeKind"
          ]
        }
      ]
    },
    "UserInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "textElements": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TextElement"
              }
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localImage"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localFile"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "audio"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localAudio"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "video"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localVideo"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "versionId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "artifactId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        }
      ]
    }
  }
}