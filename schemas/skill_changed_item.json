{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillChangedItem",
  "type": "object",
  "properties": {
    "change_type": {
      "type": "string"
    },
    "fingerprint_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "fingerprint_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_id": {
      "$ref": "#/$defs/SkillId"
    },
    "slug": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "slug",
    "source_kind",
    "change_type"
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}