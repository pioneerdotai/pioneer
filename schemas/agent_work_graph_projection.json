{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentWorkGraphProjection",
  "type": "object",
  "properties": {
    "nodes": {
      "description": "Stable, bounded nodes in the exact root graph. No prompt, provider,\nmodel, thread title, runtime path, or other private payload is exposed.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkNodeProjection"
      }
    },
    "queuedCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "rootExecutionId": {
      "$ref": "#/$defs/AgentExecutionId"
    },
    "runningCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "saturated": {
      "description": "True while one or more authorized nodes are durably queued for\nserver-owned capacity. This is resource state, not an authorization\nfailure and never implies that the whole graph is blocked.",
      "type": "boolean"
    },
    "terminalCount": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "updatedAtUnixMicros": {
      "description": "Monotonic persisted resource-state timestamp used only to reject stale\ngraph projections racing with live queue/promotion/finalization events.",
      "type": "integer",
      "format": "int64"
    }
  },
  "additionalProperties": false,
  "required": [
    "rootExecutionId",
    "updatedAtUnixMicros",
    "queuedCount",
    "runningCount",
    "terminalCount",
    "saturated",
    "nodes"
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentWorkNodeProjection": {
      "type": "object",
      "properties": {
        "executionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "progressLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/AgentWorkNodeState"
        }
      },
      "additionalProperties": false,
      "required": [
        "executionId",
        "state",
        "progressRevision"
      ]
    },
    "AgentWorkNodeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    }
  }
}