{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderFailureDetails",
  "type": "object",
  "properties": {
    "class": {
      "$ref": "#/$defs/ProviderFailureClass"
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "is_recoverable_hint": {
      "type": "boolean"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_after_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "stage": {
      "$ref": "#/$defs/ProviderFailureStage"
    },
    "transport": {
      "$ref": "#/$defs/ProviderTransportKind"
    }
  },
  "required": [
    "provider",
    "model",
    "transport",
    "class",
    "stage",
    "is_recoverable_hint"
  ],
  "$defs": {
    "ProviderFailureClass": {
      "type": "string",
      "enum": [
        "network_transient",
        "rate_limit",
        "provider_5xx",
        "auth_expired",
        "model_not_found",
        "prompt_too_long",
        "max_output_tokens",
        "stream_stall",
        "stream_truncated",
        "empty_response",
        "invalid_request",
        "permission_denied",
        "unknown"
      ]
    },
    "ProviderFailureStage": {
      "type": "string",
      "enum": [
        "connect",
        "first_chunk",
        "mid_stream",
        "finalize"
      ]
    },
    "ProviderTransportKind": {
      "type": "string",
      "enum": [
        "stream",
        "non_stream",
        "ws",
        "sse"
      ]
    }
  }
}