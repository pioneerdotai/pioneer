{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsPolicyListResponse",
  "type": "object",
  "properties": {
    "policies": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillWorkspacePolicy"
      }
    }
  },
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillWorkspacePolicy": {
      "type": "object",
      "properties": {
        "allow_implicit_invocation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_id": {
          "$ref": "#/$defs/SkillId"
        },
        "slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "skill_id",
        "slug",
        "source_kind"
      ]
    }
  }
}