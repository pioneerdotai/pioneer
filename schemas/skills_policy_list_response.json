          "type": [
            "boolean",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "skill_slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      }
    }
  }
}