{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillInstallState",
  "type": "object",
  "properties": {
    "install_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "installed": {
      "type": "boolean"
    },
    "lifecycle_editable": {
      "type": "boolean",
      "default": true
    },
    "managed": {
      "type": "boolean"
    },
    "updated_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    }
  },
  "required": [
    "managed",
    "installed"
  ]
}