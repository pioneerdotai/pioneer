{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillInstallState",
  "type": "object",
  "required": [
    "installed",
    "managed"
  ],
  "properties": {
    "install_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "installed": {
      "type": "boolean"
    },
    "managed": {
      "type": "boolean"
    },
    "updated_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    }
  }
}