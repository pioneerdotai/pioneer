{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineBlock",
  "type": "object",
  "properties": {
    "blockId": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/TimelineBlockKind"
    },
    "sortKey": {
      "type": "string"
    },
    "startedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAtUnixMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "workspaceId",
    "threadId",
    "blockId",
    "sortKey",
    "kind"
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "AgentPresentationSnapshot": {
      "type": "object",
      "properties": {
        "agent_execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "agent_identity_id": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "identity_source_kind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "identity_source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nickname": {
          "type": "string"
        },
        "role_label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent_identity_id",
        "agent_execution_id",
        "identity_source_kind",
        "identity_source_revision",
        "display_name",
        "nickname"
      ]
    },
    "AgentResultReturnPolicy": {
      "type": "string",
      "enum": [
        "none",
        "summary_only",
        "full_result"
      ]
    },
    "AgentRouteAction": {
      "type": "string",
      "enum": [
        "send_message",
        "start_agent",
        "create_task",
        "schedule_task",
        "review_task_result",
        "deliver_result"
      ]
    },
    "AgentRouteDisclosurePolicy": {
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Exact, already-authorized artifact handles. Raw files and paths are\nnever represented by this flag.",
          "type": "boolean",
          "default": false
        },
        "context": {
          "description": "Bounded conversation excerpts or summaries selected by server policy.",
          "type": "boolean",
          "default": false
        },
        "resultReturn": {
          "description": "Result return is a separate disclosure class: allowing ordinary text\nmust never imply that a full Task result can cross a capsule boundary.",
          "$ref": "#/$defs/AgentResultReturnPolicy",
          "default": "none"
        },
        "text": {
          "description": "Explicit text authored for the routed operation.",
          "type": "boolean",
          "default": false
        },
        "userInput": {
          "description": "Explicit user-provided Task inputs. This is deliberately independent\nfrom Agent-authored text and inherited conversation context.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "AgentWorkGraphProjection": {
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Stable, bounded nodes in the exact root graph. No prompt, provider,\nmodel, thread title, runtime path, or other private payload is exposed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentWorkNodeProjection"
          }
        },
        "queuedCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rootExecutionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "runningCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "saturated": {
          "description": "True while one or more authorized nodes are durably queued for\nserver-owned capacity. This is resource state, not an authorization\nfailure and never implies that the whole graph is blocked.",
          "type": "boolean"
        },
        "terminalCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAtUnixMicros": {
          "description": "Monotonic persisted resource-state timestamp used only to reject stale\ngraph projections racing with live queue/promotion/finalization events.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "rootExecutionId",
        "updatedAtUnixMicros",
        "queuedCount",
        "runningCount",
        "terminalCount",
        "saturated",
        "nodes"
      ]
    },
    "AgentWorkNodeProjection": {
      "type": "object",
      "properties": {
        "executionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "progressLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/AgentWorkNodeState"
        }
      },
      "additionalProperties": false,
      "required": [
        "executionId",
        "state",
        "progressRevision"
      ]
    },
    "AgentWorkNodeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "CLIRuntimePendingRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CLIRuntimeRequestKind"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": true,
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "CLIRuntimePendingRequestStatus": {
      "type": "string",
      "enum": [
        "pending",
        "response_accepted",
        "delivering",
        "delivery_failed",
        "answered",
        "resolved",
        "cancelled",
        "expired"
      ]
    },
    "CLIRuntimeRequestKind": {
      "type": "string",
      "enum": [
        "command_approval",
        "file_change_approval",
        "user_input",
        "other"
      ]
    },
    "CrossThreadSourceVisibility": {
      "type": "string",
      "enum": [
        "accessible",
        "inaccessible"
      ]
    },
    "MarkdownBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            }
          },
          "$ref": "#/$defs/MarkdownInline",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/MarkdownInline"
            },
            "level": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "heading"
            }
          },
          "required": [
            "type",
            "level",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            }
          },
          "$ref": "#/$defs/MarkdownList",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarkdownBlock"
              }
            },
            "type": {
              "type": "string",
              "const": "quote"
            }
          },
          "required": [
            "type",
            "blocks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rule"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "MarkdownDocument": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownBlock"
          }
        }
      }
    },
    "MarkdownInline": {
      "type": "object",
      "properties": {
        "marks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownMark"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "MarkdownList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownListItem"
          }
        },
        "ordered": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "ordered",
        "start"
      ]
    },
    "MarkdownListItem": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownBlock"
          }
        },
        "checked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "MarkdownMark": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/MarkdownMarkKind"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ]
    },
    "MarkdownMarkKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bold"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "italic"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strike"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "PersistedActorRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentExecutionId"
            },
            "kind": {
              "type": "string",
              "const": "agent_execution"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SafeRouteProvenance": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AgentRouteAction"
        },
        "disclosure": {
          "$ref": "#/$defs/AgentRouteDisclosurePolicy"
        },
        "sourceThreadLabel": {
          "description": "Present only when the viewer has source read authority.  Source title,\nparticipants, prompts, and raw identifiers are never sent otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/CrossThreadSourceVisibility"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "visibility",
        "disclosure"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TaskAttachmentMode": {
      "type": "string",
      "enum": [
        "attached",
        "detached"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "waiting_review",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "TaskTriggerKind": {
      "type": "string",
      "enum": [
        "immediate",
        "scheduled_at",
        "interval",
        "cron",
        "manual",
        "external",
        "dependency"
      ]
    },
    "TaskTurnItem": {
      "type": "object",
      "properties": {
        "agentRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "attachment": {
          "$ref": "#/$defs/TaskAttachmentMode",
          "default": "attached"
        },
        "childThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "childTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "createdByTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "format": "int64"
        },
        "errorPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "id": {
          "type": "string"
        },
        "maxDepth": {
          "type": "integer",
          "format": "int64"
        },
        "nextFireAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "taskId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "triggerKind": {
          "$ref": "#/$defs/TaskTriggerKind"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "title",
        "status",
        "triggerKind",
        "executorKind",
        "depth",
        "maxDepth",
        "createdAt",
        "updatedAt"
      ]
    },
    "TextElement": {
      "type": "object",
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_range"
      ]
    },
    "ThreadMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Message",
            "Agent"
          ]
        },
        {
          "description": "Compatibility default for pre-Epic-6 persisted and wire values. New\nuser-thread creation selects `Message` explicitly.",
          "type": "string",
          "const": "Chat"
        }
      ]
    },
    "TimelineBlockKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "attachments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UserMessageAttachment"
              }
            },
            "author": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TurnAuthorSnapshot"
                },
                {
                  "type": "null"
                }
              ]
            },
            "deleted": {
              "type": "boolean",
              "default": false
            },
            "edited": {
              "type": "boolean",
              "default": false
            },
            "inputs": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/UserInput"
              }
            },
            "itemId": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "user_message"
            },
            "mentions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TurnMention"
              }
            },
            "mode": {
              "$ref": "#/$defs/ThreadMode",
              "default": "Chat"
            },
            "reply": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TimelineReplySummary"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
