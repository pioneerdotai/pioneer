{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentStartOptionsProjection",
  "type": "object",
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentIdentityProjection"
      }
    },
    "allowedMcpServerIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "allowedSkillIds": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillId"
      }
    },
    "derivedEphemeralAvailable": {
      "type": "boolean"
    },
    "generationFingerprint": {
      "type": "string"
    },
    "inheritParentAgentAvailable": {
      "type": "boolean"
    },
    "inheritParentProfileAvailable": {
      "type": "boolean"
    },
    "maxPermissionProfile": {
      "$ref": "#/$defs/TurnPermissionProfileCap"
    },
    "profiles": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentExecutionProfileProjection"
      }
    }
  },
  "required": [
    "agents",
    "inheritParentAgentAvailable",
    "derivedEphemeralAvailable",
    "inheritParentProfileAvailable",
    "maxPermissionProfile",
    "generationFingerprint"
  ],
  "$defs": {
    "AgentExecutionProfileBackend": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "api_provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cli_runtime": {
              "type": "object",
              "properties": {
                "runtime_instance_id": {
                  "type": "string"
                }
              },
              "required": [
                "runtime_instance_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "cli_runtime"
          ]
        },
        {
          "type": "object",
          "properties": {
            "acp_agent_runtime": {
              "type": "object",
              "properties": {
                "runtime_id": {
                  "type": "string"
                }
              },
              "required": [
                "runtime_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "acp_agent_runtime"
          ]
        }
      ]
    },
    "AgentExecutionProfileId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionProfileProjection": {
      "type": "object",
      "properties": {
        "allowedPermissionProfiles": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnPermissionMode"
          }
        },
        "allowedReasoning": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnReasoningSelection"
          }
        },
        "backend": {
          "$ref": "#/$defs/AgentExecutionProfileBackend"
        },
        "catalogGeneration": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "compatibleAgentIdentityIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentIdentityId"
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentExecutionProfileId"
        },
        "modelDisplayName": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "policyGeneration": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "providerDisplayName": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "compatibleAgentIdentityIds",
        "backend",
        "providerId",
        "modelId",
        "providerDisplayName",
        "modelDisplayName",
        "catalogGeneration",
        "policyGeneration",
        "fingerprint"
      ]
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityProjection": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "nickname": {
          "type": "string"
        },
        "role_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_fingerprint": {
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "source_kind",
        "display_name",
        "nickname",
        "source_revision",
        "source_fingerprint"
      ]
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileCap": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode",
        "effective_policy"
      ]
    },
    "TurnReasoningSelection": {
      "type": "object",
      "properties": {
        "effort": {
          "description": "String-valued because CLI runtimes may advertise efforts newer than\nPioneer API-provider adapters understand.",
          "type": "string"
        }
      },
      "required": [
        "effort"
      ]
    }
  }
}