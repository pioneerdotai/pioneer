{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpChangedItem",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/McpChangedAction"
    },
    "name": {
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/McpSourceKind"
    }
  },
  "required": [
    "name",
    "source_kind",
    "action"
  ],
  "$defs": {
    "McpChangedAction": {
      "type": "string",
      "enum": [
        "install",
        "policy",
        "update",
        "uninstall"
      ]
    },
    "McpSourceKind": {
      "type": "string",
      "enum": [
        "config"
      ]
    }
  }
}