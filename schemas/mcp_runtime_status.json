{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpRuntimeStatus",
  "type": "object",
  "properties": {
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_seen_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "live": {
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/McpRuntimeState"
    }
  },
  "required": [
    "state",
    "live"
  ],
  "$defs": {
    "McpRuntimeState": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    }
  }
}