{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentWorkNodeProjection",
  "type": "object",
  "properties": {
    "executionId": {
      "$ref": "#/$defs/AgentExecutionId"
    },
    "progressLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "progressRevision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/AgentWorkNodeState"
    }
  },
  "additionalProperties": false,
  "required": [
    "executionId",
    "state",
    "progressRevision"
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentWorkNodeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    }
  }
}