{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsUninstallResponse",
  "type": "object",
  "properties": {
    "audit": {
      "$ref": "#/$defs/SkillLifecycleAuditSummary"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "removed_install_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_id": {
      "$ref": "#/$defs/SkillId"
    },
    "slug": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "skill_id",
    "slug",
    "source_kind",
    "audit"
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillLifecycleAuditSummary": {
      "type": "object",
      "properties": {
        "events_written": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "events_written"
      ]
    }
  }
}