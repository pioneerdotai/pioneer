{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRegisterResponse",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "mimeType": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": "string"
    },
    "sizeBytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "versionId": {
      "type": "string"
    }
  },
  "required": [
    "artifactId",
    "versionId",
    "displayName",
    "kind",
    "sizeBytes",
    "sha256"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    }
  }
}