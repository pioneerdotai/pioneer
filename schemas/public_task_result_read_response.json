{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskResultReadResponse",
  "type": "object",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/PublicTaskResultCandidate"
    },
    "reviewContent": {
      "$ref": "#/$defs/PublicTaskReviewContent"
    }
  },
  "required": [
    "candidate",
    "reviewContent"
  ],
  "$defs": {
    "PublicTaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicTaskArtifact"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskResultCandidate": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "round": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskResultCandidateStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "taskId",
        "runId",
        "round",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskReviewContent": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "contentSha256": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/PublicTaskReviewContentFormat"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "totalBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "content",
        "totalBytes",
        "contentSha256",
        "truncated"
      ]
    },
    "PublicTaskReviewContentFormat": {
      "description": "Reviewer-facing content extracted from one immutable result candidate.\n\nThis is deliberately separate from `TaskResult::data`: the persisted value\nmay also contain extraction diagnostics and source-runtime identifiers that\nare not part of the child-authored result.",
      "type": "string",
      "enum": [
        "text",
        "json"
      ]
    },
    "TaskResultCandidateStatus": {
      "type": "string",
      "enum": [
        "pending_review",
        "accepted",
        "rejected",
        "superseded",
        "extraction_failed",
        "cancelled"
      ]
    }
  }
}