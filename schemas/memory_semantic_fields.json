{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemorySemanticFields",
  "type": "object",
  "properties": {
    "attribute": {
      "$ref": "#/$defs/MemoryAttribute"
    },
    "category": {
      "$ref": "#/$defs/MemoryCategory"
    },
    "certainty": {
      "$ref": "#/$defs/MemoryExtractorCertainty"
    },
    "custom_attribute": {
      "type": [
        "string",
        "null"
      ]
    },
    "custom_subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "durability": {
      "$ref": "#/$defs/MemoryDurability"
    },
    "explicitness": {
      "$ref": "#/$defs/MemoryExplicitness"
    },
    "intent": {
      "$ref": "#/$defs/MemoryIntent"
    },
    "scope_hint": {
      "$ref": "#/$defs/MemoryScopeHint"
    },
    "sensitivity": {
      "$ref": "#/$defs/MemorySensitivityHint"
    },
    "subject": {
      "$ref": "#/$defs/MemorySubject"
    },
    "subject_key": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "intent",
    "explicitness",
    "category",
    "subject",
    "attribute",
    "scope_hint",
    "durability",
    "sensitivity",
    "certainty"
  ],
  "$defs": {
    "MemoryAttribute": {
      "type": "string",
      "enum": [
        "name",
        "birthday",
        "preferred_language",
        "communication_style",
        "migration_policy",
        "review_style",
        "phase_naming",
        "custom"
      ]
    },
    "MemoryCategory": {
      "type": "string",
      "enum": [
        "identity",
        "preference",
        "biography",
        "relationship",
        "recurring_instruction",
        "project_policy",
        "project_fact",
        "project_decision",
        "procedure",
        "todo",
        "constraint",
        "communication_style",
        "custom"
      ]
    },
    "MemoryDurability": {
      "type": "string",
      "enum": [
        "long_lived",
        "project_lifetime",
        "session_only",
        "transient",
        "unknown"
      ]
    },
    "MemoryExplicitness": {
      "type": "string",
      "enum": [
        "explicit",
        "implicit",
        "none",
        "unclear"
      ]
    },
    "MemoryExtractorCertainty": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "MemoryIntent": {
      "type": "string",
      "enum": [
        "explicit_store",
        "explicit_forget",
        "explicit_no_memory",
        "implicit_candidate",
        "none"
      ]
    },
    "MemoryScopeHint": {
      "type": "string",
      "enum": [
        "user_global",
        "user_workspace",
        "agent_global",
        "agent_workspace",
        "project_workspace",
        "unknown"
      ]
    },
    "MemorySensitivityHint": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "personal",
        "regulated",
        "secret",
        "unknown"
      ]
    },
    "MemorySubject": {
      "type": "string",
      "enum": [
        "current_user",
        "current_agent",
        "workspace",
        "project",
        "person",
        "organization",
        "artifact",
        "custom"
      ]
    }
  }
}