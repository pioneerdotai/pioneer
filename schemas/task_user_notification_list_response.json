{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskUserNotificationListResponse",
  "type": "object",
  "properties": {
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "notifications": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskUserNotification"
      }
    }
  },
  "$defs": {
    "PublicError": {
      "description": "Stable, bounded failure presentation shared by RPC, voice and task\nexecution surfaces. Raw source chains are never part of this type.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PublicErrorCode"
        },
        "correlation_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PublicErrorStage"
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "code",
        "stage",
        "message",
        "retryable",
        "correlation_id"
      ]
    },
    "PublicErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "policy_denied",
        "not_found",
        "conflict",
        "resource_exhausted",
        "unavailable",
        "timeout",
        "internal"
      ]
    },
    "PublicErrorStage": {
      "type": "string",
      "enum": [
        "discovery",
        "admission",
        "preparation",
        "execution",
        "persistence",
        "delivery",
        "observation"
      ]
    },
    "PublicTaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "error": {
          "$ref": "#/$defs/PublicError"
        }
      },
      "required": [
        "class",
        "error"
      ]
    },
    "PublicTaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicTaskArtifact"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskUserNotification": {
      "description": "Durable exact-recipient Task notification returned by the user inbox.\n\nThe websocket notification is only a live invalidation hint. This record is\nthe reconnect-safe source of truth and deliberately contains only the\ncollaborator-safe Task projection.",
      "type": "object",
      "properties": {
        "acknowledgedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "deliveryId": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "notificationId": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "notificationId",
        "workspaceId",
        "taskId",
        "runId",
        "deliveryId",
        "createdAt"
      ]
    }
  }
}