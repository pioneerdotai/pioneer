{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentProgressEvent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "item_delta"
        },
        "notification": {
          "$ref": "#/$defs/ItemDeltaNotification"
        }
      },
      "required": [
        "kind",
        "notification"
      ]
    },
    {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "item_type": {
          "$ref": "#/$defs/TurnItemType"
        },
        "kind": {
          "type": "string",
          "const": "item_heartbeat"
        },
        "source": {
          "$ref": "#/$defs/ItemHeartbeatSource",
          "default": "owner_lease"
        },
        "thread_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workspace_id",
        "thread_id",
        "turn_id",
        "item_id",
        "item_type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "delta": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "tool_output_delta"
        },
        "payload": true,
        "stream": {
          "$ref": "#/$defs/ItemDeltaStream"
        },
        "thread_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workspace_id",
        "thread_id",
        "turn_id",
        "item_id",
        "stream",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "task_progress"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workspace_id",
        "thread_id",
        "turn_id",
        "item_id",
        "task_id",
        "summary"
      ]
    }
  ],
  "$defs": {
    "ItemDeltaNotification": {
      "type": "object",
      "properties": {
        "delta": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkdownDocument"
            },
            {
              "type": "null"
            }
          ]
        },
        "markdown_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "payload": true,
        "stream": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemDeltaStream"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "thread_id",
        "turn_id",
        "item_id",
        "delta"
      ]
    },
    "ItemDeltaStream": {
      "type": "string",
      "enum": [
        "agent_message",
        "stdout",
        "stderr",
        "tool_progress",
        "file_change",
        "generic"
      ]
    },
    "ItemHeartbeatSource": {
      "type": "string",
      "enum": [
        "owner_lease",
        "confirmed_external_activity"
      ]
    },
    "MarkdownBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            }
          },
          "$ref": "#/$defs/MarkdownInline",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/MarkdownInline"
            },
            "level": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "heading"
            }
          },
          "required": [
            "type",
            "level",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            }
          },
          "$ref": "#/$defs/MarkdownList",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarkdownBlock"
              }
            },
            "type": {
              "type": "string",
              "const": "quote"
            }
          },
          "required": [
            "type",
            "blocks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rule"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "MarkdownDocument": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownBlock"
          }
        }
      }
    },
    "MarkdownInline": {
      "type": "object",
      "properties": {
        "marks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownMark"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "MarkdownList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownListItem"
          }
        },
        "ordered": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "ordered",
        "start"
      ]
    },
    "MarkdownListItem": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MarkdownBlock"
          }
        },
        "checked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "MarkdownMark": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/MarkdownMarkKind"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ]
    },
    "MarkdownMarkKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bold"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "italic"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strike"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}