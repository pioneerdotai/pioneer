{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpServerPolicy",
  "type": "object",
  "properties": {
    "allow_implicit_invocation": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "scope_kind": {
      "$ref": "#/$defs/McpScopeKind"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "name",
    "scope_kind",
    "enabled",
    "allow_implicit_invocation"
  ],
  "$defs": {
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    }
  }
}