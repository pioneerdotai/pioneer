{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryProvenance",
  "type": "object",
  "properties": {
    "created_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryActor"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_kind": {
      "$ref": "#/$defs/MemorySourceKind"
    },
    "source_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_turn_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "source_kind"
  ],
  "$defs": {
    "MemoryActor": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MemoryActorKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "MemoryActorKind": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "extractor",
        "system",
        "tool"
      ]
    },
    "MemorySourceKind": {
      "type": "string",
      "enum": [
        "explicit_user_request",
        "user_correction",
        "assistant_inference",
        "background_extractor",
        "tool_observation",
        "import",
        "system"
      ]
    }
  }
}