{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryForgetParams",
  "type": "object",
  "properties": {
    "actor": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryActor"
        },
        {
          "type": "null"
        }
      ]
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "$ref": "#/$defs/MemoryForgetTarget"
    }
  },
  "required": [
    "target"
  ],
  "$defs": {
    "MemoryActor": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MemoryActorKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "MemoryActorKind": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "extractor",
        "system",
        "tool"
      ]
    },
    "MemoryForgetTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "id"
            },
            "memory_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "memory_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "scoped_key"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "$ref": "#/$defs/MemoryScope"
            }
          },
          "required": [
            "kind",
            "scope",
            "key"
          ]
        }
      ]
    },
    "MemoryScope": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryScopeKind"
        }
      },
      "required": [
        "kind",
        "key"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    }
  }
}