{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadsSearchResponse",
  "type": "object",
  "properties": {
    "threads": { "type": "array", "items": { "$ref": "#/$defs/ThreadSearchCard" } },
    "nextCursor": { "type": ["string", "null"] },
    "eof": { "type": "boolean" },
    "limitations": { "$ref": "#/$defs/ThreadsSearchLimitations" }
  },
  "required": ["threads", "eof", "limitations"],
  "additionalProperties": false,
  "$defs": {
    "ThreadSearchCard": {
      "type": "object",
      "properties": {
        "threadId": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "fragments": { "type": "array", "items": { "$ref": "#/$defs/ThreadSearchFragment" } }
      },
      "required": ["threadId", "fragments"],
      "additionalProperties": false
    },
    "ThreadSearchFragment": {
      "type": "object",
      "properties": {
        "snippet": { "type": "string" },
        "source": { "$ref": "#/$defs/ThreadSearchSource" },
        "provenance": { "$ref": "#/$defs/ThreadSearchProvenance" }
      },
      "required": ["snippet", "source", "provenance"],
      "additionalProperties": false
    },
    "ThreadSearchSource": {
      "type": "object",
      "properties": { "threadId": { "type": "string" }, "anchor": { "$ref": "#/$defs/ThreadHistoryAnchor" } },
      "required": ["threadId", "anchor"],
      "additionalProperties": false
    },
    "ThreadHistoryAnchor": {
      "description": "Exact saved source in the requested thread. Omitting itemId anchors the turn.",
      "type": "object",
      "properties": { "turnId": { "type": "string" }, "itemId": { "type": ["string", "null"], "default": null } },
      "required": ["turnId"],
      "additionalProperties": false
    },
    "ThreadSearchProvenance": {
      "type": "object",
      "properties": {
        "actorRole": { "$ref": "#/$defs/ThreadEpisodicSourceActorRole" },
        "sourceContext": { "$ref": "#/$defs/ThreadEpisodicSourceContext" }
      },
      "required": ["actorRole", "sourceContext"],
      "additionalProperties": false
    },
    "ThreadEpisodicSourceActorRole": { "type": "string", "enum": ["user", "assistant", "task_summary", "generated_summary"] },
    "ThreadEpisodicSourceContext": { "type": "string", "enum": ["user_visible_thread_item", "user_visible_task_summary", "thread_compaction_summary", "hidden_prompt", "reasoning_trace", "raw_tool_output", "raw_task_runtime", "internal_hook_runtime", "system_prompt", "developer_prompt", "unknown"] },
    "ThreadsSearchLimitations": {
      "type": "object",
      "properties": {
        "selectionLimited": { "type": "boolean" },
        "coverageLimited": { "type": "boolean" },
        "semanticApproximate": { "type": "boolean" },
        "semanticDegraded": { "type": "boolean" }
      },
      "required": ["selectionLimited", "coverageLimited", "semanticApproximate", "semanticDegraded"],
      "additionalProperties": false
    }
  }
}
