{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAgentReviewPolicy",
  "type": "object",
  "properties": {
    "maxRevisionRounds": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/$defs/TaskAgentReviewMode"
    },
    "requireExplicitAcceptance": {
      "type": "boolean"
    },
    "resolutionStrategy": {
      "$ref": "#/$defs/TaskResultReviewResolutionStrategy"
    },
    "reviewers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskResultReviewerSpec"
      }
    }
  },
  "required": [
    "mode",
    "maxRevisionRounds",
    "requireExplicitAcceptance",
    "resolutionStrategy"
  ],
  "$defs": {
    "TaskAgentReviewMode": {
      "type": "string",
      "enum": [
        "none",
        "parent_agent",
        "parent_agent_with_reviewers",
        "user_approval"
      ]
    },
    "TaskResultReviewResolutionStrategy": {
      "type": "string",
      "enum": [
        "parent_final",
        "user_final",
        "require_all_required_reviewers_then_parent",
        "quorum_then_parent",
        "any_required_reviewer_can_request_changes"
      ]
    },
    "TaskResultReviewerKind": {
      "type": "string",
      "enum": [
        "runtime_auto",
        "parent_agent",
        "review_agent",
        "user",
        "system"
      ]
    },
    "TaskResultReviewerSpec": {
      "type": "object",
      "properties": {
        "agentNickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "reviewerKind": {
          "$ref": "#/$defs/TaskResultReviewerKind"
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "reviewerKind",
        "required"
      ]
    }
  }
}