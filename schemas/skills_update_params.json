{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsUpdateParams",
  "type": "object",
  "properties": {
    "expected_previous_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_id": {
      "$ref": "#/$defs/SkillId"
    },
    "source": {
      "$ref": "#/$defs/SkillLifecycleSource"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "skill_id",
    "source"
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillLifecycleSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "uploaded_archive"
            },
            "upload_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "upload_id"
          ]
        }
      ]
    }
  }
}