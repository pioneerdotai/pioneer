{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemToolRetryScheduledNotification",
  "type": "object",
  "properties": {
    "attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "budgets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolRetryBudgetUsage"
      }
    },
    "error_class": {
      "$ref": "#/$defs/ToolRetryErrorClass"
    },
    "failure_signature_fingerprint": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "reason": {
      "type": "string"
    },
    "retry_hint": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_retry_episode_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "item_id",
    "item_type",
    "tool_retry_episode_id",
    "tool_name",
    "attempt_number",
    "error_class",
    "retry_hint",
    "failure_signature_fingerprint",
    "reason"
  ],
  "$defs": {
    "ToolRetryBudgetKind": {
      "type": "string",
      "enum": [
        "episode",
        "error_class",
        "tool_name",
        "failure_signature"
      ]
    },
    "ToolRetryBudgetUsage": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolRetryBudgetKind"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "used",
        "limit"
      ]
    },
    "ToolRetryErrorClass": {
      "type": "string",
      "enum": [
        "invalid_arguments",
        "not_found",
        "tool_not_visible",
        "permission_denied",
        "command_not_found",
        "timeout",
        "cancelled",
        "execution_failed",
        "needs_narrowing",
        "internal",
        "output_truncated",
        "unknown"
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}