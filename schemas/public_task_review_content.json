{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskReviewContent",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "contentSha256": {
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/PublicTaskReviewContentFormat"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "totalBytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "content",
    "totalBytes",
    "contentSha256",
    "truncated"
  ],
  "$defs": {
    "PublicTaskReviewContentFormat": {
      "description": "Reviewer-facing content extracted from one immutable result candidate.\n\nThis is deliberately separate from `TaskResult::data`: the persisted value\nmay also contain extraction diagnostics and source-runtime identifiers that\nare not part of the child-authored result.",
      "type": "string",
      "enum": [
        "text",
        "json"
      ]
    }
  }
}