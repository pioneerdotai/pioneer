{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptManifestDiagnostic",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/PromptManifestDiagnosticCode"
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "hook_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptManifestHookSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "section_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "code",
    "message"
  ],
  "$defs": {
    "PromptManifestDiagnosticCode": {
      "type": "string",
      "enum": [
        "missing_file",
        "file_read_error",
        "file_truncated",
        "total_budget_truncated",
        "file_filtered_by_profile",
        "dynamic_section_truncated",
        "dynamic_section_omitted",
        "hook_diagnostic",
        "hook_best_effort_failed",
        "capability_rejected"
      ]
    },
    "PromptManifestHookPhase": {
      "type": "string",
      "enum": [
        "turn_pre_prompt_context",
        "turn_post_preflight_prompt_context",
        "turn_pre_prompt_compile"
      ]
    },
    "PromptManifestHookSource": {
      "type": "object",
      "properties": {
        "contribution_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hook_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PromptManifestHookPhase"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "hook_id",
        "subscription_id",
        "phase"
      ]
    }
  }
}