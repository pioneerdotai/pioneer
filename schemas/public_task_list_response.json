{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskListResponse",
  "type": "object",
  "properties": {
    "nextCursor": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "tasks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTask"
      }
    }
  },
  "$defs": {
    "ProviderErrorReason": {
      "description": "Allowlisted OpenRouter Chat Completions metadata.error_type values.\nDiagnostic only: these values must not drive recovery policy.",
      "type": "string",
      "enum": [
        "context_length_exceeded",
        "max_tokens_exceeded",
        "token_limit_exceeded",
        "string_too_long",
        "authentication",
        "permission_denied",
        "payment_required",
        "rate_limit_exceeded",
        "provider_overloaded",
        "provider_unavailable",
        "invalid_request",
        "invalid_prompt",
        "not_found",
        "precondition_failed",
        "payload_too_large",
        "unprocessable",
        "content_policy_violation",
        "refusal",
        "invalid_image",
        "image_too_large",
        "image_too_small",
        "unsupported_image_format",
        "image_not_found",
        "image_download_failed",
        "server",
        "timeout",
        "unmapped"
      ]
    },
    "ProviderFailureClass": {
      "type": "string",
      "enum": [
        "network_transient",
        "rate_limit",
        "provider_5xx",
        "auth_expired",
        "auth_or_permission",
        "model_not_found",
        "prompt_too_long",
        "context_too_large",
        "max_output_tokens",
        "stream_stall",
        "stream_truncated",
        "empty_response",
        "provider_rejected",
        "unsupported_parameter",
        "unsupported_capability",
        "unsupported_image_input",
        "unsupported_tool_calling",
        "unsupported_streaming",
        "malformed_provider_request",
        "invalid_request",
        "permission_denied",
        "unknown"
      ]
    },
    "ProviderFailureStage": {
      "type": "string",
      "enum": [
        "connect",
        "first_chunk",
        "mid_stream",
        "finalize"
      ]
    },
    "ProviderRequestId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(gen-|req-|cmpl-|chatcmpl-)[A-Za-z0-9_-]+$"
    },
    "ProviderTransportKind": {
      "type": "string",
      "enum": [
        "stream",
        "non_stream",
        "ws",
        "sse"
      ]
    },
    "PublicError": {
      "description": "Stable, bounded failure presentation shared by RPC, voice and task\nexecution surfaces. Raw source chains are never part of this type.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PublicErrorCode"
        },
        "correlation_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PublicErrorStage"
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "code",
        "stage",
        "message",
        "retryable",
        "correlation_id"
      ]
    },
    "PublicErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "policy_denied",
        "not_found",
        "conflict",
        "resource_exhausted",
        "unavailable",
        "timeout",
        "internal"
      ]
    },
    "PublicErrorStage": {
      "type": "string",
      "enum": [
        "discovery",
        "admission",
        "preparation",
        "execution",
        "persistence",
        "delivery",
        "observation"
      ]
    },
    "PublicTask": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "createdAt": {
          "type": "integer",
          "format": "int64"
        },
        "createdByThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdByTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "executorKind": {
          "$ref": "#/$defs/TaskExecutorKind"
        },
        "goal": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ownerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerKind": {
          "$ref": "#/$defs/TaskOwnerKind"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer",
          "format": "int64"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "rootTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerKind",
        "executorKind",
        "status",
        "title",
        "goal",
        "priority",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicTaskArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PublicTaskFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/TaskErrorClass"
        },
        "error": {
          "$ref": "#/$defs/PublicError"
        },
        "recoveryDiagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "class",
        "error"
      ]
    },
    "PublicTaskResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicTaskArtifact"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RecoveryDiagnostic": {
      "type": "object",
      "properties": {
        "lastFailure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryProviderFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "stopReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryStopReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RecoveryProviderFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ProviderFailureClass"
        },
        "errorReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderErrorReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "requestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryAfterMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "stage": {
          "$ref": "#/$defs/ProviderFailureStage"
        },
        "transport": {
          "$ref": "#/$defs/ProviderTransportKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "stage",
        "transport"
      ]
    },
    "RecoveryStopReason": {
      "type": "string",
      "enum": [
        "attempts_exhausted",
        "wall_clock_exhausted",
        "no_progress",
        "policy_rejected",
        "terminal_failure"
      ]
    },
    "TaskErrorClass": {
      "type": "string",
      "enum": [
        "cancelled",
        "timeout",
        "provider",
        "tool",
        "validation",
        "dependency",
        "policy",
        "internal",
        "unknown"
      ]
    },
    "TaskExecutorKind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "workflow",
        "webhook",
        "system"
      ]
    },
    "TaskOwnerKind": {
      "type": "string",
      "enum": [
        "user",
        "thread",
        "workspace",
        "system"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "running",
        "waiting",
        "waiting_review",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    }
  }
}