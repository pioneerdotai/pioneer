          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "skill_slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "skill_slug",
        "source_kind"
      ]
    }
  }
}