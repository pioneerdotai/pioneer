{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionCheckpointToolCallSummary",
  "type": "object",
  "properties": {
    "error_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolErrorClass"
        },
        {
          "type": "null"
        }
      ]
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/$defs/TurnItemType"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ToolMetadataValue"
      }
    },
    "retry_error_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/ToolCallStatus"
    },
    "success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tool_name": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "tool_name",
    "item_type",
    "status",
    "metadata"
  ],
  "$defs": {
    "ToolCallStatus": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "failed"
      ]
    },
    "ToolErrorClass": {
      "type": "string",
      "enum": [
        "invalid_arguments",
        "not_found",
        "tool_not_visible",
        "permission_denied",
        "command_not_found",
        "timeout",
        "cancelled",
        "execution_failed",
        "needs_narrowing",
        "internal",
        "output_truncated",
        "unknown"
      ]
    },
    "ToolMetadataRawKind": {
      "type": "string",
      "enum": [
        "content",
        "body",
        "blob",
        "base64",
        "bytes",
        "data",
        "html",
        "image",
        "output",
        "screenshot",
        "stdout",
        "stderr",
        "text",
        "unknown"
      ]
    },
    "ToolMetadataValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "array"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolMetadataValue"
              }
            }
          },
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ToolMetadataValue"
              }
            },
            "kind": {
              "type": "string",
              "const": "object"
            }
          },
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "redacted_raw"
            },
            "raw_kind": {
              "$ref": "#/$defs/ToolMetadataRawKind"
            },
            "sha256": {
              "type": "string"
            },
            "value_kind": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "raw_kind",
            "sha256",
            "bytes",
            "value_kind"
          ]
        }
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}