{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRememberParams",
  "type": "object",
  "properties": {
    "category": {
      "$ref": "#/$defs/MemoryCategory"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "content": {
      "type": "string"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "importance": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryProvenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "$ref": "#/$defs/MemoryScope"
    },
    "sensitivity": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemorySensitivity"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "scope",
    "category",
    "content"
  ],
  "$defs": {
    "MemoryActor": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MemoryActorKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "MemoryActorKind": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "extractor",
        "system",
        "tool"
      ]
    },
    "MemoryCategory": {
      "type": "string",
      "enum": [
        "identity",
        "preference",
        "biography",
        "relationship",
        "recurring_instruction",
        "project_policy",
        "project_fact",
        "project_decision",
        "procedure",
        "todo",
        "constraint",
        "communication_style",
        "custom"
      ]
    },
    "MemoryProvenance": {
      "type": "object",
      "properties": {
        "created_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryActor"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "$ref": "#/$defs/MemorySourceKind"
        },
        "source_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_kind"
      ]
    },
    "MemoryScope": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryScopeKind"
        }
      },
      "required": [
        "kind",
        "key"
      ]
    },
    "MemoryScopeKind": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "thread",
        "agent",
        "task"
      ]
    },
    "MemorySensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "personal",
        "secret_like",
        "regulated"
      ]
    },
    "MemorySourceKind": {
      "type": "string",
      "enum": [
        "explicit_user_request",
        "user_correction",
        "assistant_inference",
        "background_extractor",
        "tool_observation",
        "import",
        "system"
      ]
    }
  }
}