{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskWriteLock",
  "type": "object",
  "properties": {
    "acquiredAt": {
      "type": "integer",
      "format": "int64"
    },
    "conflictPolicy": {
      "$ref": "#/$defs/TaskConcurrencyConflictPolicy"
    },
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "expiresAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "releasedAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "runId": {
      "type": "string"
    },
    "scopeKind": {
      "$ref": "#/$defs/TaskWriteLockScopeKind"
    },
    "scopePath": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskWriteLockStatus"
    },
    "taskId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspaceId",
    "taskId",
    "runId",
    "scopeKind",
    "scopePath",
    "status",
    "acquiredAt",
    "conflictPolicy",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "TaskConcurrencyConflictPolicy": {
      "type": "string",
      "enum": [
        "queue",
        "reject",
        "cancel_existing",
        "allow"
      ]
    },
    "TaskWriteLockScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "path"
      ]
    },
    "TaskWriteLockStatus": {
      "type": "string",
      "enum": [
        "pending",
        "acquired",
        "released",
        "expired",
        "cancelled",
        "blocked"
      ]
    }
  }
}