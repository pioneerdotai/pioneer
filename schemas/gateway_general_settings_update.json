{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayGeneralSettingsUpdate",
  "type": "object",
  "properties": {
    "keepawake": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "preflight_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayMemoryModelSelection"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "GatewayMemoryModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/GatewayMemoryModelSelectionSource",
          "default": "thread"
        }
      }
    },
    "GatewayMemoryModelSelectionSource": {
      "type": "string",
      "enum": [
        "thread",
        "custom"
      ]
    }
  }
}