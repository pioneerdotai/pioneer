{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentToolExecutorModels",
  "type": "object",
  "properties": {
    "backend": {
      "$ref": "#/$defs/AgentToolBackendKind"
    },
    "defaultModelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentToolModelOption"
      }
    },
    "providerId": {
      "description": "The providerId accepted by launch.profile.kind=model. For a CLI this\nidentifies its configured instance, never a runtime session or secret.",
      "type": "string"
    },
    "unavailableReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "providerId",
    "displayName",
    "backend",
    "models"
  ],
  "$defs": {
    "AgentToolBackendKind": {
      "description": "Deliberately contains only a backend class.  Runtime instance IDs and\nprovider/model configuration remain server-side implementation details.",
      "type": "string",
      "enum": [
        "api",
        "cli",
        "acp"
      ]
    },
    "AgentToolModelOption": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "reasoning": {
          "description": "None means unknown. An empty effort list does not prove lack of support.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelReasoningCapabilities"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ]
    },
    "ProviderModelReasoningCapabilities": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningCapabilitySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_token_budget": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "config_override",
        "unknown"
      ]
    }
  }
}