{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelinePageInfo",
  "type": "object",
  "properties": {
    "afterCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "beforeCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "hasMoreAfter": {
      "type": "boolean"
    },
    "hasMoreBefore": {
      "type": "boolean"
    }
  },
  "required": [
    "hasMoreBefore",
    "hasMoreAfter"
  ],
  "$defs": {
    "TimelineCursor": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    }
  }
}