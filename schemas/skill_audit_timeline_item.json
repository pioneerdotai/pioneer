{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillAuditTimelineItem",
  "type": "object",
  "required": [
    "action",
    "created_at",
    "decision",
    "details_json"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "created_at": {
      "type": "integer",
      "format": "int64"
    },
    "decision": {
      "type": "string"
    },
    "details_json": {
      "type": "string"
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}