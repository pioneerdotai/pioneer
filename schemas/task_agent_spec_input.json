{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAgentSpecInput",
  "type": "object",
  "properties": {
    "agentNickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentRole": {
      "type": [
        "string",
        "null"
      ]
    },
    "contextPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentContextPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "depth": {
      "type": "integer",
      "format": "int64"
    },
    "maxDepth": {
      "type": "integer",
      "format": "int64"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelProvider": {
      "type": [
        "string",
        "null"
      ]
    },
    "permissionCap": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionProfileCap"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "$ref": "#/$defs/TaskAgentPrompt"
    },
    "resultContract": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentResultContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentReviewPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "securityCap": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentSecurityCap"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentToolPolicy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "prompt",
    "depth",
    "maxDepth"
  ],
  "$defs": {
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "TaskAgentContext": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputAttachment"
          }
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputReference"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputVariable"
          }
        }
      }
    },
    "TaskAgentContextMode": {
      "type": "string",
      "enum": [
        "inherit_parent",
        "last_n_turns",
        "summary_only",
        "empty",
        "custom"
      ]
    },
    "TaskAgentContextPolicy": {
      "type": "object",
      "properties": {
        "customContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAgentContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeArtifacts": {
          "type": "boolean"
        },
        "includeParentSummary": {
          "type": "boolean"
        },
        "maxTurns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskAgentContextMode"
        }
      },
      "required": [
        "mode",
        "includeParentSummary",
        "includeArtifacts"
      ]
    },
    "TaskAgentInput": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputAttachment"
          }
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputReference"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskAgentInputVariable"
          }
        }
      }
    },
    "TaskAgentInputAttachment": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/TaskAgentInputAttachmentKind"
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "TaskAgentInputAttachmentKind": {
      "type": "string",
      "enum": [
        "file",
        "artifact",
        "url"
      ]
    },
    "TaskAgentInputReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TaskAgentInputReferenceKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "TaskAgentInputReferenceKind": {
      "type": "string",
      "enum": [
        "thread",
        "turn",
        "task",
        "task_run",
        "artifact"
      ]
    },
    "TaskAgentInputVariable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/TaskValue"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "TaskAgentPrompt": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAgentInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "outputInstructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "goal"
      ]
    },
    "TaskAgentResultContract": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TaskAgentResultFormat"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "required"
      ]
    },
    "TaskAgentResultFormat": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "json",
        "artifact"
      ]
    },
    "TaskAgentReviewMode": {
      "type": "string",
      "enum": [
        "none",
        "parent_agent",
        "parent_agent_with_reviewers",
        "user_approval"
      ]
    },
    "TaskAgentReviewPolicy": {
      "type": "object",
      "properties": {
        "maxRevisionRounds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskAgentReviewMode"
        },
        "requireExplicitAcceptance": {
          "type": "boolean"
        },
        "resolutionStrategy": {
          "$ref": "#/$defs/TaskResultReviewResolutionStrategy"
        },
        "reviewers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskResultReviewerSpec"
          }
        }
      },
      "required": [
        "mode",
        "maxRevisionRounds",
        "requireExplicitAcceptance",
        "resolutionStrategy"
      ]
    },
    "TaskAgentSecurityCap": {
      "type": "object",
      "properties": {
        "maxFilesystemEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnFilesystemSandboxEntry"
          }
        },
        "maxNetworkPolicy": {
          "$ref": "#/$defs/TurnNetworkPolicySnapshot"
        },
        "maxPermissionProfile": {
          "$ref": "#/$defs/TurnPermissionProfileCap"
        },
        "maxProcessPolicy": {
          "$ref": "#/$defs/TurnProcessPolicySnapshot"
        },
        "maxSandboxMode": {
          "$ref": "#/$defs/TurnSandboxMode"
        }
      },
      "required": [
        "maxPermissionProfile",
        "maxNetworkPolicy",
        "maxSandboxMode",
        "maxProcessPolicy"
      ]
    },
    "TaskAgentToolPolicy": {
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "allowedTools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "deniedTools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "networkAccess": {
          "type": "boolean"
        },
        "writeMode": {
          "$ref": "#/$defs/TaskAgentWriteMode"
        }
      },
      "required": [
        "writeMode",
        "networkAccess"
      ]
    },
    "TaskAgentWriteMode": {
      "type": "string",
      "enum": [
        "read_only",
        "workspace_write",
        "scoped_write",
        "full_access"
      ]
    },
    "TaskResultReviewResolutionStrategy": {
      "type": "string",
      "enum": [
        "parent_final",
        "user_final",
        "require_all_required_reviewers_then_parent",
        "quorum_then_parent",
        "any_required_reviewer_can_request_changes"
      ]
    },
    "TaskResultReviewerKind": {
      "type": "string",
      "enum": [
        "runtime_auto",
        "parent_agent",
        "review_agent",
        "user",
        "system"
      ]
    },
    "TaskResultReviewerSpec": {
      "type": "object",
      "properties": {
        "agentNickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "reviewerKind": {
          "$ref": "#/$defs/TaskResultReviewerKind"
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "reviewerKind",
        "required"
      ]
    },
    "TaskSchema": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "$ref": "#/$defs/TaskValue"
        }
      },
      "required": [
        "schema"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnCommandRiskPolicy": {
      "type": "object",
      "properties": {
        "allowed_command_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TurnEnvironmentPolicy": {
      "type": "object",
      "properties": {
        "allowed_vars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inherit": {
          "type": "boolean"
        }
      },
      "required": [
        "inherit"
      ]
    },
    "TurnFilesystemAccess": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write"
      ]
    },
    "TurnFilesystemSandboxEntry": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/TurnFilesystemAccess"
        },
        "path": {
          "$ref": "#/$defs/TurnFilesystemSandboxPath"
        },
        "provenance": {
          "$ref": "#/$defs/TurnSecurityRuleProvenance"
        },
        "resolved_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "access",
        "provenance"
      ]
    },
    "TurnFilesystemSandboxPath": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "current_working_directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "project_root"
            },
            "subpath": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "slash_tmp"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tmpdir"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "runtime_home"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit_path"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    },
    "TurnNetworkPolicySnapshot": {
      "type": "object",
      "properties": {
        "allow_localhost": {
          "type": "boolean"
        },
        "allow_unix_sockets": {
          "type": "boolean"
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/TurnNetworkMode"
        }
      },
      "required": [
        "mode",
        "allow_localhost",
        "allow_unix_sockets"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileCap": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode",
        "effective_policy"
      ]
    },
    "TurnProcessPolicySnapshot": {
      "type": "object",
      "properties": {
        "command_risk": {
          "$ref": "#/$defs/TurnCommandRiskPolicy"
        },
        "environment": {
          "$ref": "#/$defs/TurnEnvironmentPolicy"
        },
        "shell": {
          "$ref": "#/$defs/TurnShellPolicy"
        },
        "timeout": {
          "$ref": "#/$defs/TurnProcessTimeoutPolicy"
        }
      },
      "required": [
        "shell",
        "environment",
        "timeout",
        "command_risk"
      ]
    },
    "TurnProcessTimeoutPolicy": {
      "type": "object",
      "properties": {
        "max_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "max_duration_ms"
      ]
    },
    "TurnSandboxMode": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "TurnSecurityRuleProvenance": {
      "type": "string",
      "enum": [
        "composer_selection",
        "workspace",
        "project",
        "runtime",
        "task_cap",
        "system"
      ]
    },
    "TurnShellPolicy": {
      "type": "object",
      "properties": {
        "allow_session_inheritance": {
          "type": "boolean"
        },
        "allow_stdin": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "allow_stdin",
        "allow_session_inheritance"
      ]
    }
  }
}