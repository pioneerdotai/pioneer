{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskAgentSpecInput",
  "type": "object",
  "required": [
    "depth",
    "maxDepth",
    "prompt"
  ],
  "properties": {
    "agentNickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentRole": {
      "type": [
        "string",
        "null"
      ]
    },
    "contextPolicy": {
      "anyOf": [
        {
          "$ref": "#/definitions/TaskAgentContextPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "depth": {
      "type": "integer",
      "format": "int64"
    },
    "maxDepth": {
      "type": "integer",
      "format": "int64"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelProvider": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "$ref": "#/definitions/TaskAgentPrompt"
    },
    "resultContract": {
      "anyOf": [
        {
          "$ref": "#/definitions/TaskAgentResultContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolPolicy": {
      "anyOf": [
        {
          "$ref": "#/definitions/TaskAgentToolPolicy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "TaskAgentContext": {
      "type": "object",
      "properties": {
        "attachments": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskAgentInputAttachment"
          }
        },
        "references": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskAgentInputReference"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskAgentInputVariable"
          }
        }
      }
    },
    "TaskAgentContextMode": {
      "type": "string",
      "enum": [
        "inherit_parent",
        "last_n_turns",
        "summary_only",
        "empty",
        "custom"
      ]
    },
    "TaskAgentContextPolicy": {
      "type": "object",
      "required": [
        "includeArtifacts",
        "includeParentSummary",
        "mode"
      ],
      "properties": {
        "customContext": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskAgentContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeArtifacts": {
          "type": "boolean"
        },
        "includeParentSummary": {
          "type": "boolean"
        },
        "maxTurns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "mode": {
          "$ref": "#/definitions/TaskAgentContextMode"
        }
      }
    },
    "TaskAgentInput": {
      "type": "object",
      "properties": {
        "attachments": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskAgentInputAttachment"
          }
        },
        "references": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskAgentInputReference"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskAgentInputVariable"
          }
        }
      }
    },
    "TaskAgentInputAttachment": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/TaskAgentInputAttachmentKind"
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAgentInputAttachmentKind": {
      "type": "string",
      "enum": [
        "file",
        "artifact",
        "url"
      ]
    },
    "TaskAgentInputReference": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TaskAgentInputReferenceKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAgentInputReferenceKind": {
      "type": "string",
      "enum": [
        "thread",
        "turn",
        "task",
        "task_run",
        "artifact"
      ]
    },
    "TaskAgentInputVariable": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/TaskValue"
        }
      }
    },
    "TaskAgentPrompt": {
      "type": "object",
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskAgentInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputInstructions": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAgentResultContract": {
      "type": "object",
      "required": [
        "format",
        "required"
      ],
      "properties": {
        "format": {
          "$ref": "#/definitions/TaskAgentResultFormat"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TaskAgentResultFormat": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "json",
        "artifact"
      ]
    },
    "TaskAgentToolPolicy": {
      "type": "object",
      "required": [
        "networkAccess",
        "writeMode"
      ],
      "properties": {
        "allowedPaths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedTools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedTools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "networkAccess": {
          "type": "boolean"
        },
        "writeMode": {
          "$ref": "#/definitions/TaskAgentWriteMode"
        }
      }
    },
    "TaskAgentWriteMode": {
      "type": "string",
      "enum": [
        "read_only",
        "workspace_write",
        "scoped_write",
        "full_access"
      ]
    },
    "TaskSchema": {
      "type": "object",
      "required": [
        "schema"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "$ref": "#/definitions/TaskValue"
        }
      }
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "integer"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "string"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TaskValue"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/TaskValue"
              }
            }
          }
        }
      ]
    }
  }
}