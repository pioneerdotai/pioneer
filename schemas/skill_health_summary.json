{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillHealthSummary",
  "type": "object",
  "properties": {
    "dependency_failures": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillDependencyDiagnostic"
      }
    },
    "security_blocks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillSecurityFinding"
      }
    },
    "status": {
      "type": "string"
    },
    "validation_issues": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillValidationDiagnostic"
      }
    }
  },
  "required": [
    "status"
  ],
  "$defs": {
    "SkillDependencyDiagnostic": {
      "type": "object",
      "properties": {
        "hint": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "status",
        "hint"
      ]
    },
    "SkillSecurityFinding": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message"
      ]
    },
    "SkillValidationDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ]
    }
  }
}