{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAgentToolPolicy",
  "type": "object",
  "properties": {
    "allowedPaths": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "allowedTools": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "deniedTools": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "networkAccess": {
      "type": "boolean"
    },
    "writeMode": {
      "$ref": "#/$defs/TaskAgentWriteMode"
    }
  },
  "required": [
    "writeMode",
    "networkAccess"
  ],
  "$defs": {
    "TaskAgentWriteMode": {
      "type": "string",
      "enum": [
        "read_only",
        "workspace_write",
        "scoped_write",
        "full_access"
      ]
    }
  }
}