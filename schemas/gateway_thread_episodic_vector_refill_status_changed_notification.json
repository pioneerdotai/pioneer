{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayThreadEpisodicVectorRefillStatusChangedNotification",
  "type": "object",
  "properties": {
    "downloaded_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "local_model_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayThreadEpisodicVectorLocalModelStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/GatewayThreadEpisodicVectorRefillStatus"
    },
    "total_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "status"
  ],
  "$defs": {
    "GatewayThreadEpisodicVectorLocalModelStatus": {
      "type": "string",
      "enum": [
        "not_selected",
        "unknown",
        "missing",
        "downloading",
        "installed",
        "failed"
      ]
    },
    "GatewayThreadEpisodicVectorRefillStatus": {
      "type": "string",
      "enum": [
        "disabled",
        "unknown",
        "required",
        "running",
        "complete",
        "failed"
      ]
    }
  }
}