{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskDeliveryPolicy",
  "type": "object",
  "properties": {
    "format": {
      "$ref": "#/$defs/TaskDeliveryFormat"
    },
    "includeResult": {
      "type": "boolean"
    },
    "mode": {
      "$ref": "#/$defs/TaskDeliveryMode"
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "webhookUrl": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "mode",
    "includeResult",
    "format"
  ],
  "$defs": {
    "TaskDeliveryFormat": {
      "type": "string",
      "enum": [
        "summary",
        "full_result"
      ]
    },
    "TaskDeliveryMode": {
      "type": "string",
      "enum": [
        "none",
        "owner_thread",
        "thread",
        "user_notification",
        "webhook"
      ]
    }
  }
}