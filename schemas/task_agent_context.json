{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskAgentContext",
  "type": "object",
  "properties": {
    "attachments": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TaskAgentInputAttachment"
      }
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TaskAgentInputReference"
      }
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "variables": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TaskAgentInputVariable"
      }
    }
  },
  "definitions": {
    "TaskAgentInputAttachment": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/TaskAgentInputAttachmentKind"
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAgentInputAttachmentKind": {
      "type": "string",
      "enum": [
        "file",
        "artifact",
        "url"
      ]
    },
    "TaskAgentInputReference": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TaskAgentInputReferenceKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskAgentInputReferenceKind": {
      "type": "string",
      "enum": [
        "thread",
        "turn",
        "task",
        "task_run",
        "artifact"
      ]
    },
    "TaskAgentInputVariable": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/TaskValue"
        }
      }
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "integer"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "string"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TaskValue"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/TaskValue"
              }
            }
          }
        }
      ]
    }
  }
}