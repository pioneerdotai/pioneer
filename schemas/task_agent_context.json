{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAgentContext",
  "type": "object",
  "properties": {
    "attachments": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskAgentInputAttachment"
      }
    },
    "references": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskAgentInputReference"
      }
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "variables": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskAgentInputVariable"
      }
    }
  },
  "$defs": {
    "TaskAgentInputAttachment": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/TaskAgentInputAttachmentKind"
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "TaskAgentInputAttachmentKind": {
      "type": "string",
      "enum": [
        "file",
        "artifact",
        "url"
      ]
    },
    "TaskAgentInputReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TaskAgentInputReferenceKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "TaskAgentInputReferenceKind": {
      "type": "string",
      "enum": [
        "thread",
        "turn",
        "task",
        "task_run",
        "artifact"
      ]
    },
    "TaskAgentInputVariable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/TaskValue"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "TaskValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TaskValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}