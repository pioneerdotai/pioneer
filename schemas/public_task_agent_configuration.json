{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicTaskAgentConfiguration",
  "type": "object",
  "properties": {
    "agentNickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentRole": {
      "type": [
        "string",
        "null"
      ]
    },
    "contextPolicyConfigured": {
      "type": "boolean"
    },
    "depth": {
      "type": "integer",
      "format": "int64"
    },
    "inputConfigured": {
      "type": "boolean"
    },
    "instructions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "maxDepth": {
      "type": "integer",
      "format": "int64"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelProvider": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputInstructions": {
      "type": [
        "string",
        "null"
      ]
    },
    "resultContract": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicTaskResultContractConfiguration"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskAgentReviewPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolPolicyConfigured": {
      "type": "boolean"
    }
  },
  "required": [
    "inputConfigured",
    "contextPolicyConfigured",
    "toolPolicyConfigured",
    "depth",
    "maxDepth"
  ],
  "$defs": {
    "PublicTaskResultContractConfiguration": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TaskAgentResultFormat"
        },
        "required": {
          "type": "boolean"
        },
        "schemaConfigured": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "required",
        "schemaConfigured"
      ]
    },
    "TaskAgentResultFormat": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "json",
        "artifact"
      ]
    },
    "TaskAgentReviewMode": {
      "type": "string",
      "enum": [
        "none",
        "parent_agent",
        "parent_agent_with_reviewers",
        "user_approval"
      ]
    },
    "TaskAgentReviewPolicy": {
      "type": "object",
      "properties": {
        "maxRevisionRounds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/TaskAgentReviewMode"
        },
        "requireExplicitAcceptance": {
          "type": "boolean"
        },
        "resolutionStrategy": {
          "$ref": "#/$defs/TaskResultReviewResolutionStrategy"
        },
        "reviewers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskResultReviewerSpec"
          }
        }
      },
      "required": [
        "mode",
        "maxRevisionRounds",
        "requireExplicitAcceptance",
        "resolutionStrategy"
      ]
    },
    "TaskResultReviewResolutionStrategy": {
      "type": "string",
      "enum": [
        "parent_final",
        "user_final",
        "require_all_required_reviewers_then_parent",
        "quorum_then_parent",
        "any_required_reviewer_can_request_changes"
      ]
    },
    "TaskResultReviewerKind": {
      "type": "string",
      "enum": [
        "runtime_auto",
        "parent_agent",
        "review_agent",
        "user",
        "system"
      ]
    },
    "TaskResultReviewerSpec": {
      "type": "object",
      "properties": {
        "agentNickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "reviewerKind": {
          "$ref": "#/$defs/TaskResultReviewerKind"
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "reviewerKind",
        "required"
      ]
    }
  }
}