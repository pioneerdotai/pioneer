{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "integer",
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    },
    "is_current": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "updated_at": {
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "id",
    "name",
    "is_active",
    "is_current",
    "created_at",
    "updated_at"
  ]
}