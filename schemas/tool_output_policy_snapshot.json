{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolOutputPolicySnapshot",
  "type": "object",
  "properties": {
    "deltas": {
      "$ref": "#/$defs/DeltaOutputPolicy"
    },
    "llm": {
      "$ref": "#/$defs/LlmOutputPolicy"
    },
    "llmRetention": {
      "$ref": "#/$defs/LlmRetentionPolicy"
    },
    "recovery": {
      "$ref": "#/$defs/RecoveryOutputPolicy"
    },
    "storage": {
      "$ref": "#/$defs/StorageOutputPolicy"
    },
    "timeline": {
      "$ref": "#/$defs/TimelineOutputPolicy"
    }
  },
  "required": [
    "llm",
    "llmRetention",
    "timeline",
    "storage",
    "recovery",
    "deltas"
  ],
  "$defs": {
    "DeltaOutputPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max_chunk_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "max_total_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "persist_and_display"
            }
          },
          "required": [
            "mode",
            "max_chunk_bytes",
            "max_total_bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "progress_only"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "DiagnosticExcerptPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max_chars": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "errors_only"
            }
          },
          "required": [
            "mode",
            "max_chars"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max_chars": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "output"
            }
          },
          "required": [
            "mode",
            "max_chars"
          ]
        }
      ]
    },
    "LlmOutputPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "full"
            }
          },
          "required": [
            "mode",
            "max_bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "structured"
            }
          },
          "required": [
            "mode",
            "max_bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "summary_only"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "LlmRetentionPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "until_turn_terminal"
            }
          },
          "required": [
            "mode",
            "max_bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "do_not_retain"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "RecoveryOutputPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "diagnostic_excerpt": {
              "$ref": "#/$defs/DiagnosticExcerptPolicy"
            },
            "include_error_class": {
              "type": "boolean"
            },
            "include_exit_status": {
              "type": "boolean"
            },
            "include_fingerprints": {
              "type": "boolean"
            },
            "include_retry_hint": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "const": "evidence"
            }
          },
          "required": [
            "mode",
            "include_exit_status",
            "include_error_class",
            "include_retry_hint",
            "diagnostic_excerpt",
            "include_fingerprints"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "metadata_only"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "StorageOutputPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "full"
            }
          },
          "required": [
            "mode",
            "max_bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max_chars": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "summary"
            }
          },
          "required": [
            "mode",
            "max_chars"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "metadata_only"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "TimelineOutputPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max_bytes": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "full"
            }
          },
          "required": [
            "mode",
            "max_bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max_chars": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "summary"
            }
          },
          "required": [
            "mode",
            "max_chars"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "metadata_only"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "hidden"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    }
  }
}