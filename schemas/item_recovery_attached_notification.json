{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ItemRecoveryAttachedNotification",
  "type": "object",
  "required": [
    "action",
    "existing_status",
    "item_id",
    "item_type",
    "next_attempt_number",
    "recovery_item_id",
    "recovery_item_type",
    "recovery_job_id",
    "thread_id",
    "trigger",
    "turn_id",
    "workspace_id"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/RecoveryAction"
    },
    "existing_status": {
      "$ref": "#/definitions/RecoveryJobStatus"
    },
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "$ref": "#/definitions/TurnItemType"
    },
    "next_attempt_number": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "recovery_item_id": {
      "type": "string"
    },
    "recovery_item_type": {
      "$ref": "#/definitions/TurnItemType"
    },
    "recovery_job_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "trigger": {
      "$ref": "#/definitions/RecoveryTrigger"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "RecoveryAction": {
      "type": "string",
      "enum": [
        "retry_attempt",
        "retry_with_backoff",
        "restart_turn",
        "fallback",
        "mark_failed"
      ]
    },
    "RecoveryJobStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "succeeded",
        "failed",
        "exhausted",
        "cancelled"
      ]
    },
    "RecoveryTrigger": {
      "oneOf": [
        {
          "description": "Turn-item execution exceeded timeout policy (start/idle/hard/lease).",
          "type": "string",
          "enum": [
            "timeout"
          ]
        },
        {
          "description": "Any provider/model/transport failure in LLM interaction path.",
          "type": "string",
          "enum": [
            "provider_error"
          ]
        },
        {
          "description": "Forward-compatibility fallback for unknown persisted values.",
          "type": "string",
          "enum": [
            "unknown"
          ]
        }
      ]
    },
    "TurnItemType": {
      "type": "string",
      "enum": [
        "user_message",
        "agent_message",
        "reasoning",
        "system_event",
        "task",
        "command_execution",
        "file_change",
        "web_search",
        "web_fetch",
        "download",
        "dynamic_tool_call"
      ]
    }
  }
}