{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnNetworkPolicySnapshot",
  "type": "object",
  "properties": {
    "allow_localhost": {
      "type": "boolean"
    },
    "allow_unix_sockets": {
      "type": "boolean"
    },
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "$ref": "#/$defs/TurnNetworkMode"
    }
  },
  "required": [
    "mode",
    "allow_localhost",
    "allow_unix_sockets"
  ],
  "$defs": {
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    }
  }
}