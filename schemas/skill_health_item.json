{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillHealthItem",
  "type": "object",
  "required": [
    "slug",
    "source_kind",
    "trust_level"
  ],
  "properties": {
    "dependency_diagnostics": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillDependencyDiagnostic"
      }
    },
    "recent_audit": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillAuditTimelineItem"
      }
    },
    "security_findings": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillSecurityFinding"
      }
    },
    "slug": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "trust_gate": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillTrustGateStatus"
      }
    },
    "trust_level": {
      "type": "string"
    },
    "validation_issues": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillValidationDiagnostic"
      }
    }
  },
  "definitions": {
    "SkillAuditTimelineItem": {
      "type": "object",
      "required": [
        "action",
        "created_at",
        "decision",
        "details_json"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "decision": {
          "type": "string"
        },
        "details_json": {
          "type": "string"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SkillDependencyDiagnostic": {
      "type": "object",
      "required": [
        "hint",
        "kind",
        "name",
        "status"
      ],
      "properties": {
        "hint": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "SkillSecurityFinding": {
      "type": "object",
      "required": [
        "message",
        "rule_id",
        "severity"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    },
    "SkillTrustGateStatus": {
      "type": "object",
      "required": [
        "allowed",
        "minimum_trust",
        "tool_kind"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "minimum_trust": {
          "type": "string"
        },
        "tool_kind": {
          "type": "string"
        }
      }
    },
    "SkillValidationDiagnostic": {
      "type": "object",
      "required": [
        "code",
        "level",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}