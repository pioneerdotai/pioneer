{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpInstallResult",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/McpValidationDiagnostic"
      }
    },
    "name": {
      "type": "string"
    },
    "server": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpListItem"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/McpInstallResultStatus"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "$defs": {
    "McpDiagnosticLevel": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "McpInstallResultStatus": {
      "type": "string",
      "enum": [
        "installed",
        "updated",
        "validation_error"
      ]
    },
    "McpListItem": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/McpPolicyState"
        },
        "prompts_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "resource_templates_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "resources_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "runtime": {
          "$ref": "#/$defs/McpRuntimeStatus"
        },
        "scope": {
          "$ref": "#/$defs/McpScopeKind"
        },
        "source_kind": {
          "$ref": "#/$defs/McpSourceKind"
        },
        "status": {
          "$ref": "#/$defs/McpServerStatus"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "transport": {
          "$ref": "#/$defs/McpTransportSummary"
        }
      },
      "required": [
        "id",
        "name",
        "scope",
        "source_kind",
        "transport",
        "policy",
        "required",
        "fingerprint",
        "runtime",
        "tools_count",
        "resources_count",
        "resource_templates_count",
        "prompts_count",
        "status"
      ]
    },
    "McpPolicyState": {
      "type": "object",
      "properties": {
        "allow_implicit_invocation": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "allow_implicit_invocation"
      ]
    },
    "McpRuntimeState": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    },
    "McpRuntimeStatus": {
      "type": "object",
      "properties": {
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "live": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/McpRuntimeState"
        }
      },
      "required": [
        "state",
        "live"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "McpServerStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "disabled",
        "starting",
        "ready",
        "degraded",
        "auth_required",
        "failed",
        "stopping",
        "stopped",
        "restarting"
      ]
    },
    "McpSourceKind": {
      "type": "string",
      "enum": [
        "config"
      ]
    },
    "McpTransportSummary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "stdio"
            }
          },
          "required": [
            "kind",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "streamable_http"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        }
      ]
    },
    "McpValidationDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "$ref": "#/$defs/McpDiagnosticLevel"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ]
    }
  }
}