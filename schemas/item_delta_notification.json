{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ItemDeltaNotification",
  "type": "object",
  "required": [
    "delta",
    "item_id",
    "thread_id",
    "turn_id",
    "workspace_id"
  ],
  "properties": {
    "delta": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "markdown": {
      "anyOf": [
        {
          "$ref": "#/definitions/MarkdownDocument"
        },
        {
          "type": "null"
        }
      ]
    },
    "markdown_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint16",
      "minimum": 0.0
    },
    "payload": true,
    "stream": {
      "anyOf": [
        {
          "$ref": "#/definitions/ItemDeltaStream"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "ItemDeltaStream": {
      "type": "string",
      "enum": [
        "agent_message",
        "stdout",
        "stderr",
        "tool_progress",
        "file_change",
        "generic"
      ]
    },
    "MarkdownBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "marks": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/MarkdownMark"
              }
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "paragraph"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "content",
            "level",
            "type"
          ],
          "properties": {
            "content": {
              "$ref": "#/definitions/MarkdownInline"
            },
            "level": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "heading"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ordered",
            "start",
            "type"
          ],
          "properties": {
            "items": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/MarkdownListItem"
              }
            },
            "ordered": {
              "type": "boolean"
            },
            "start": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "blocks",
            "type"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MarkdownBlock"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "quote"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "rule"
              ]
            }
          }
        }
      ]
    },
    "MarkdownDocument": {
      "type": "object",
      "properties": {
        "blocks": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/MarkdownBlock"
          }
        }
      }
    },
    "MarkdownInline": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "marks": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/MarkdownMark"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "MarkdownListItem": {
      "type": "object",
      "properties": {
        "blocks": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/MarkdownBlock"
          }
        },
        "checked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "MarkdownMark": {
      "type": "object",
      "required": [
        "end",
        "kind",
        "start"
      ],
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/MarkdownMarkKind"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
    },
    "MarkdownMarkKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bold"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "italic"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "strike"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "link"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}