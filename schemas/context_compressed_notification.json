{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextCompressedNotification",
  "type": "object",
  "required": [
    "compressed_tokens",
    "thread_id",
    "turn_id"
  ],
  "properties": {
    "compressed_tokens": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    }
  }
}