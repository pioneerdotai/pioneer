{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskWaitParams",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/TaskWaitMode",
      "default": "all_terminal"
    },
    "returnCompleted": {
      "type": "boolean",
      "default": false
    },
    "returnPending": {
      "type": "boolean",
      "default": false
    },
    "runIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "taskIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "timeoutMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  },
  "$defs": {
    "TaskWaitMode": {
      "type": "string",
      "enum": [
        "all_terminal",
        "any_terminal",
        "all_terminal_or_review_required",
        "any_terminal_or_review_required"
      ]
    }
  }
}