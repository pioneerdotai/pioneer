{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AddRemoteGatewayPlan",
  "type": "object",
  "properties": {
    "endpoint": {
      "$ref": "#/$defs/GatewayEndpoint"
    },
    "previous_endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayEndpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "token_write": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayAuthTokenWrite"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "endpoint"
  ],
  "$defs": {
    "GatewayAuthTokenWrite": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "token_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token_ref",
        "token",
        "label"
      ]
    },
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "auth_token_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    }
  }
}