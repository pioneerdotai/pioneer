{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerDraftLifecycleAction",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "ClearAll"
      ]
    },
    {
      "type": "object",
      "properties": {
        "SwitchThread": {
          "type": "object",
          "properties": {
            "current_draft": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComposerDomainDraft"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "current_thread_id": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "fallback": {
              "$ref": "#/$defs/ComposerDomainDraft"
            },
            "target_thread_id": {
              "type": "string"
            }
          },
          "required": [
            "target_thread_id",
            "fallback"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "SwitchThread"
      ]
    },
    {
      "type": "object",
      "properties": {
        "RememberThread": {
          "type": "object",
          "properties": {
            "draft": {
              "$ref": "#/$defs/ComposerDomainDraft"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "thread_id",
            "draft"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "RememberThread"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ClearThread": {
          "type": "object",
          "properties": {
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "thread_id"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "ClearThread"
      ]
    }
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ComposerAttachment": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerAttachmentKind"
        },
        "path": {
          "type": "string"
        },
        "upload_state": {
          "$ref": "#/$defs/ComposerAttachmentUploadState"
        }
      },
      "required": [
        "path",
        "file_name",
        "kind",
        "upload_state"
      ]
    },
    "ComposerAttachmentKind": {
      "type": "string",
      "enum": [
        "Image",
        "File",
        "Audio",
        "Video"
      ]
    },
    "ComposerAttachmentUploadState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Local",
            "Uploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Uploaded": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Uploaded"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Failed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Failed"
          ]
        }
      ]
    },
    "ComposerCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "ComposerCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Skill": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "source_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpServer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                }
              },
              "required": [
                "name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpServer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpTool": {
              "type": "object",
              "properties": {
                "raw_tool_name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                },
                "server_name": {
                  "type": "string"
                }
              },
              "required": [
                "server_name",
                "raw_tool_name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpTool"
          ]
        }
      ]
    },
    "ComposerCapabilityTarget": {
      "description": "Capability eligibility context.\n\nThe target kind exists only because native skills retain their current\nsource policy while CLI skills must be exportable. Capability support is\nrepresented exclusively by [`ComposerCapabilityPolicy`].",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityTargetKind"
        },
        "supports_mcp_tools": {
          "type": "boolean"
        },
        "supports_skills": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "supports_skills",
        "supports_mcp_tools"
      ]
    },
    "ComposerCapabilityTargetKind": {
      "type": "string",
      "enum": [
        "native",
        "cli"
      ]
    },
    "ComposerDomainDraft": {
      "description": "Complete, shell-neutral draft payload used by desktop and mobile.\n\nHot editor state (cursor, IME composition, focus, keyboard, sheets) is not\npart of this value. A shell snapshots its text only at lifecycle boundaries\nsuch as switching threads.",
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "#/$defs/ComposerDomainState"
        },
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "domain"
      ]
    },
    "ComposerDomainState": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerAttachment"
          }
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerCapability"
          }
        },
        "capability_target": {
          "$ref": "#/$defs/ComposerCapabilityTarget"
        },
        "mode_manually_selected": {
          "type": "boolean",
          "default": false
        },
        "model_manually_selected": {
          "type": "boolean",
          "default": false
        },
        "selected_mode": {
          "$ref": "#/$defs/ThreadMode",
          "default": "Agent"
        },
        "selected_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_permission_mode": {
          "$ref": "#/$defs/TurnPermissionMode",
          "default": "full_access"
        },
        "selected_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capability_target"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "ThreadMode": {
      "type": "string",
      "enum": [
        "Chat",
        "Agent"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    }
  }
}