{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderModelReasoningCapabilities",
  "type": "object",
  "properties": {
    "default_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mandatory": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasoningCapabilitySource"
        },
        {
          "type": "null"
        }
      ]
    },
    "supported": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "supports_token_budget": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "$defs": {
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "static_registry",
        "config_override",
        "unknown"
      ]
    }
  }
}