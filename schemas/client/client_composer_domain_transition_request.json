{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientComposerDomainTransitionRequest",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/ComposerDomainAction"
    },
    "state": {
      "$ref": "#/$defs/ComposerDomainState"
    }
  },
  "additionalProperties": false,
  "required": [
    "state",
    "action"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ComposerAttachment": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerAttachmentKind"
        },
        "path": {
          "type": "string"
        },
        "upload_state": {
          "$ref": "#/$defs/ComposerAttachmentUploadState"
        }
      },
      "required": [
        "path",
        "file_name",
        "kind",
        "upload_state"
      ]
    },
    "ComposerAttachmentKind": {
      "type": "string",
      "enum": [
        "Image",
        "File",
        "Audio",
        "Video"
      ]
    },
    "ComposerAttachmentUploadState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Local",
            "Uploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Uploaded": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Uploaded"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Failed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Failed"
          ]
        }
      ]
    },
    "ComposerCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "ComposerCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Skill": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "skill_id": {
                  "$ref": "#/$defs/SkillId"
                },
                "slug": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "slug",
                "source_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpServer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                }
              },
              "required": [
                "name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpServer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpTool": {
              "type": "object",
              "properties": {
                "raw_tool_name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                },
                "server_name": {
                  "type": "string"
                }
              },
              "required": [
                "server_name",
                "raw_tool_name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpTool"
          ]
        }
      ]
    },
    "ComposerCapabilityTarget": {
      "description": "Capability eligibility context.\n\nThe target kind exists only because native skills retain their current\nsource policy while CLI skills must be exportable. Capability support is\nrepresented exclusively by [`ComposerCapabilityPolicy`].",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityTargetKind"
        },
        "supports_mcp_tools": {
          "type": "boolean"
        },
        "supports_skills": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "supports_skills",
        "supports_mcp_tools"
      ]
    },
    "ComposerCapabilityTargetKind": {
      "type": "string",
      "enum": [
        "native",
        "cli"
      ]
    },
    "ComposerDomainAction": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "MarkAttachmentsUploading",
            "ClearReasoningEffort",
            "ClearPayload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetAttachments": {
              "type": "object",
              "properties": {
                "attachments": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComposerAttachment"
                  }
                }
              },
              "required": [
                "attachments"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SetAttachments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "AddAttachment": {
              "type": "object",
              "properties": {
                "attachment": {
                  "$ref": "#/$defs/ComposerAttachment"
                }
              },
              "required": [
                "attachment"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "AddAttachment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "AddArtifactAttachment": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "AddArtifactAttachment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RemoveAttachmentAt": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "index"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "RemoveAttachmentAt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "MarkAttachmentsFailed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "MarkAttachmentsFailed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ApplyUploadedAttachments": {
              "type": "object",
              "properties": {
                "artifacts": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ArtifactRef"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "required": [
                "artifacts"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ApplyUploadedAttachments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetCapabilities": {
              "type": "object",
              "properties": {
                "capabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComposerCapability"
                  }
                }
              },
              "required": [
                "capabilities"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SetCapabilities"
          ]
        },
        {
          "type": "object",
          "properties": {
            "AddCapability": {
              "type": "object",
              "properties": {
                "capability": {
                  "$ref": "#/$defs/ComposerCapability"
                }
              },
              "required": [
                "capability"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "AddCapability"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RemoveCapability": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "RemoveCapability"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RemoveCapabilityAt": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "index"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "RemoveCapabilityAt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetSkillSelections": {
              "type": "object",
              "properties": {
                "selections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComposerSkillSelection"
                  }
                }
              },
              "required": [
                "selections"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SetSkillSelections"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ToggleSkillSelection": {
              "type": "object",
              "properties": {
                "picker": {
                  "$ref": "#/$defs/ComposerSkillPickerProjection"
                },
                "selection": {
                  "$ref": "#/$defs/ComposerSkillSelection"
                }
              },
              "required": [
                "picker",
                "selection"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ToggleSkillSelection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetModeFromUser": {
              "type": "object",
              "properties": {
                "mode": {
                  "$ref": "#/$defs/ThreadMode"
                }
              },
              "required": [
                "mode"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SetModeFromUser"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetPermissionMode": {
              "type": "object",
              "properties": {
                "mode": {
                  "$ref": "#/$defs/TurnPermissionMode"
                }
              },
              "required": [
                "mode"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SetPermissionMode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetModelSelectionFromUser": {
              "type": "object",
              "properties": {
                "capability_target": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ComposerCapabilityTarget"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "SetModelSelectionFromUser"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SetReasoningEffortFromUser": {
              "type": "object",
              "properties": {
                "effort": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "SetReasoningEffortFromUser"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SyncResolvedModelSelection": {
              "type": "object",
              "properties": {
                "capability_target": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ComposerCapabilityTarget"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "selection": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ComposerModelSelection"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "SyncResolvedModelSelection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ResetModelSelection": {
              "type": "object",
              "properties": {
                "capability_target": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ComposerCapabilityTarget"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "selection": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ComposerModelSelection"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "ResetModelSelection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SyncCapabilityTarget": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "target": {
                  "$ref": "#/$defs/ComposerCapabilityTarget"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SyncCapabilityTarget"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Reset": {
              "type": "object",
              "properties": {
                "defaults": {
                  "$ref": "#/$defs/ComposerDomainState"
                }
              },
              "required": [
                "defaults"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Reset"
          ]
        }
      ]
    },
    "ComposerDomainState": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerAttachment"
          }
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerCapability"
          }
        },
        "capability_target": {
          "$ref": "#/$defs/ComposerCapabilityTarget"
        },
        "mode_manually_selected": {
          "type": "boolean",
          "default": false
        },
        "model_manually_selected": {
          "type": "boolean",
          "default": false
        },
        "selected_mode": {
          "$ref": "#/$defs/ThreadMode",
          "default": "Agent"
        },
        "selected_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_permission_mode": {
          "$ref": "#/$defs/TurnPermissionMode",
          "default": "full_access"
        },
        "selected_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_selections": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerSkillSelection"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "capability_target"
      ]
    },
    "ComposerModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "selected_reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "model"
      ]
    },
    "ComposerSkillPickerProjection": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectableSkillPackCapability"
          }
        },
        "standalone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectableSkillCapability"
          }
        }
      },
      "required": [
        "standalone",
        "packs"
      ]
    },
    "ComposerSkillSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill"
            },
            "pack_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillPackId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "skill_id": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill_pack"
            },
            "pack_id": {
              "$ref": "#/$defs/SkillPackId"
            }
          },
          "required": [
            "kind",
            "pack_id"
          ]
        }
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SelectablePackedSkillCapability": {
      "type": "object",
      "properties": {
        "member_key": {
          "type": "string"
        },
        "pack_id": {
          "$ref": "#/$defs/SkillPackId"
        },
        "skill": {
          "$ref": "#/$defs/SelectableSkillCapability"
        }
      },
      "required": [
        "pack_id",
        "member_key",
        "skill"
      ]
    },
    "SelectableSkillCapability": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectable": {
          "type": "boolean"
        },
        "skill_id": {
          "$ref": "#/$defs/SkillId"
        },
        "slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillCapabilityUnavailableReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "skill_id",
        "label",
        "display_name",
        "description",
        "slug",
        "source_kind",
        "selectable"
      ]
    },
    "SelectableSkillPackCapability": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectablePackedSkillCapability"
          }
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "pack_id": {
          "$ref": "#/$defs/SkillPackId"
        },
        "selectable": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "pack_id",
        "label",
        "children",
        "selectable"
      ]
    },
    "SkillCapabilityUnavailableReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "DisabledByPolicy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Inactive": {
              "type": "object",
              "properties": {
