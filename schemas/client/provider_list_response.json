{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderListResponse",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderSummary"
      }
    }
  },
  "required": [
    "providers"
  ],
  "$defs": {
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ProviderSummaryCapabilities",
          "default": {
            "embeddings": false
          }
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderSummaryCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}