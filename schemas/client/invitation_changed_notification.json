{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvitationChangedNotification",
  "type": "object",
  "properties": {
    "invitation_id": {
      "$ref": "#/$defs/InvitationId"
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "revision",
    "invitation_id"
  ],
  "$defs": {
    "InvitationId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}