{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceStatusResponse",
  "type": "object",
  "properties": {
    "active_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceError"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/VoiceStatus"
    }
  },
  "required": [
    "status"
  ],
  "$defs": {
    "VoiceError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/VoiceErrorKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    "VoiceErrorKind": {
      "type": "string",
      "enum": [
        "model_unavailable",
        "microphone_permission_blocked",
        "device_unavailable",
        "invalid_session",
        "stale_chunk",
        "sequence_gap",
        "cancelled",
        "no_speech",
        "transcription_failed",
        "gateway_busy",
        "model_downloading",
        "unknown"
      ]
    },
    "VoiceStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unavailable",
            "model_loading",
            "ready",
            "busy",
            "recording",
            "transcribing",
            "error"
          ]
        },
        {
          "description": "Model download is happening in the gateway background. First pass UI\nshould not infer or require detailed progress from this status.",
          "type": "string",
          "const": "model_downloading"
        }
      ]
    }
  }
}