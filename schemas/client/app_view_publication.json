{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppViewPublication",
  "type": "object",
  "properties": {
    "development": {
      "type": "boolean"
    },
    "state": {
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "development",
    "state",
    "title"
  ]
}
