{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvitationCreateParams",
  "type": "object",
  "properties": {
    "role_key": {
      "$ref": "#/$defs/RoleKey"
    },
    "workspace_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceId"
      },
      "maxItems": 64,
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "role_key",
    "workspace_ids"
  ],
  "$defs": {
    "RoleKey": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "WorkspaceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}