{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageDeletionPublication",
  "type": "object",
  "properties": {
    "plan": {
      "$ref": "#/$defs/MessageDeletionPlan"
    },
    "request_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/MessageDeletionState"
    },
    "thread_id": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "revision",
    "request_generation",
    "plan",
    "state"
  ],
  "$defs": {
    "MessageDeletionIdentity": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "generation"
      ]
    },
    "MessageDeletionPlan": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "identity": {
          "$ref": "#/$defs/MessageDeletionIdentity"
        },
        "turn_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "identity",
        "workspace_id",
        "turn_id",
        "expected_revision"
      ]
    },
    "MessageDeletionState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "confirming"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conflicted": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "kind",
            "conflicted"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}