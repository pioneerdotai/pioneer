{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionDraftReconciliation",
  "type": "object",
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "draft": {
      "$ref": "#/$defs/ExecutionDraftSelection"
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutionDraftReconciliationReason"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "draft",
    "changed"
  ],
  "$defs": {
    "ExecutionDraftReconciliationKind": {
      "type": "string",
      "enum": [
        "policy_generation",
        "provider",
        "model",
        "permission_mode",
        "skill",
        "mcp_server",
        "attachment"
      ]
    },
    "ExecutionDraftReconciliationReason": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExecutionDraftReconciliationKind"
        },
        "reason": {
          "type": "string"
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ]
    },
    "ExecutionDraftSelection": {
      "type": "object",
      "properties": {
        "has_attachments": {
          "type": "boolean",
          "default": false
        },
        "mcp_server_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnPermissionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    }
  }
}