{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayEndpoint",
  "type": "object",
  "properties": {
    "gateway_base_url": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/GatewayEndpointKind"
    },
    "name": {
      "type": "string"
    },
    "server_gateway_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayId"
        },
        {
          "type": "null"
        }
      ]
    },
    "service_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "gateway_base_url",
    "kind"
  ],
  "$defs": {
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}