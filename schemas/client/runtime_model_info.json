{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeModelInfo",
  "type": "object",
  "properties": {
    "active": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "input_modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_custom": {
      "type": "boolean",
      "default": false
    },
    "max_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "max_output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supports_reasoning": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "supports_vision": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "id"
  ]
}