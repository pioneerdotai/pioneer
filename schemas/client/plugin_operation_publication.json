{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginOperationPublication",
  "type": "object",
  "properties": {
    "busy": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "native_operation_id": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "$ref": "#/$defs/PluginCommandOrigin"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginsMutationResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertain": {
      "type": "boolean"
    }
  },
  "required": [
    "generation",
    "origin",
    "busy",
    "uncertain"
  ],
  "$defs": {
    "PluginCommandOrigin": {
      "type": "object",
      "properties": {
        "authorization_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "connection_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "connection_id": {
          "anyOf": [
            {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "connection_generation",
        "authorization_sequence"
      ]
    },
    "PluginComponentItem": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "mcp_installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_key": {
          "type": "string"
        },
        "runtime_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "member_key",
        "status"
      ]
    },
    "PluginDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "PluginItem": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentItem"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "default": null
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginDiagnostic"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "state": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "state",
        "revision",
        "status",
        "components",
        "diagnostics"
      ]
    },
    "PluginsMutationResponse": {
      "type": "object",
      "properties": {
        "plugin": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginItem"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "removed"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}
