{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceSwitchResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "reduction": {
          "$ref": "#/$defs/WorkspaceSwitchSuccessReduction"
        },
        "status": {
          "type": "string",
          "const": "switched"
        }
      },
      "required": [
        "status",
        "reduction"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "missing_workspace_id"
        }
      },
      "required": [
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "busy"
        }
      },
      "required": [
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "noop"
        }
      },
      "required": [
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unknown_target"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "workspace_id"
      ]
    }
  ],
  "$defs": {
    "Workspace": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "is_active": {
          "type": "boolean"
        },
        "is_current": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "updated_at": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "name",
        "is_active",
        "is_current",
        "created_at",
        "updated_at"
      ]
    },
    "WorkspaceSelectionReduction": {
      "type": "object",
      "properties": {
        "persist_active_gateway_workspace_id": {
          "type": "string"
        },
        "refresh_thread_list": {
          "type": "boolean"
        },
        "set_preferred_workspace_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "persist_active_gateway_workspace_id",
        "set_preferred_workspace_id",
        "refresh_thread_list"
      ]
    },
    "WorkspaceSwitchSuccessReduction": {
      "type": "object",
      "properties": {
        "clear_thread_list_loading": {
          "type": "boolean"
        },
        "refresh_workspace_bound_screens": {
          "type": "boolean"
        },
        "selected": {
          "$ref": "#/$defs/WorkspaceSelectionReduction"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Workspace"
          }
        }
      },
      "required": [
        "workspaces",
        "selected",
        "clear_thread_list_loading",
        "refresh_workspace_bound_screens"
      ]
    }
  }
}