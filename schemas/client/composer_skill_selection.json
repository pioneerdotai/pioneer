{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerSkillSelection",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "skill"
        },
        "pack_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillPackId"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill_id": {
          "$ref": "#/$defs/SkillId"
        }
      },
      "required": [
        "kind",
        "skill_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "skill_pack"
        },
        "pack_id": {
          "$ref": "#/$defs/SkillPackId"
        }
      },
      "required": [
        "kind",
        "pack_id"
      ]
    }
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}