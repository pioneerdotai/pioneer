{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactActionStatus",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "Queued",
        "Verifying",
        "Opening",
        "Revealing"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Downloading": {
          "type": "object",
          "properties": {
            "downloaded_bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "total_bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "downloaded_bytes",
            "total_bytes"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Downloading"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Failed": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "Failed"
      ]
    }
  ]
}