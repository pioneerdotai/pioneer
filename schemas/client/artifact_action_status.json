    {
      "type": "string",
      "enum": [
        "Queued",
        "Downloading",
        "Verifying",
        "Opening",
        "Revealing"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Failed": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
