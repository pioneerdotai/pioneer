{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientComposerMcpToggleRequest",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComposerCapability"
      }
    },
    "row": {
      "$ref": "#/$defs/SelectableMcpCapability"
    },
    "selected_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "server_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SelectableMcpCapability"
      }
    },
    "tool_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SelectableMcpCapability"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "capabilities",
    "selected_keys",
    "server_rows",
    "tool_rows",
    "row"
  ],
  "$defs": {
    "ComposerCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "ComposerCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Skill": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "skill_id": {
                  "$ref": "#/$defs/SkillId"
                },
                "slug": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "slug",
                "source_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpServer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                }
              },
              "required": [
                "name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpServer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpTool": {
              "type": "object",
              "properties": {
                "raw_tool_name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                },
                "server_name": {
                  "type": "string"
                }
              },
              "required": [
                "server_name",
                "raw_tool_name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpTool"
          ]
        }
      ]
    },
    "McpCapabilityUnavailableReason": {
      "type": "string",
      "enum": [
        "DisabledByPolicy",
        "RuntimeUnavailable",
        "RuntimeNotReady",
        "NoToolCatalog"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SelectableMcpCapability": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "raw_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_kind": {
          "$ref": "#/$defs/McpScopeKind"
        },
        "selectable": {
          "type": "boolean"
        },
        "server_id": {
          "type": "string"
        },
        "server_name": {
          "type": "string"
        },
        "tools_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCapabilityUnavailableReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "label",
        "description",
        "server_id",
        "server_name",
        "scope_kind",
        "selectable"
      ]
    }
  }
}
