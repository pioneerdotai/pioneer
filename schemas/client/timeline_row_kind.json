{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineRowKind",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "Item": {
          "type": "object",
          "properties": {
            "timeline_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "timeline_index"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Item"
      ]
    },
    {
      "type": "object",
      "properties": {
        "TurnWorkToggle": {
          "$ref": "#/$defs/TurnWorkGroupRow"
        }
      },
      "additionalProperties": false,
      "required": [
        "TurnWorkToggle"
      ]
    },
    {
      "type": "object",
      "properties": {
        "CoalescedTools": {
          "$ref": "#/$defs/TimelineCoalescedToolsRow"
        }
      },
      "additionalProperties": false,
      "required": [
        "CoalescedTools"
      ]
    }
  ],
  "$defs": {
    "TimelineCoalescedToolsKind": {
      "type": "string",
      "enum": [
        "CompletedTaskTools",
        "RepeatedTaskWait"
      ]
    },
    "TimelineCoalescedToolsRow": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/TimelineCoalescedToolsKind"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "count",
        "is_open",
        "kind"
      ]
    },
    "TurnWorkGroupRow": {
      "type": "object",
      "properties": {
        "anchor_entry_id": {
          "type": "string"
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "anchor_entry_id",
        "is_open"
      ]
    }
  }
}