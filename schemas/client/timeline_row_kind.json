{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineRowKind",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "Item": {
          "type": "object",
          "properties": {
            "timeline_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "timeline_index"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Item"
      ]
    },
    {
      "type": "object",
      "properties": {
        "UserMessage": {
          "type": "object",
          "properties": {
            "presentation": {
              "$ref": "#/$defs/UserMessagePresentation"
            },
            "timeline_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "timeline_index",
            "presentation"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "UserMessage"
      ]
    },
    {
      "type": "object",
      "properties": {
        "TurnWorkToggle": {
          "$ref": "#/$defs/TurnWorkGroupRow"
        }
      },
      "additionalProperties": false,
      "required": [
        "TurnWorkToggle"
      ]
    },
    {
      "type": "object",
      "properties": {
        "CoalescedTools": {
          "$ref": "#/$defs/TimelineCoalescedToolsRow"
        }
      },
      "additionalProperties": false,
      "required": [
        "CoalescedTools"
      ]
    },
    {
      "type": "object",
      "properties": {
        "RunningTurn": {
          "$ref": "#/$defs/RunningTurnDisplay"
        }
      },
      "additionalProperties": false,
      "required": [
        "RunningTurn"
      ]
    }
  ],
  "$defs": {
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "AgentPresentationSnapshot": {
      "type": "object",
      "properties": {
        "agent_execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "agent_identity_id": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "identity_source_kind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "identity_source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nickname": {
          "type": "string"
        },
        "role_label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent_identity_id",
        "agent_execution_id",
        "identity_source_kind",
        "identity_source_revision",
        "display_name",
        "nickname"
      ]
    },
    "AgentResultReturnPolicy": {
      "type": "string",
      "enum": [
        "none",
        "summary_only",
        "full_result"
      ]
    },
    "AgentRouteAction": {
      "type": "string",
      "enum": [
        "send_message",
        "start_agent",
        "create_task",
        "schedule_task",
        "review_task_result",
        "deliver_result"
      ]
    },
    "AgentRouteDisclosurePolicy": {
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Exact, already-authorized artifact handles. Raw files and paths are\nnever represented by this flag.",
          "type": "boolean",
          "default": false
        },
        "context": {
          "description": "Bounded conversation excerpts or summaries selected by server policy.",
          "type": "boolean",
          "default": false
        },
        "resultReturn": {
          "description": "Result return is a separate disclosure class: allowing ordinary text\nmust never imply that a full Task result can cross a capsule boundary.",
          "$ref": "#/$defs/AgentResultReturnPolicy",
          "default": "none"
        },
        "text": {
          "description": "Explicit text authored for the routed operation.",
          "type": "boolean",
          "default": false
        },
        "userInput": {
          "description": "Explicit user-provided Task inputs. This is deliberately independent\nfrom Agent-authored text and inherited conversation context.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "AgentWorkGraphProjection": {
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Stable, bounded nodes in the exact root graph. No prompt, provider,\nmodel, thread title, runtime path, or other private payload is exposed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentWorkNodeProjection"
          }
        },
        "queuedCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rootExecutionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "runningCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "saturated": {
          "description": "True while one or more authorized nodes are durably queued for\nserver-owned capacity. This is resource state, not an authorization\nfailure and never implies that the whole graph is blocked.",
          "type": "boolean"
        },
        "terminalCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAtUnixMicros": {
          "description": "Monotonic persisted resource-state timestamp used only to reject stale\ngraph projections racing with live queue/promotion/finalization events.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "rootExecutionId",
        "updatedAtUnixMicros",
        "queuedCount",
        "runningCount",
        "terminalCount",
        "saturated",
        "nodes"
      ]
    },
    "AgentWorkNodeProjection": {
      "type": "object",
      "properties": {
        "executionId": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "progressLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/AgentWorkNodeState"
        }
      },
      "additionalProperties": false,
      "required": [
        "executionId",
        "state",
        "progressRevision"
      ]
    },
    "AgentWorkNodeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ClientSecurityDiagnostic": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/TurnSecurityCapabilityKind"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClientSecurityEnforcementStatus"
        }
      },
      "required": [
        "capability",
        "status",
        "message"
      ]
    },
    "ClientSecurityEnforcementStatus": {
      "type": "string",
      "enum": [
        "active",
        "degraded",
        "unavailable"
      ]
    },
    "ClientSecurityFilesystemAccess": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "ClientTurnSecuritySummary": {
      "type": "object",
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientSecurityDiagnostic"
          }
        },
        "enforcement": {
          "$ref": "#/$defs/ClientSecurityEnforcementStatus"
        },
        "execution_backend": {
          "$ref": "#/$defs/TurnSecurityExecutionBackendKind"
        },
        "filesystem_access": {
          "$ref": "#/$defs/ClientSecurityFilesystemAccess"
        },
        "network_mode": {
          "$ref": "#/$defs/TurnNetworkMode"
        },
        "permission_mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "sandbox_backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxBackendKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox_mode": {
          "$ref": "#/$defs/TurnSandboxMode"
        }
      },
      "required": [
        "permission_mode",
        "sandbox_mode",
        "filesystem_access",
        "network_mode",
        "execution_backend",
        "enforcement"
      ]
    },
    "CrossThreadSourceVisibility": {
      "type": "string",
      "enum": [
        "accessible",
        "inaccessible"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "PersistedActorRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentExecutionId"
            },
            "kind": {
              "type": "string",
              "const": "agent_execution"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "RunningTurnDisplay": {
      "type": "object",
      "properties": {
        "agent_work_graph": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentWorkGraphProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnAuthorSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnPermissionProfileSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRouteProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientTurnSecuritySummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnWorkState"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id"
      ]
    },
    "SafeRouteProvenance": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AgentRouteAction"
        },
        "disclosure": {
          "$ref": "#/$defs/AgentRouteDisclosurePolicy"
        },
        "sourceThreadLabel": {
          "description": "Present only when the viewer has source read authority.  Source title,\nparticipants, prompts, and raw identifiers are never sent otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/CrossThreadSourceVisibility"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "visibility",
        "disclosure"
      ]
    },
    "SandboxBackendKind": {
      "type": "string",
      "enum": [
        "nono",
        "windows_restricted_token",
        "provider_native"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ThreadMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Message",
            "Agent"
          ]
        },
        {
          "description": "Compatibility default for pre-Epic-6 persisted and wire values. New\nuser-thread creation selects `Message` explicitly.",
          "type": "string",
          "const": "Chat"
        }
      ]
    },
    "TimelineCoalescedToolsKind": {
      "type": "string",
      "enum": [
        "CompletedTaskTools",
        "RepeatedTaskWait"
      ]
    },
    "TimelineCoalescedToolsRow": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/TimelineCoalescedToolsKind"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "count",
        "is_open",
        "kind"
      ]
    },
    "TimelineReplyState": {
      "type": "string",
      "enum": [
        "available",
        "deleted",
        "unavailable"
      ]
    },
    "TimelineReplySummary": {
      "type": "object",
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnAuthorSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted": {
          "type": "boolean",
          "default": false
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "turnId"
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnAuthorSnapshot": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/PersistedActorRef"
        },
        "agent": {
          "description": "Full immutable identity presentation for an agent-authored Turn.  This\nis carried with the Turn instead of being reconstructed from mutable\nidentity/runtime state. Non-agent actors leave it absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentPresentationSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        }
      },
      "required": [
        "actor",
        "display_name",
        "nickname"
      ]
    },
    "TurnMcpServerCapabilitySummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scopeKind": {
          "$ref": "#/$defs/McpScopeKind"
        }
      },
      "required": [
        "id",
        "label",
        "name",
        "scopeKind"
      ]
    },
    "TurnMcpToolCapabilitySummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rawToolName": {
          "type": "string"
        },
        "scopeKind": {
          "$ref": "#/$defs/McpScopeKind"
        },
        "serverName": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "serverName",
        "rawToolName",
        "scopeKind"
      ]
    },
    "TurnMention": {
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "required": [
        "principal_id",
        "nickname"
      ]
    },
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSnapshot": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "source": {
          "$ref": "#/$defs/TurnPermissionProfileSource"
        }
      },
      "required": [
        "mode",
        "source",
        "effective_policy"
      ]
    },
    "TurnPermissionProfileSource": {
      "type": "string",
      "enum": [
        "composer",
        "defaulted",
        "inherited_from_parent_turn",
        "task_permission_cap",
        "system"
      ]
    },
    "TurnSandboxMode": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "TurnSecurityCapabilityKind": {
      "type": "string",
      "enum": [
        "filesystem",
        "network",
        "process",
        "approval",
        "sandbox_backend"
      ]
    },
    "TurnSecurityExecutionBackendKind": {
      "type": "string",
      "enum": [
        "native",
        "codex_cli",
        "claude_cli"
      ]
    },
    "TurnSkillCapabilitySummary": {
