{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineRowKind",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "Item": {
          "type": "object",
          "properties": {
            "timeline_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "timeline_index"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Item"
      ]
    },
    {
      "type": "object",
      "properties": {
        "TurnWorkToggle": {
          "$ref": "#/$defs/TurnWorkGroupRow"
        }
      },
      "additionalProperties": false,
      "required": [
        "TurnWorkToggle"
      ]
    },
    {
      "type": "object",
      "properties": {
        "CoalescedTools": {
          "$ref": "#/$defs/TimelineCoalescedToolsRow"
        }
      },
      "additionalProperties": false,
      "required": [
        "CoalescedTools"
      ]
    },
    {
      "type": "object",
      "properties": {
        "RunningTurn": {
          "$ref": "#/$defs/RunningTurnDisplay"
        }
      },
      "additionalProperties": false,
      "required": [
        "RunningTurn"
      ]
    }
  ],
  "$defs": {
    "ClientSecurityDiagnostic": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/TurnSecurityCapabilityKind"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClientSecurityEnforcementStatus"
        }
      },
      "required": [
        "capability",
        "status",
        "message"
      ]
    },
    "ClientSecurityEnforcementStatus": {
      "type": "string",
      "enum": [
        "active",
        "degraded",
        "unavailable"
      ]
    },
    "ClientSecurityFilesystemAccess": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "ClientTurnSecuritySummary": {
      "type": "object",
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientSecurityDiagnostic"
          }
        },
        "enforcement": {
          "$ref": "#/$defs/ClientSecurityEnforcementStatus"
        },
        "execution_backend": {
          "$ref": "#/$defs/TurnSecurityExecutionBackendKind"
        },
        "filesystem_access": {
          "$ref": "#/$defs/ClientSecurityFilesystemAccess"
        },
        "network_mode": {
          "$ref": "#/$defs/TurnNetworkMode"
        },
        "permission_mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "sandbox_backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxBackendKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox_mode": {
          "$ref": "#/$defs/TurnSandboxMode"
        }
      },
      "required": [
        "permission_mode",
        "sandbox_mode",
        "filesystem_access",
        "network_mode",
        "execution_backend",
        "enforcement"
      ]
    },
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "RunningTurnDisplay": {
      "type": "object",
      "properties": {
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnPermissionProfileSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientTurnSecuritySummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnWorkState"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id"
      ]
    },
    "SandboxBackendKind": {
      "type": "string",
      "enum": [
        "nono",
        "windows_restricted_token",
        "provider_native"
      ]
    },
    "TimelineCoalescedToolsKind": {
      "type": "string",
      "enum": [
        "CompletedTaskTools",
        "RepeatedTaskWait"
      ]
    },
    "TimelineCoalescedToolsRow": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/TimelineCoalescedToolsKind"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "count",
        "is_open",
        "kind"
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnNetworkMode": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "enabled"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSnapshot": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "source": {
          "$ref": "#/$defs/TurnPermissionProfileSource"
        }
      },
      "required": [
        "mode",
        "source",
        "effective_policy"
      ]
    },
    "TurnPermissionProfileSource": {
      "type": "string",
      "enum": [
        "composer",
        "defaulted",
        "inherited_from_parent_turn",
        "task_permission_cap",
        "system"
      ]
    },
    "TurnSandboxMode": {
      "type": "string",
      "enum": [
        "unrestricted",
        "read_only",
        "workspace_write"
      ]
    },
    "TurnSecurityCapabilityKind": {
      "type": "string",
      "enum": [
        "filesystem",
        "network",
        "process",
        "approval",
        "sandbox_backend"
      ]
    },
    "TurnSecurityExecutionBackendKind": {
      "type": "string",
      "enum": [
        "native",
        "codex_cli",
        "claude_cli"
      ]
    },
    "TurnWorkGroupRow": {
      "type": "object",
      "properties": {
        "anchor_entry_id": {
          "type": "string"
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "anchor_entry_id",
        "is_open"
      ]
    },
    "TurnWorkState": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting_for_approval",
        "stalled",
        "completed",
        "blocked",
        "failed",
        "interrupted"
      ]
    }
  }
}