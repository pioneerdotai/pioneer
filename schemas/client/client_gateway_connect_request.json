{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientGatewayConnectRequest",
  "type": "object",
  "properties": {
    "auth_token": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "endpoint": {
      "$ref": "#/$defs/GatewayEndpoint"
    },
    "timings": {
      "$ref": "#/$defs/ClientGatewayWsTimings"
    }
  },
  "additionalProperties": false,
  "required": [
    "endpoint",
    "timings"
  ],
  "$defs": {
    "ClientGatewayWsTimings": {
      "type": "object",
      "properties": {
        "connect_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ping_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pong_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reconnect_initial_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reconnect_jitter_percent": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "reconnect_max_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "connect_timeout_ms",
        "ping_interval_ms",
        "pong_timeout_ms",
        "reconnect_initial_ms",
        "reconnect_max_ms",
        "reconnect_jitter_percent"
      ]
    },
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "auth_token_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    }
  }
}