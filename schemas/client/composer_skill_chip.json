{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerSkillChip",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ComposerSkillChipKind"
    },
    "label": {
      "type": "string"
    },
    "pack_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillPackId"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "key",
    "label",
    "kind"
  ],
  "$defs": {
    "ComposerSkillChipKind": {
      "type": "string",
      "enum": [
        "skill_pack",
        "packed_skill",
        "standalone_skill"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}