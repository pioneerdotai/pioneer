{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PendingRequestPresentation",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingRequestAvailableAction"
      }
    },
    "details": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingRequestDetailRow"
      }
    },
    "kind_label": {
      "type": "string"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin_label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "user_input_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingRequestUserInputQuestion"
      }
    }
  },
  "required": [
    "origin_label",
    "kind_label",
    "title",
    "details",
    "user_input_questions",
    "actions"
  ],
  "$defs": {
    "PendingRequestActionKind": {
      "type": "string",
      "enum": [
        "cancel_turn",
        "deny",
        "allow",
        "allow_for_turn",
        "answer"
      ]
    },
    "PendingRequestAvailableAction": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PendingRequestActionKind"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingRequestResolution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "PendingRequestDetailRow": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "monospace": {
          "type": "boolean"
        },
        "style": {
          "$ref": "#/$defs/PendingRequestDetailStyle"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value",
        "monospace",
        "style"
      ]
    },
    "PendingRequestDetailStyle": {
      "type": "string",
      "enum": [
        "field",
        "diff"
      ]
    },
    "PendingRequestResolution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "const": "allow"
            }
          },
          "required": [
            "resolution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "const": "allow_for_turn"
            }
          },
          "required": [
            "resolution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "const": "allow_for_session"
            }
          },
          "required": [
            "resolution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolution": {
              "type": "string",
              "const": "deny"
            }
          },
          "required": [
            "resolution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "const": "cancel"
            }
          },
          "required": [
            "resolution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "const": "answered"
            },
            "response": true
          },
          "required": [
            "resolution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "resolution"
          ]
        }
      ]
    },
    "PendingRequestUserInputOption": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ]
    },
    "PendingRequestUserInputQuestion": {
      "type": "object",
      "properties": {
        "header": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "is_secret": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingRequestUserInputOption"
          }
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "options",
        "is_secret"
      ]
    }
  }
}