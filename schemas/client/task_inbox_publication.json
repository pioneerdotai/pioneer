{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskInboxPublication",
  "type": "object",
  "properties": {
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskInboxItem"
      }
    },
    "loading": {
      "type": "boolean"
    },
    "native_notifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskNotificationEffect"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "opened": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskNotificationPublication"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "unread_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "revision",
    "items",
    "unread_count",
    "native_notifications",
    "loading"
  ],
  "$defs": {
    "TaskCompletionInboxEntry": {
      "description": "One saved terminal run in the current user's workspace inbox. Contains no\nexecution-thread identity, raw failure, HTML, or full result payload.",
      "type": "object",
      "properties": {
        "completedAt": {
          "type": "integer",
          "format": "int64"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "readAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskRunStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "threadTitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "taskId",
        "runId",
        "title",
        "threadId",
        "threadTitle",
        "status",
        "completedAt"
      ]
    },
    "TaskInboxItem": {
      "type": "object",
      "properties": {
        "dismissing": {
          "type": "boolean"
        },
        "notification": {
          "$ref": "#/$defs/TaskCompletionInboxEntry"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "notification",
        "revision",
        "dismissing"
      ]
    },
    "TaskNotificationEffect": {
      "type": "object",
      "properties": {
        "notification_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "notification_id",
        "task_id",
        "revision"
      ]
    },
    "TaskNotificationPublication": {
      "type": "object",
      "properties": {
        "notification_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        },
        "task_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "notification_id",
        "task_id",
        "task_revision",
        "thread_id"
      ]
    },
    "TaskRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "waiting",
        "waiting_review",
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "timed_out"
      ]
    }
  }
}