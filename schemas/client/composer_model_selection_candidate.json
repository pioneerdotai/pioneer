{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerModelSelectionCandidate",
  "type": "object",
  "properties": {
    "has_turns": {
      "type": "boolean"
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComposerModelSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "workspace_id",
    "updated_at",
    "has_turns"
  ],
  "$defs": {
    "ComposerModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "selected_context_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "selected_reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_service_mode": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "authority": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "authority"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model"
      ]
    }
  }
}