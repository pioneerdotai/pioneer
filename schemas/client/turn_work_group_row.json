{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnWorkGroupRow",
  "type": "object",
  "properties": {
    "anchor_entry_id": {
      "type": "string"
    },
    "elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "is_open": {
      "type": "boolean"
    },
    "state": {
      "description": "Server-owned lifecycle state; clients must not infer it from row order.",
      "anyOf": [
        {
          "$ref": "#/$defs/TurnWorkState"
        },
        {
          "type": "null"
        }
      ]
    },
    "toggle_key": {
      "type": "string"
    }
  },
  "required": [
    "toggle_key",
    "anchor_entry_id",
    "is_open"
  ],
  "$defs": {
    "TurnWorkState": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting_for_approval",
        "stalled",
        "completed",
        "blocked",
        "failed",
        "interrupted"
      ]
    }
  }
}