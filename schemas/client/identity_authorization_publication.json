{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentityAuthorizationPublication",
  "type": "object",
  "properties": {
    "access_change": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessChangedNotification"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorization_change_sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "capabilities": {
      "$ref": "#/$defs/AuthorizationProjectionStore"
    },
    "capability_reads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapabilityReadState"
      }
    },
    "connection_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "connection_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "current_auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthMeResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_loading": {
      "type": "boolean"
    },
    "policy_change": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationProjectionChangedNotification"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_snapshots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AuthorizationCapabilitySnapshot"
      }
    },
    "workspace_snapshots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AuthorizationCapabilitySnapshot"
      }
    }
  },
  "required": [
    "connection_generation",
    "authorization_change_sequence",
    "capabilities",
    "capability_reads",
    "identity_loading",
    "workspace_snapshots",
    "thread_snapshots"
  ],
  "$defs": {
    "AccessChangeKind": {
      "description": "Payload-safe reason for invalidating client authorization-derived state.\n\nThis vocabulary deliberately contains no protected resource metadata or\npolicy-engine details.",
      "type": "string",
      "enum": [
        "workspace_membership",
        "thread_created",
        "thread_visibility",
        "thread_participant_added",
        "thread_participant_removed"
      ]
    },
    "AccessChangeOutcome": {
      "description": "Authoritative access result for the recipient of an access-change event.\nThis is required: omission is a protocol incompatibility, never a legacy\nsecurity mode.",
      "type": "string",
      "enum": [
        "retained",
        "revoked"
      ]
    },
    "AccessChangedNotification": {
      "description": "Minimal notification telling an authenticated client to re-resolve access.",
      "type": "object",
      "properties": {
        "authorization_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "change": {
          "$ref": "#/$defs/AccessChangeKind"
        },
        "outcome": {
          "description": "Server-resolved result for this exact recipient and affected scope.",
          "$ref": "#/$defs/AccessChangeOutcome"
        },
        "thread_id": {
          "description": "Exact affected thread when the committed ACL mutation is thread-scoped.\n\nThis is an opaque server-owned identifier, not protected thread\ncontent. It is omitted for workspace-wide changes and lets clients\nevict only the affected thread instead of discarding unrelated\nworkspace state.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "authorization_revision",
        "workspace_id",
        "outcome",
        "change"
      ]
    },
    "AuthDeviceSnapshot": {
      "type": "object",
      "properties": {
        "client_kind": {
          "$ref": "#/$defs/ClientKind"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/DeviceId"
        },
        "installation_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DeviceStatus"
        }
      },
      "required": [
        "id",
        "installation_id",
        "display_name",
        "client_kind",
        "status"
      ]
    },
    "AuthGatewaySnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/GatewayId"
        }
      },
      "required": [
        "id"
      ]
    },
    "AuthMeResponse": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/AuthDeviceSnapshot"
        },
        "gateway": {
          "$ref": "#/$defs/AuthGatewaySnapshot"
        },
        "principal": {
          "$ref": "#/$defs/AuthPrincipalSnapshot"
        },
        "role_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "$ref": "#/$defs/AuthSessionSnapshot"
        }
      },
      "required": [
        "gateway",
        "principal",
        "device",
        "session"
      ]
    },
    "AuthPrincipalSnapshot": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "nickname": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "display_name",
        "nickname"
      ]
    },
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AuthSessionSnapshot": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/DeviceId"
        },
        "id": {
          "$ref": "#/$defs/AuthSessionId"
        },
        "refresh_expires_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "refresh_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/AuthSessionStatus"
        },
        "token_family_id": {
          "$ref": "#/$defs/TokenFamilyId"
        }
      },
      "required": [
        "id",
        "device_id",
        "token_family_id",
        "status",
        "refresh_generation",
        "refresh_expires_at_unix"
      ]
    },
    "AuthSessionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked",
        "expired"
      ]
    },
    "AuthorizationAgentPermissionOption": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "locked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationPermissionLock"
          }
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "mode",
        "effective_policy"
      ]
    },
    "AuthorizationCapabilitySnapshot": {
      "type": "object",
      "properties": {
        "authorization_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "global": {
          "$ref": "#/$defs/AuthorizationGlobalCapabilities"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "role": {
          "$ref": "#/$defs/AuthorizationRolePresentation"
        },
        "role_key": {
          "description": "Stable built-in role identifier. Clients may display this value but\nmust never derive permissions from it.",
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationThreadCapabilitySnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationWorkspaceCapabilitySnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization_revision",
        "principal_id",
        "role_key",
        "role",
        "global"
      ]
    },
    "AuthorizationChangeKind": {
      "description": "Payload-safe type of committed authorization input change.",
      "type": "string",
      "enum": [
        "code_policy",
        "role_policy",
        "role_assignment",
        "workspace_acl",
        "thread_acl",
        "resource_selector"
      ]
    },
    "AuthorizationChangeScope": {
      "description": "Exact invalidation scope without policy contents or protected metadata.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "properties": {
            "role_key": {
              "$ref": "#/$defs/RoleKey"
            },
            "scope": {
              "type": "string",
              "const": "role"
            }
          },
          "required": [
            "scope",
            "role_key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "principal_id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "scope": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "scope",
            "principal_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "principal_id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "scope": {
              "type": "string",
              "const": "principal_workspace"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "principal_id",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "principal_id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "scope": {
              "type": "string",
              "const": "principal_thread"
            },
            "thread_id": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "principal_id",
            "workspace_id",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "invitation_id": {
              "$ref": "#/$defs/InvitationId"
            },
            "scope": {
              "type": "string",
              "const": "invitation"
            }
          },
          "required": [
            "scope",
            "invitation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "workspace"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "thread"
            },
            "thread_id": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "workspace_id",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "resource_selector"
            },
            "selector": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "workspace_id",
            "selector"
          ]
        }
      ]
    },
    "AuthorizationCliModelGrant": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "model"
      ]
    },
    "AuthorizationExecutionDraftPolicyProjection": {
      "type": "object",
      "properties": {
        "can_attach_artifacts": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string"
        },
        "mcp_invocation_limits": {
          "$ref": "#/$defs/McpInvocationResourceLimits"
        },
        "permission_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationAgentPermissionOption"
          }
        },
        "resources": {
          "$ref": "#/$defs/AuthorizationOperationalResourceProjection"
        }
      },
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "resources",
        "permission_options",
        "can_attach_artifacts",
        "mcp_invocation_limits"
      ]
    },
    "AuthorizationExecutionResourceLimits": {
      "type": "object",
      "properties": {
        "max_active_executions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_queued_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_scheduled_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_active_executions",
        "max_queued_tasks",
        "max_scheduled_tasks"
      ]
    },
    "AuthorizationGlobalCapabilities": {
      "type": "object",
      "properties": {
        "can_create_invitation": {
          "type": "boolean"
        },
        "can_create_workspace": {
          "type": "boolean"
        },
        "can_manage_all_threads": {
          "type": "boolean"
        },
        "can_manage_capabilities": {
          "type": "boolean"
        },
        "can_manage_cli_runtimes": {
          "type": "boolean"
        },
        "can_manage_gateway_settings": {
          "type": "boolean"
        },
        "can_manage_mcp": {
          "type": "boolean"
        },
        "can_manage_member_lifecycle": {
          "type": "boolean"
        },
        "can_manage_own_sessions": {
          "type": "boolean"
        },
        "can_manage_providers": {
          "type": "boolean"
        },
        "can_manage_skills": {
          "type": "boolean"
        },
        "can_view_invitations": {
          "type": "boolean"
        },
        "can_view_member_directory": {
          "type": "boolean"
        },
        "invitation_role_options": {
          "description": "Roles this principal may assign through a new invitation. The Gateway\nowns both availability and presentation; clients never manufacture a\nrole key from a local enum or principal kind.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationInvitationRoleOption"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "can_create_workspace",
        "can_manage_gateway_settings",
        "can_manage_capabilities",
        "can_manage_providers",
        "can_manage_mcp",
        "can_manage_skills",
        "can_manage_cli_runtimes",
        "can_manage_all_threads",
        "can_view_invitations",
        "can_create_invitation",
        "can_view_member_directory",
        "can_manage_member_lifecycle",
        "can_manage_own_sessions"
      ]
    },
    "AuthorizationInvitationRoleOption": {
      "type": "object",
      "properties": {
        "is_default": {
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/AuthorizationRolePresentation"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "is_default"
      ]
    },
    "AuthorizationOperationalResourceProjection": {
      "type": "object",
      "properties": {
        "cli_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationCliModelGrant"
          }
        },
        "cli_models_all": {
          "description": "Same contract as `provider_models_all`, scoped to allowed CLI runtimes.",
          "type": "boolean"
        },
        "cli_runtimes": {
          "$ref": "#/$defs/AuthorizationResourceSelector"
        },
        "fingerprint": {
          "description": "Opaque receipt over role policy, workspace and authorization revision.",
          "type": "string"
        },
        "mcp_servers": {
          "$ref": "#/$defs/AuthorizationResourceSelector"
        },
        "provider_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationProviderModelGrant"
          }
        },
        "provider_models_all": {
          "description": "`true` means every model of an allowed provider; `false` means the\nexact grants below. The flag preserves the distinction between an\nunrestricted model set and an intentionally empty one.",
          "type": "boolean"
        },
        "providers": {
          "$ref": "#/$defs/AuthorizationResourceSelector"
        },
        "skills": {
          "$ref": "#/$defs/AuthorizationResourceSelector"
        }
      },
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "providers",
        "provider_models_all",
        "cli_runtimes",
        "cli_models_all",
        "skills",
        "mcp_servers"
      ]
    },
    "AuthorizationPermissionLock": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ]
    },
    "AuthorizationProjectionChangedNotification": {
      "type": "object",
      "properties": {
        "affected": {
          "$ref": "#/$defs/AuthorizationChangeScope"
        },
        "change": {
          "$ref": "#/$defs/AuthorizationChangeKind"
        },
        "policy_generation": {
          "$ref": "#/$defs/PolicyGeneration"
        }
      },
      "required": [
        "policy_generation",
        "change",
        "affected"
      ]
    },
    "AuthorizationProjectionManifest": {
      "type": "object",
      "properties": {
        "global": {
          "$ref": "#/$defs/AuthorizationGlobalCapabilities"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "role": {
          "$ref": "#/$defs/AuthorizationRolePresentation"
        },
        "role_key": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "principal_id",
        "role_key",
        "role",
        "global"
      ]
    },
    "AuthorizationProjectionStore": {
      "description": "Coherent authorization projections for one connection epoch. All shells\nfeed every scoped response through this store before exposing any bit to UI\nconsumers.",
      "type": "object",
      "properties": {
        "accepted_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationProjectionManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "threads": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AuthorizationThreadCapabilitySnapshot"
          }
        },
        "workspaces": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AuthorizationWorkspaceCapabilitySnapshot"
          }
        }
      },
      "required": [
        "workspaces",
        "threads"
      ]
    },
    "AuthorizationProviderModelGrant": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ]
    },
    "AuthorizationResourceSelector": {
      "description": "Role-scoped constraints used by discovery and exact admission. `all=true`\nmeans every operationally enabled resource of that kind; otherwise only\nthe listed stable identifiers are visible and usable.",
      "type": "object",
      "properties": {
        "all": {
          "type": "boolean"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "all"
      ]
    },
    "AuthorizationRolePresentation": {
      "description": "Server-owned presentation metadata for the authenticated role. The key is\ndeliberately open-ended: clients display this object but never derive\nauthorization decisions from it.",
      "type": "object",
      "properties": {
        "built_in": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "display_name",
        "description",
        "built_in"
      ]
    },
    "AuthorizationThreadCapabilities": {
      "type": "object",
      "properties": {
        "can_bind_artifacts": {
          "type": "boolean"
        },
        "can_cancel_agent_execution": {
          "type": "boolean"
        },
        "can_cancel_tasks": {
          "type": "boolean"
        },
        "can_control_cli_runtime": {
          "type": "boolean"
        },
        "can_create_task": {
          "type": "boolean"
        },
        "can_delete_own_message": {
          "type": "boolean"
        },
        "can_edit_own_message": {
          "type": "boolean"
        },
        "can_manage": {
          "type": "boolean"
        },
        "can_manage_agents_document": {
          "type": "boolean"
        },
        "can_manage_private_participants": {
          "type": "boolean"
        },
        "can_move": {
          "type": "boolean"
        },
        "can_observe_agent_execution": {
          "type": "boolean"
        },
        "can_observe_agent_requests": {
          "type": "boolean"
        },
        "can_read": {
          "type": "boolean"
        },
        "can_read_agents_document": {
          "type": "boolean"
        },
        "can_read_artifacts": {
          "type": "boolean"
        },
        "can_respond_to_agent_requests": {
          "type": "boolean"
        },
        "can_resume_agent_execution": {
          "type": "boolean"
        },
        "can_review_tasks": {
          "type": "boolean"
        },
        "can_start_turn": {
          "type": "boolean"
        },
        "can_steer_agent_execution": {
          "type": "boolean"
        },
        "can_write": {
          "type": "boolean"
        },
        "can_write_artifacts": {
