{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientComposerMcpCapabilityFromRowRequest",
  "type": "object",
  "properties": {
    "row": {
      "$ref": "#/$defs/SelectableMcpCapability"
    }
  },
  "additionalProperties": false,
  "required": [
    "row"
  ],
  "$defs": {
    "McpCapabilityUnavailableReason": {
      "type": "string",
      "enum": [
        "DisabledByPolicy",
        "RuntimeUnavailable",
        "RuntimeNotReady",
        "NoToolCatalog"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SelectableMcpCapability": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "raw_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_kind": {
          "$ref": "#/$defs/McpScopeKind"
        },
        "selectable": {
          "type": "boolean"
        },
        "server_id": {
          "type": "string"
        },
        "server_name": {
          "type": "string"
        },
        "tools_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCapabilityUnavailableReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "label",
        "description",
        "server_id",
        "server_name",
        "scope_kind",
        "selectable"
      ]
    }
  }
}