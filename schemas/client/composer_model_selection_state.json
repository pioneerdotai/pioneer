{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerModelSelectionState",
  "type": "object",
  "properties": {
    "manually_selected": {
      "type": "boolean"
    },
    "selected_context_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_context_window": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "selected_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_service_mode": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "authority": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "authority"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "manually_selected"
  ]
}