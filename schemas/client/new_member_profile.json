{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewMemberProfile",
  "type": "object",
  "properties": {
    "avatar": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileAvatarInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "display_name": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "nickname": {
      "type": "string",
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "display_name",
    "nickname"
  ],
  "$defs": {
    "ProfileAvatarInput": {
      "type": "object",
      "properties": {
        "content_base64": {
          "type": "string",
          "maxLength": 349528,
          "minLength": 1
        },
        "media_type": {
          "$ref": "#/$defs/ProfileAvatarMediaType"
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type",
        "content_base64"
      ]
    },
    "ProfileAvatarMediaType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    }
  }
}