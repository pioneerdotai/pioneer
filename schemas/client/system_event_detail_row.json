{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemEventDetailRow",
  "type": "object",
  "properties": {
    "label": {
      "$ref": "#/$defs/SystemEventDetailLabel"
    },
    "value": {
      "$ref": "#/$defs/SystemEventDetailValue"
    }
  },
  "required": [
    "label",
    "value"
  ],
  "$defs": {
    "SystemEventDetailLabel": {
      "type": "string",
      "enum": [
        "Window",
        "Status",
        "Reason",
        "WindowExhaustion",
        "Checkpoint",
        "PreviousWindow",
        "Limit",
        "AgentRounds",
        "ToolCalls",
        "ProviderTokens",
        "TotalWindows",
        "CheckpointKind",
        "CheckpointSize"
      ]
    },
    "SystemEventDetailValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "WindowIndex": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "WindowIndex"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Bytes"
          ]
        }
      ]
    }
  }
}