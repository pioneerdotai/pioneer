{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeDiagnostic",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "level": {
      "$ref": "#/$defs/RuntimeDiagnosticLevel"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "level",
    "code",
    "message"
  ],
  "$defs": {
    "RuntimeDiagnosticLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    }
  }
}