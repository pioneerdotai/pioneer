{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrepareVoiceComposerSnapshotRequest",
  "type": "object",
  "properties": {
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComposerAttachment"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComposerCapability"
      }
    },
    "cli_runtime_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnCLIRuntimeOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentExecutionBackend"
        },
        {
          "type": "null"
        }
      ]
    },
    "permission_mode": {
      "$ref": "#/$defs/TurnPermissionMode"
    },
    "selected_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "turn_model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id",
    "attachments",
    "capabilities",
    "permission_mode"
  ],
  "$defs": {
    "AgentExecutionBackend": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "apiProvider"
            }
          },
          "required": [
            "type",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "runtime_kind": {
              "$ref": "#/$defs/CLIAgentRuntimeKind"
            },
            "type": {
              "type": "string",
              "const": "cliAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id",
            "runtime_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "acpAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id"
          ]
        }
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "ComposerAttachment": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerAttachmentKind"
        },
        "path": {
          "type": "string"
        },
        "upload_state": {
          "$ref": "#/$defs/ComposerAttachmentUploadState"
        }
      },
      "required": [
        "path",
        "file_name",
        "kind",
        "upload_state"
      ]
    },
    "ComposerAttachmentKind": {
      "type": "string",
      "enum": [
        "Image",
        "File",
        "Audio",
        "Video"
      ]
    },
    "ComposerAttachmentUploadState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Local",
            "Uploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Uploaded": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Uploaded"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Failed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Failed"
          ]
        }
      ]
    },
    "ComposerCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "ComposerCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Skill": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "skill_id": {
                  "$ref": "#/$defs/SkillId"
                },
                "slug": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "slug",
                "source_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpServer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                }
              },
              "required": [
                "name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpServer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpTool": {
              "type": "object",
              "properties": {
                "raw_tool_name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                },
                "server_name": {
                  "type": "string"
                }
              },
              "required": [
                "server_name",
                "raw_tool_name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpTool"
          ]
        }
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ThreadMode": {
      "type": "string",
      "enum": [
        "Chat",
        "Agent"
      ]
    },
    "TurnCLIRuntimeOptions": {
      "type": "object",
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "personality": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox": true,
        "steer_if_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    }
  }
}
