{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceFinalizeResponseReduction",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/VoiceFinalizeUiAction"
    },
    "session_id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VoiceStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "action"
  ],
  "$defs": {
    "VoiceFinalizeUiAction": {
      "type": "string",
      "enum": [
        "keep_finalizing",
        "clear_finalizing",
        "show_no_speech_error",
        "show_finalize_error"
      ]
    },
    "VoiceStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "disabled",
            "unavailable",
            "model_loading",
            "ready",
            "busy",
            "recording",
            "transcribing",
            "error"
          ]
        },
        {
          "description": "Model download is happening in the gateway background. First pass UI\nshould not infer or require detailed progress from this status.",
          "type": "string",
          "const": "model_downloading"
        }
      ]
    }
  }
}