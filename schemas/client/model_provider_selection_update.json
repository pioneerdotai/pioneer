{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelProviderSelectionUpdate",
  "type": "object",
  "properties": {
    "clear_models": {
      "type": "boolean"
    },
    "loading_models": {
      "type": "boolean"
    },
    "selected_context_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_context_window": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "selected_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "clear_models",
    "loading_models"
  ]
}