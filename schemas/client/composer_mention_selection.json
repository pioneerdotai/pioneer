{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerMentionSelection",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "principal_id": {
      "$ref": "#/$defs/PrincipalId"
    },
    "text_token": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "principal_id",
    "display_name",
    "nickname",
    "text_token"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}