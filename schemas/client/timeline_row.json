{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineRow",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/TimelineRowKind"
    }
  },
  "required": [
    "key",
    "kind"
  ],
  "$defs": {
    "PermissionBehavior": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "RunningTurnDisplay": {
      "type": "object",
      "properties": {
        "permission_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnPermissionProfileSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id"
      ]
    },
    "TimelineCoalescedToolsKind": {
      "type": "string",
      "enum": [
        "CompletedTaskTools",
        "RepeatedTaskWait"
      ]
    },
    "TimelineCoalescedToolsRow": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/TimelineCoalescedToolsKind"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "count",
        "is_open",
        "kind"
      ]
    },
    "TimelineRowKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Item": {
              "type": "object",
              "properties": {
                "timeline_index": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "timeline_index"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "TurnWorkToggle": {
              "$ref": "#/$defs/TurnWorkGroupRow"
            }
          },
          "additionalProperties": false,
          "required": [
            "TurnWorkToggle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "CoalescedTools": {
              "$ref": "#/$defs/TimelineCoalescedToolsRow"
            }
          },
          "additionalProperties": false,
          "required": [
            "CoalescedTools"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RunningTurn": {
              "$ref": "#/$defs/RunningTurnDisplay"
            }
          },
          "additionalProperties": false,
          "required": [
            "RunningTurn"
          ]
        }
      ]
    },
    "ToolPermissionPolicySnapshot": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computer_use": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "default_behavior": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dynamic_skill_tool": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "file_write": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_read": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "mcp_write_or_unknown": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "network": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "shell_command": {
          "$ref": "#/$defs/PermissionBehavior"
        },
        "task_subagent": {
          "$ref": "#/$defs/PermissionBehavior"
        }
      },
      "required": [
        "default_behavior",
        "file_read",
        "file_write",
        "shell_command",
        "network",
        "mcp_read",
        "mcp_write_or_unknown",
        "dynamic_skill_tool",
        "computer_use",
        "task_subagent"
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSnapshot": {
      "type": "object",
      "properties": {
        "effective_policy": {
          "$ref": "#/$defs/ToolPermissionPolicySnapshot"
        },
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        },
        "source": {
          "$ref": "#/$defs/TurnPermissionProfileSource"
        }
      },
      "required": [
        "mode",
        "source",
        "effective_policy"
      ]
    },
    "TurnPermissionProfileSource": {
      "type": "string",
      "enum": [
        "composer",
        "defaulted",
        "inherited_from_parent_turn",
        "task_permission_cap",
        "system"
      ]
    },
    "TurnWorkGroupRow": {
      "type": "object",
      "properties": {
        "anchor_entry_id": {
          "type": "string"
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "is_open": {
          "type": "boolean"
        },
        "toggle_key": {
          "type": "string"
        }
      },
      "required": [
        "toggle_key",
        "anchor_entry_id",
        "is_open"
      ]
    }
  }
}