{
  "type": "object",
  "properties": {
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillUploadFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "mutation_uncertain": {
      "type": "boolean"
    },
    "operation_id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "pack": {
      "type": "boolean"
    },
    "plugin_preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginPreviewPublication"
        },
        {
          "type": "null"
        }
      ]
    },
    "plugin_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginItem"
        },
        {
          "type": "null"
        }
      ]
    },
    "plugin_update_preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginUpdatePreviewPublication"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "sent_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/SkillUploadState"
    },
    "target": {
      "$ref": "#/$defs/SkillUploadTarget"
    },
    "total_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "operation_id",
    "generation",
    "revision",
    "state",
    "sent_bytes",
    "total_bytes",
    "target",
    "pack",
    "mutation_uncertain"
  ],
  "$defs": {
    "PluginComponentItem": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "mcp_installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_key": {
          "type": "string"
        },
        "runtime_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "member_key",
        "status"
      ]
    },
    "PluginComponentKey": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "member_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "member_key"
      ]
    },
    "PluginDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "PluginItem": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentItem"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "default": null
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginDiagnostic"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "state": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "state",
        "revision",
        "status",
        "components",
        "diagnostics"
      ]
    },
    "PluginPreviewPublication": {
      "type": "object",
      "properties": {
        "package": {
          "$ref": "#/$defs/PluginsPreviewResponse"
        },
        "upload_id": {
          "type": "string"
        }
      },
      "required": [
        "upload_id",
        "package"
      ]
    },
    "PluginUpdatePreviewPublication": {
      "type": "object",
      "properties": {
        "preview": {
          "$ref": "#/$defs/PluginsUpdatePreviewResponse"
        },
        "upload_id": {
          "type": "string"
        }
      },
      "required": [
        "upload_id",
        "preview"
      ]
    },
    "PluginsPreviewResponse": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentItem"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "default": null
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginDiagnostic"
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "fingerprint",
        "components",
        "diagnostics"
      ]
    },
    "PluginsUpdatePreviewResponse": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentKey"
          }
        },
        "authorization_changes": {
          "description": "Conservative disclosure of changed MCP configurations that may need sign-in.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentKey"
          }
        },
        "identity_resets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentKey"
          }
        },
        "package": {
          "$ref": "#/$defs/PluginsPreviewResponse"
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentKey"
          }
        },
        "supporting_files_changed": {
          "type": "boolean",
          "default": false
        },
        "updated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentKey"
          }
        }
      },
      "required": [
        "package",
        "added",
        "updated",
        "identity_resets",
        "removed",
        "authorization_changes"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillUploadFailure": {
      "type": "string",
      "enum": [
        "source_unavailable",
        "source_changed",
        "source_too_large",
        "invalid_package",
        "gateway_unavailable",
        "access_denied",
        "busy",
        "unknown"
      ]
    },
    "SkillUploadState": {
      "type": "string",
      "enum": [
        "preparing",
        "starting",
        "uploading",
        "finishing",
        "applying",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "SkillUploadTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin_install"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "install"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update"
            },
            "skill_id": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update_pack"
            },
            "pack_id": {
              "$ref": "#/$defs/SkillPackId"
            }
          },
          "required": [
            "kind",
            "pack_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin_preview"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_revision": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "plugin_update_preview"
            },
            "plugin_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "plugin_id",
            "expected_revision"
          ]
        }
      ]
    }
  }
}
