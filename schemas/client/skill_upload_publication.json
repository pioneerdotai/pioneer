{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillUploadPublication",
  "type": "object",
  "properties": {
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "operation_id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "pack": {
      "type": "boolean"
    },
    "plugin_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginItem"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "sent_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/SkillUploadState"
    },
    "target": {
      "$ref": "#/$defs/SkillUploadTarget"
    },
    "total_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "operation_id",
    "generation",
    "revision",
    "state",
    "sent_bytes",
    "total_bytes",
    "target",
    "pack"
  ],
  "$defs": {
    "PluginComponentItem": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "mcp_installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_key": {
          "type": "string"
        },
        "runtime_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "member_key",
        "status"
      ]
    },
    "PluginDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "PluginItem": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginComponentItem"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginDiagnostic"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "state": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "state",
        "revision",
        "status",
        "components",
        "diagnostics"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillUploadState": {
      "type": "string",
      "enum": [
        "preparing",
        "starting",
        "uploading",
        "finishing",
        "applying",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "SkillUploadTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin_install"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "install"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update"
            },
            "skill_id": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update_pack"
            },
            "pack_id": {
              "$ref": "#/$defs/SkillPackId"
            }
          },
          "required": [
            "kind",
            "pack_id"
          ]
        }
      ]
    }
  }
}