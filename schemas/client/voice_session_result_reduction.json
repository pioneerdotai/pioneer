{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceSessionResultReduction",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/VoiceFinalizeUiAction"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceError"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "$ref": "#/$defs/VoiceSessionOutcome"
    },
    "session_id": {
      "type": "string"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "outcome",
    "action"
  ],
  "$defs": {
    "PublicError": {
      "description": "Stable, bounded failure presentation shared by RPC, voice and task\nexecution surfaces. Raw source chains are never part of this type.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PublicErrorCode"
        },
        "correlation_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PublicErrorStage"
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "code",
        "stage",
        "message",
        "retryable",
        "correlation_id"
      ]
    },
    "PublicErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "policy_denied",
        "not_found",
        "conflict",
        "resource_exhausted",
        "unavailable",
        "timeout",
        "internal"
      ]
    },
    "PublicErrorStage": {
      "type": "string",
      "enum": [
        "discovery",
        "admission",
        "preparation",
        "execution",
        "persistence",
        "delivery",
        "observation"
      ]
    },
    "VoiceError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/VoiceErrorKind"
        },
        "message": {
          "type": "string"
        },
        "public_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    "VoiceErrorKind": {
      "type": "string",
      "enum": [
        "model_unavailable",
        "microphone_permission_blocked",
        "device_unavailable",
        "invalid_session",
        "stale_chunk",
        "sequence_gap",
        "cancelled",
        "no_speech",
        "transcription_failed",
        "gateway_busy",
        "model_downloading",
        "unknown"
      ]
    },
    "VoiceFinalizeUiAction": {
      "type": "string",
      "enum": [
        "keep_finalizing",
        "clear_finalizing",
        "show_no_speech_error",
        "show_finalize_error"
      ]
    },
    "VoiceSessionOutcome": {
      "type": "string",
      "enum": [
        "turn_started",
        "cancelled",
        "no_speech",
        "failed"
      ]
    }
  }
}