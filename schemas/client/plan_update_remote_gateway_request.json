{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanUpdateRemoteGatewayRequest",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "auth_token_update": {
      "$ref": "#/$defs/GatewayAuthTokenUpdate"
    },
    "default_remote_name": {
      "type": "string"
    },
    "gateway_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "registry": {
      "$ref": "#/$defs/GatewayRegistry"
    }
  },
  "additionalProperties": false,
  "required": [
    "registry",
    "gateway_id",
    "name",
    "address",
    "auth_token_update",
    "default_remote_name"
  ],
  "$defs": {
    "GatewayAuthTokenUpdate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "preserve"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "replace"
            },
            "token": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "clear"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "auth_token_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayRegistry": {
      "type": "object",
      "properties": {
        "active_gateway_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayEndpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "remotes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GatewayEndpoint"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    }
  }
}