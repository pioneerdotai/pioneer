{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientNavigationState",
  "type": "object",
  "properties": {
    "active_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "administration": {
      "$ref": "#/$defs/AdministrationRoute"
    },
    "agents_document_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentsDocEditorScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "destination": {
      "$ref": "#/$defs/SemanticDestination"
    },
    "drafts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "last_active": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskThreadLineage"
      }
    },
    "mcp_server_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "providers": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderFilter"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "#/$defs/SettingsRoute"
    },
    "skill_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillId"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "drafts",
    "last_active",
    "destination",
    "lineage",
    "administration",
    "settings"
  ],
  "$defs": {
    "AdministrationRoute": {
      "type": "string",
      "enum": [
        "Members",
        "Invitations"
      ]
    },
    "AgentsDocEditorScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "folder_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "folder"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id",
            "folder_id"
          ]
        }
      ]
    },
    "ProviderFilter": {
      "type": "string",
      "enum": [
        "Api",
        "Connected",
        "Cli"
      ]
    },
    "SemanticDestination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "threads"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agents_document"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/$defs/ProviderFilter"
            },
            "kind": {
              "type": "string",
              "const": "providers"
            }
          },
          "required": [
            "kind",
            "filter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administration"
            },
            "route": {
              "$ref": "#/$defs/AdministrationRoute"
            }
          },
          "required": [
            "kind",
            "route"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "server_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skills"
            },
            "skill_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settings"
            },
            "route": {
              "$ref": "#/$defs/SettingsRoute"
            }
          },
          "required": [
            "kind",
            "route"
          ]
        }
      ]
    },
    "SettingsRoute": {
      "type": "string",
      "enum": [
        "General",
        "Account",
        "Memory",
        "SelfImprovement"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TaskThreadLineage": {
      "type": "object",
      "properties": {
        "child_thread_id": {
          "type": "string"
        },
        "parent_thread_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "parent_thread_id",
        "child_thread_id",
        "workspace_id",
        "title"
      ]
    }
  }
}