{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AddAndActivateRemoteGatewayRegistryPlan",
  "type": "object",
  "properties": {
    "endpoint": {
      "$ref": "#/$defs/GatewayEndpoint"
    },
    "previous_active_gateway_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayEndpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "registry": {
      "$ref": "#/$defs/GatewayRegistry"
    },
    "token_write": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayAuthTokenWrite"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "registry",
    "endpoint"
  ],
  "$defs": {
    "GatewayAuthTokenWrite": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "token_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token_ref",
        "token",
        "label"
      ]
    },
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "auth_token_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayRegistry": {
      "type": "object",
      "properties": {
        "active_gateway_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayEndpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "remotes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GatewayEndpoint"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    }
  }
}