{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerCapabilityKind",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "Plugin": {
          "type": "object",
          "properties": {
            "expected_revision": {
              "type": "integer",
              "format": "int64"
            },
            "plugin_id": {
              "type": "string"
            }
          },
          "required": [
            "plugin_id",
            "expected_revision"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Plugin"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Skill": {
          "type": "object",
          "properties": {
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "skill_id": {
              "$ref": "#/$defs/SkillId"
            },
            "slug": {
              "type": "string"
            },
            "source_kind": {
              "type": "string"
            }
          },
          "required": [
            "skill_id",
            "slug",
            "source_kind"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Skill"
      ]
    },
    {
      "type": "object",
      "properties": {
        "McpServer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "scope_kind": {
              "$ref": "#/$defs/McpScopeKind"
            }
          },
          "required": [
            "name",
            "scope_kind"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "McpServer"
      ]
    },
    {
      "type": "object",
      "properties": {
        "McpTool": {
          "type": "object",
          "properties": {
            "raw_tool_name": {
              "type": "string"
            },
            "scope_kind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "server_name": {
              "type": "string"
            }
          },
          "required": [
            "server_name",
            "raw_tool_name",
            "scope_kind"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "McpTool"
      ]
    }
  ],
  "$defs": {
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}