{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemberListResponse",
  "type": "object",
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemberSummary"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "members"
  ],
  "$defs": {
    "MemberSummary": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "nickname": {
          "type": "string"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "role_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "kind",
        "display_name",
        "nickname",
        "status"
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "PrincipalKind": {
      "type": "string",
      "enum": [
        "superuser",
        "user"
      ]
    },
    "PrincipalStatus": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "removed"
      ]
    },
    "RoleKey": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
  }
}