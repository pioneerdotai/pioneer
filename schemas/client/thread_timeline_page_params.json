{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadTimelinePageParams",
  "type": "object",
  "properties": {
    "anchor": {
      "$ref": "#/$defs/TimelinePageAnchor",
      "default": {
        "kind": "newest"
      }
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "threadId"
  ],
  "$defs": {
    "TimelineCursor": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "TimelinePageAnchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "newest"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oldest"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "$ref": "#/$defs/TimelineCursor"
            },
            "kind": {
              "type": "string",
              "const": "before"
            }
          },
          "required": [
            "kind",
            "cursor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "$ref": "#/$defs/TimelineCursor"
            },
            "kind": {
              "type": "string",
              "const": "after"
            }
          },
          "required": [
            "kind",
            "cursor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "$ref": "#/$defs/TimelineCursor"
            },
            "kind": {
              "type": "string",
              "const": "around"
            }
          },
          "required": [
            "kind",
            "cursor"
          ]
        }
      ]
    }
  }
}