{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanAddRemoteGatewayRequest",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "auth_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_remote_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "new_endpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry": {
      "$ref": "#/$defs/GatewayRegistry"
    }
  },
  "additionalProperties": false,
  "required": [
    "registry",
    "name",
    "address",
    "default_remote_name"
  ],
  "$defs": {
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "auth_token_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayRegistry": {
      "type": "object",
      "properties": {
        "active_gateway_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local": {
          "$ref": "#/$defs/GatewayEndpoint"
        },
        "remotes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GatewayEndpoint"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "local"
      ]
    }
  }
}