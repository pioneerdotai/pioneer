{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientVoiceInputPlanRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "settings_action"
        },
        "request": {
          "$ref": "#/$defs/VoiceInputSettingsPlanRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "current": {
          "$ref": "#/$defs/GatewayVoiceInputSettings"
        },
        "operation": {
          "type": "string",
          "const": "status_reduction"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "current"
      ]
    }
  ],
  "$defs": {
    "GatewayVoiceInputProvider": {
      "type": "string",
      "enum": [
        "local"
      ]
    },
    "GatewayVoiceInputRuntimePhase": {
      "type": "string",
      "enum": [
        "disabled",
        "model_not_selected",
        "missing",
        "downloading",
        "installing",
        "loading",
        "ready",
        "failed"
      ]
    },
    "GatewayVoiceInputRuntimeSnapshot": {
      "type": "object",
      "properties": {
        "downloaded_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "effective_enabled": {
          "type": "boolean",
          "default": false
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/GatewayVoiceInputRuntimePhase",
          "default": "disabled"
        },
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "GatewayVoiceInputSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayVoiceInputProvider"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "$ref": "#/$defs/GatewayVoiceInputRuntimeSnapshot",
          "default": {
            "effective_enabled": false,
            "phase": "disabled"
          }
        }
      }
    },
    "VoiceInputSettingsAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "enable"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "disable"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "select"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "retry"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "VoiceInputSettingsPlanRequest": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/VoiceInputSettingsAction"
        },
        "current": {
          "$ref": "#/$defs/GatewayVoiceInputSettings"
        }
      },
      "required": [
        "current",
        "action"
      ]
    }
  }
}