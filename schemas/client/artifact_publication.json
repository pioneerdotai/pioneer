{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactPublication",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactActionPublication"
      }
    },
    "downloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactDownloadPublication"
      }
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactSummary"
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactPreviewPublication"
      }
    },
    "request": {
      "$ref": "#/$defs/ArtifactReadState"
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "thread_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "workspace_id",
    "revision",
    "generation",
    "items",
    "request",
    "downloads",
    "actions",
    "previews"
  ],
  "$defs": {
    "ArtifactActionIdentity": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_id": {
          "type": "string"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "thread_id",
        "artifact_id",
        "generation"
      ]
    },
    "ArtifactActionKind": {
      "type": "string",
      "enum": [
        "open",
        "share",
        "download",
        "reveal"
      ]
    },
    "ArtifactActionPublication": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ArtifactActionKind"
        },
        "download": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDownloadIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "identity": {
          "$ref": "#/$defs/ArtifactActionIdentity"
        },
        "local_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactLocalFile"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/ArtifactActionState"
        },
        "target": {
          "$ref": "#/$defs/ArtifactDownloadTarget"
        }
      },
      "required": [
        "identity",
        "target",
        "action",
        "state"
      ]
    },
    "ArtifactActionState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "preparing"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resolving"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "verifying"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "presenting"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "kind",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ArtifactBindingDirection": {
      "type": "string",
      "enum": [
        "input",
        "output",
        "context",
        "derived"
      ]
    },
    "ArtifactBindingKind": {
      "type": "string",
      "enum": [
        "user_input",
        "agent_output",
        "tool_output",
        "task_result",
        "task_result_candidate",
        "context_attachment",
        "derived_from",
        "preview",
        "manual_attach",
        "draft_upload"
      ]
    },
    "ArtifactBindingSummary": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "binding_kind": {
          "$ref": "#/$defs/ArtifactBindingKind"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "direction": {
          "$ref": "#/$defs/ArtifactBindingDirection"
        },
        "item_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "workspace_id",
        "binding_kind",
        "direction",
        "created_at"
      ]
    },
    "ArtifactCreatedByKind": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "tool",
        "task",
        "system",
        "import",
        "external_agent"
      ]
    },
    "ArtifactDownloadIdentity": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "generation"
      ]
    },
    "ArtifactDownloadPublication": {
      "type": "object",
      "properties": {
        "downloaded_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "$ref": "#/$defs/ArtifactDownloadIdentity"
        },
        "resumed_from_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/ArtifactDownloadState"
        },
        "target": {
          "$ref": "#/$defs/ArtifactDownloadTarget"
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "identity",
        "target",
        "state",
        "downloaded_bytes",
        "total_bytes",
        "resumed_from_bytes"
      ]
    },
    "ArtifactDownloadState": {
      "type": "string",
      "enum": [
        "queued",
        "downloading",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "ArtifactDownloadTarget": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "artifact_id"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactLocalFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "ArtifactPreviewImagePaths": {
      "type": "object",
      "properties": {
        "detail_path": {
          "type": "string"
        },
        "square_path": {
          "type": "string"
        }
      },
      "required": [
        "square_path",
        "detail_path"
      ]
    },
    "ArtifactPreviewPublication": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/ArtifactPreviewRequestState"
        }
      },
      "required": [
        "artifact",
        "generation",
        "state"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactPreviewRequestState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "loading"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ready"
            },
            "paths": {
              "$ref": "#/$defs/ArtifactPreviewImagePaths"
            }
          },
          "required": [
            "kind",
            "paths"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactReadState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "idle"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "loading"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system",
        "task"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ArtifactSummary": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactBindingSummary"
          }
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "created_by_actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_by_kind": {
          "$ref": "#/$defs/ArtifactCreatedByKind"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "primary_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "integer",
          "format": "int64"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "workspace_id",
        "created_by_kind",
        "created_at",
        "updated_at"
      ]
    }
  }
}