{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerMentionCandidate",
  "type": "object",
  "properties": {
    "avatar_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "principal_id": {
      "$ref": "#/$defs/PrincipalId"
    }
  },
  "additionalProperties": false,
  "required": [
    "principal_id",
    "display_name",
    "nickname"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}