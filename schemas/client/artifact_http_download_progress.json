{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactHttpDownloadProgress",
  "type": "object",
  "properties": {
    "downloaded_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "resumed_from_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "downloaded_bytes",
    "total_bytes",
    "resumed_from_bytes"
  ]
}