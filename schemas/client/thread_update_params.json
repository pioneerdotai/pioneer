{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadUpdateParams",
  "type": "object",
  "properties": {
    "archived": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "thread_id": {
      "type": "string"
    },
    "visibility": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadVisibility"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id"
  ],
  "$defs": {
    "ThreadVisibility": {
      "description": "User-selectable visibility for ordinary user threads.\n\nInternal task/system threads deliberately have no public selectable value.",
      "type": "string",
      "enum": [
        "private",
        "workspace"
      ]
    }
  }
}