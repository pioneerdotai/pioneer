{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillAuditRow",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/SkillAuditAction"
    },
    "created_at": {
      "type": "integer",
      "format": "int64"
    },
    "decision": {
      "$ref": "#/$defs/SkillAuditDecision"
    },
    "decision_tone": {
      "$ref": "#/$defs/SkillDiagnosticsTone"
    },
    "details_summary": {
      "$ref": "#/$defs/SkillAuditDetailsSummary"
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "created_at",
    "action",
    "decision",
    "decision_tone",
    "details_summary"
  ],
  "$defs": {
    "SkillAuditAction": {
      "type": "string",
      "enum": [
        "Install",
        "Update",
        "Uninstall",
        "ResolveAllowed",
        "ResolveBlocked",
        "RuntimeAllowed",
        "RuntimeBlocked",
        "SecurityWarn",
        "None"
      ]
    },
    "SkillAuditDecision": {
      "type": "string",
      "enum": [
        "Allowed",
        "Blocked",
        "Warning",
        "None"
      ]
    },
    "SkillAuditDetailsSummary": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Empty"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ObjectPairs": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/SkillJsonValuePreview"
                  }
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "ObjectPairs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ArrayLen": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "ArrayLen"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Value": {
              "$ref": "#/$defs/SkillJsonValuePreview"
            }
          },
          "additionalProperties": false,
          "required": [
            "Value"
          ]
        }
      ]
    },
    "SkillDiagnosticsTone": {
      "type": "string",
      "enum": [
        "Default",
        "Muted",
        "Success",
        "Warning",
        "Danger"
      ]
    },
    "SkillJsonValuePreview": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "None",
            "EmptyArray",
            "EmptyObject"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Bool": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "Bool"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Number": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ArrayLen": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "ArrayLen"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ObjectKeys": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "ObjectKeys"
          ]
        }
      ]
    }
  }
}