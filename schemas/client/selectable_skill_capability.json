{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectableSkillCapability",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "selectable": {
      "type": "boolean"
    },
    "slug": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillCapabilityUnavailableReason"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "key",
    "label",
    "description",
    "slug",
    "source_kind",
    "selectable"
  ],
  "$defs": {
    "SkillCapabilityUnavailableReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "DisabledByPolicy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Inactive": {
              "type": "object",
              "properties": {
                "status_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "Inactive"
          ]
        }
      ]
    }
  }
}