{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderSummary",
  "type": "object",
  "properties": {
    "api_key_configured": {
      "type": "boolean",
      "default": false
    },
    "capabilities": {
      "$ref": "#/$defs/ProviderSummaryCapabilities",
      "default": {
        "embeddings": false,
        "transcription": false
      }
    },
    "name": {
      "type": "string"
    },
    "proxy_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ],
  "$defs": {
    "ProviderSummaryCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": "boolean",
          "default": false
        },
        "transcription": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}