{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestState",
  "type": "object",
  "properties": {
    "latest_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "status": {
      "$ref": "#/$defs/RequestStatus"
    }
  },
  "required": [
    "status",
    "latest_generation"
  ],
  "$defs": {
    "ClientRequestFailure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ]
    },
    "RequestStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "idle"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "generation": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "pending"
            }
          },
          "required": [
            "status",
            "generation",
            "attempt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "generation": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": true
          },
          "required": [
            "status",
            "generation",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "error": {
              "$ref": "#/$defs/ClientRequestFailure"
            },
            "generation": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "status",
            "generation",
            "attempt",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "generation": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "status",
            "generation"
          ]
        }
      ]
    }
  }
}