{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteGatewayValidation",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "gateway_base_url": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "const": "reachable"
        },
        "transport_security": {
          "$ref": "#/$defs/GatewayTransportSecurity"
        }
      },
      "required": [
        "state",
        "gateway_base_url",
        "transport_security"
      ]
    },
    {
      "type": "object",
      "properties": {
        "gateway_base_url": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "const": "unreachable"
        },
        "transport_security": {
          "$ref": "#/$defs/GatewayTransportSecurity"
        }
      },
      "required": [
        "state",
        "gateway_base_url",
        "transport_security"
      ]
    }
  ],
  "$defs": {
    "GatewayTransportSecurity": {
      "type": "string",
      "enum": [
        "loopback_plaintext",
        "remote_plaintext",
        "tls"
      ]
    }
  }
}