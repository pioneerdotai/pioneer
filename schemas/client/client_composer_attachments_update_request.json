{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientComposerAttachmentsUpdateRequest",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/ClientComposerAttachmentsUpdateAction"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComposerAttachment"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "attachments",
    "action"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "ClientComposerAttachmentsUpdateAction": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "MarkPendingUploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Add": {
              "type": "object",
              "properties": {
                "attachment": {
                  "$ref": "#/$defs/ComposerAttachment"
                }
              },
              "required": [
                "attachment"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RemoveAt": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "index"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "RemoveAt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "MarkUploadingFailed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "MarkUploadingFailed"
          ]
        }
      ]
    },
    "ComposerAttachment": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerAttachmentKind"
        },
        "path": {
          "type": "string"
        },
        "upload_state": {
          "$ref": "#/$defs/ComposerAttachmentUploadState"
        }
      },
      "required": [
        "path",
        "file_name",
        "kind",
        "upload_state"
      ]
    },
    "ComposerAttachmentKind": {
      "type": "string",
      "enum": [
        "Image",
        "File",
        "Audio",
        "Video"
      ]
    },
    "ComposerAttachmentUploadState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Local",
            "Uploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Uploaded": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Uploaded"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Failed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Failed"
          ]
        }
      ]
    }
  }
}