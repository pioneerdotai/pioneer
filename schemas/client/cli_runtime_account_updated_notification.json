{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLIRuntimeAccountUpdatedNotification",
  "type": "object",
  "properties": {
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeAccountSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/CLIAgentRuntimeKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RuntimeStatus"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "runtime_id",
    "status"
  ],
  "$defs": {
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "RuntimeAccountSnapshot": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "auth_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "authenticated": {
          "type": "boolean"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "authenticated"
      ]
    },
    "RuntimeStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binary_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": "string",
              "const": "missing_binary"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "spawn_failed"
            }
          },
          "required": [
            "state",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "initializing"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "needs_auth"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "degraded"
            }
          },
          "required": [
            "state",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "minimum_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": "string",
              "const": "unsupported_version"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "state",
            "message"
          ]
        }
      ]
    }
  }
}