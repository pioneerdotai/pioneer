{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCollectionPublication",
  "type": "object",
  "properties": {
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderDefinition"
      }
    },
    "key": {
      "$ref": "#/$defs/ProviderCollectionKey"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderModelRow"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderCatalogRow"
      }
    },
    "request": {
      "$ref": "#/$defs/ProviderLoadState"
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "key",
    "revision",
    "request",
    "providers",
    "definitions",
    "models"
  ],
  "$defs": {
    "ProviderCatalogRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderSummary"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "revision",
        "provider"
      ]
    },
    "ProviderCollection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "catalog"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "models"
            },
            "provider": {
              "type": "string"
            },
            "purpose": {
              "$ref": "#/$defs/ProviderModelKind"
            }
          },
          "required": [
            "kind",
            "provider",
            "purpose"
          ]
        }
      ]
    },
    "ProviderCollectionKey": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/$defs/ProviderCollection"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "collection"
      ]
    },
    "ProviderDefinition": {
      "type": "object",
      "properties": {
        "default_base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "supports_base_url_override": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderLoadState": {
      "type": "string",
      "enum": [
        "idle",
        "loading",
        "ready",
        "failed",
        "forbidden",
        "cancelled"
      ]
    },
    "ProviderModelCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fine_tuning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "json_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelReasoningCapabilities"
            },
            {
              "type": "null"
            }
          ]
        },
        "streaming": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transcription": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderModelInfo": {
      "type": "object",
      "properties": {
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderModelCapabilities"
        },
        "created": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lifecycle_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "$ref": "#/$defs/ProviderModelLimits"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "owned_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelPricing"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "transcription": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderTranscriptionModelMetadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "limits",
        "capabilities"
      ]
    },
    "ProviderModelKind": {
      "type": "string",
      "enum": [
        "chat",
        "embeddings",
        "transcription"
      ]
    },
    "ProviderModelLimits": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "ProviderModelPricing": {
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "request": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "ProviderModelReasoningCapabilities": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningCapabilitySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_token_budget": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderModelRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ProviderModelInfo"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "revision",
        "model"
      ]
    },
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "api_key_configured": {
          "type": "boolean"
        },
        "available": {
          "description": "The gateway can construct this provider in the selected workspace.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderSummaryCapabilities",
          "default": {
            "embeddings": false,
            "self_improvement": false,
            "transcription": false
          }
        },
        "name": {
          "type": "string"
        },
        "proxy_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderSummaryCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": "boolean",
          "default": false
        },
        "self_improvement": {
          "description": "Gateway-authoritative eligibility for the API-only self-improvement\nmodel selectors.",
          "type": "boolean",
          "default": false
        },
        "transcription": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ProviderTranscriptionModelMetadata": {
      "type": "object",
      "properties": {
        "accuracy_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "download_size_mb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "engine": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        },
        "speed_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "supported_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_language_selection": {
          "type": "boolean"
        },
        "supports_translation": {
          "type": "boolean"
        }
      },
      "required": [
        "engine",
        "download_size_mb",
        "accuracy_score",
        "speed_score",
        "supports_translation",
        "supported_languages",
        "supports_language_selection",
        "recommended"
      ]
    },
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "static_registry",
        "config_override",
        "unknown"
      ]
    }
  }
}